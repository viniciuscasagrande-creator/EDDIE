{
  "name": "diskingressos-pdt",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm --filter @ticketing/contracts build && pnpm --filter @ticketing/pdt build && node -e \"const fs=require('fs'); if(fs.existsSync('apps/pdt/.next')){fs.cpSync('apps/pdt/.next','.next',{recursive:true});}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ticketing/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @ticketing/api exec prisma generate",
    "db:studio": "pnpm --filter @ticketing/api exec prisma studio",
    "infra:up": "docker compose -f .devcontainer/docker-compose.yml up -d",
    "infra:down": "docker compose -f .devcontainer/docker-compose.yml down",
    "preflight": "node scripts/preflight-go-live.mjs",
    "audit:data": "node scripts/audit-production-data.mjs",
    "audit:production": "node scripts/audit-production.mjs"
  },
  "devDependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0",
    "vitest": "^2.1.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.0"
  }
}
