model ApuracaoTributaria {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  codigo                 String    @unique // ex: "APU-2026-09-PIS"
  competencia            String    // "2026-09"
  tributoCodigo          String    // "PIS", "COFINS", "ISS", "CBS", "IBS"
  valorFaturamentoCentavos BigInt
  baseCalculoCentavos    BigInt
  debitosCentavos        BigInt    @default(0)
  creditosCentavos       BigInt    @default(0)
  retencoesCentavos      BigInt    @default(0)
  valorApuradoCentavos   BigInt
  status                 String    @default("EM_REVISAO") // "EM_REVISAO", "CONCLUIDA", "FECHADA"
  memoriaCalculo         Json      // Drill-down com lista de operações e documentos
  fechadoPor             String?
  fechadoEm              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([tenantId, competencia, tributoCodigo])
  @@index([tenantId, competencia, status])
  @@map("apuracoes_tributarias")
  @@schema("fiscal")
}

model ObrigacaoFiscal {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  codigo                 String    @unique // ex: "OBR-2026-00001"
  tipo                   String    @default("PRINCIPAL") // "PRINCIPAL", "ACESSORIA"
  tributoCodigo          String?   // "PIS", "COFINS", "ISS", "SPED", "EFD"
  descricao              String
  competencia            String    // "2026-09"
  dataVencimento         DateTime
  valorPrevistoCentavos  BigInt    @default(0)
  valorEfetivoCentavos   BigInt    @default(0)
  status                 String    @default("PENDENTE") // "PENDENTE", "EM_PREPARACAO", "AGUARDANDO_PAGAMENTO", "PAGA_CUMPRIDA", "ATRASADA"
  guiaCodigoBarras       String?
  tituloPagarId          String?   @db.Uuid // Vínculo com contas a pagar / tesouraria 11.36
  comprovanteDocumentoId String?   // Vínculo com documento / arquivo 11.35
  cumpridoPor            String?
  cumpridoEm             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, competencia, status])
  @@index([tenantId, dataVencimento])
  @@map("obrigações_fiscais")
  @@schema("fiscal")
}

model CertificadoDigitalFiscal {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  cnpjTitular    String
  razaoSocial    String
  emissora       String
  validadeInicio DateTime
  validadeFim    DateTime
  status         String    @default("ATIVO") // "ATIVO", "EXPIRADO", "REVOGADO"
  thumbprintSha1 String
  diasParaVencer Int       @default(365)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status])
  @@map("certificados_digitais_fiscais")
  @@schema("fiscal")
}

model ConciliacaoFiscal {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  competencia          String   // "2026-09"
  pontoConciliacao     String   // "OPERACAO_DOCUMENTO", "DOCUMENTO_CONTABILIDADE", "CONTABILIDADE_APURACAO", "APURACAO_PAGAMENTO"
  valorOrigemCentavos  BigInt
  valorDestinoCentavos BigInt
  diferencaCentavos    BigInt
  status               String   @default("CONCILIADO") // "CONCILIADO", "DIVERGENTE"
  detalhes             Json?
  createdAt            DateTime @default(now())

  @@index([tenantId, competencia, pontoConciliacao])
  @@map("conciliacoes_fiscais")
  @@schema("fiscal")
}

model PendenciaFiscal {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  tipo              String    // "DOCUMENTO_REJEITADO", "SEM_DOCUMENTO", "DIVERGENCIA_CONTABIL", "OBRIGACAO_PROXIMA", "CERTIFICADO_EXPIRANDO"
  severidade        String    @default("MEDIA") // "BAIXA", "MEDIA", "ALTA", "CRITICA"
  descricao         String
  competencia       String
  status            String    @default("PENDENTE") // "PENDENTE", "EM_ANALISE", "RESOLVIDA", "CANCELADA"
  documentoFiscalId String?   @db.Uuid
  resolucao         String?
  resolvidoPor      String?
  resolvidoEm       DateTime?
  createdAt         DateTime  @default(now())

  @@index([tenantId, status, severidade])
  @@index([tenantId, competencia])
  @@map("pendencias_fiscais")
  @@schema("fiscal")
}

model FechamentoFiscal {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @db.Uuid
  competencia             String    // "2026-09"
  status                  String    @default("ABERTO") // "ABERTO", "EM_REVISAO", "PRE_FECHAMENTO", "FECHADO", "REABERTO"
  checklist               Json      // Validações concluídas
  totalDocumentosEmitidos Int       @default(0)
  totalValorCentavos      BigInt    @default(0)
  fechadoPor              String?
  fechadoEm               DateTime?
  reabertoPor             String?
  reabertoEm              DateTime?
  motivoReabertura        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([tenantId, competencia])
  @@map("fechamentos_fiscais")
  @@schema("fiscal")
}
