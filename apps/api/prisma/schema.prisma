model ItemLiquidacao {
  id                  String   @id @default(uuid()) @db.Uuid
  loteLiquidacaoId    String   @db.Uuid
  origemTipo          String
  origemIdRef         String   @db.Uuid
  valorBruto          Decimal  @db.Decimal(14, 2)
  taxaDisk            Decimal  @db.Decimal(14, 2)
