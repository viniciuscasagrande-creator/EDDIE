model FechamentoContabilEvento {
  id                               String    @id @default(uuid()) @db.Uuid
  tenantId                         String    @db.Uuid
  eventoId                         String    @db.Uuid
  produtorId                       String?   @db.Uuid
  competencia                      String    // "2026-09"
  status                           String    @default("EM_FECHAMENTO_FINANCEIRO") // OPERACIONALMENTE_ENCERRADO, EM_FECHAMENTO_FINANCEIRO, FINANCEIRAMENTE_ENCERRADO, REABERTO
