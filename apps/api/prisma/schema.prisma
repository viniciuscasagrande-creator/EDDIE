  opcoes                Json?

  pesquisa              PesquisaPosEvento  @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)

  @@index([pesquisaId])
  @@map("perguntas_pesquisa")
  @@schema("posevento")
}

model RespostaPesquisa {
