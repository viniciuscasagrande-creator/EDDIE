  configuracaoTaxaId    String   @db.Uuid
  nomeComponente        String
  tipoComponente        String   // ADMINISTRATIVA, SERVICO, ADQUIRENTE, ANTECIPACAO, MAQUINA, PIX, MARKETING, AGENCIA, AFILIADO, OUTRA
  percentual            Decimal? @db.Decimal(5, 2)
  valorFixo             Decimal? @db.Decimal(14, 2)
  destinatario          String   // DISKINGRESSOS, ADQUIRENTE, SEGURADORA, AGENCIA, AFILIADO
  obrigatorio           Boolean  @default(true)

  configuracao          ConfiguracaoTaxaEvento @relation(fields: [configuracaoTaxaId], references: [id])

  @@map("componentes_taxa_evento")
  @@schema("financeiro")
}

model LoteLiquidacao {
