}

model TravaCircuitBreaker {
  id                    String   @id @default(uuid()) @db.Uuid
  perfilRiscoId         String   @db.Uuid
  tipo                  String
  severidade            String
  motivo                String
  acaoTomada            String
  acionadoEm            DateTime @default(now())
  resolvidoEm           DateTime?
  resolvidoPor          String?
  ativo                 Boolean  @default(true)

  perfil                PerfilRiscoProdutor @relation(fields: [perfilRiscoId], references: [id])

  @@index([perfilRiscoId, ativo])
  @@map("travas_circuit_breaker")
  @@schema("financeiro")
}

model SolicitacaoAprovacaoRisco {
  id                    String   @id @default(uuid()) @db.Uuid
  perfilRiscoId         String   @db.Uuid
  tipoOperacao          String
  valorSolicitadoCents  BigInt
  alcadaMinimaRequerida String
  status                String   @default("PENDENTE")
  solicitadoPor         String
  decididoPor           String?
  decididoEm            DateTime?
  parecer               String?
  createdAt             DateTime @default(now())

  perfil                PerfilRiscoProdutor @relation(fields: [perfilRiscoId], references: [id])

  @@index([perfilRiscoId, status])
  @@map("solicitacoes_aprovacao_risco")
  @@schema("financeiro")
}

// ============================================================================
//  FINANCEIRO — FP&A, Centros de Custo & Forecast (EDDIE 11.26 / 11.28)
