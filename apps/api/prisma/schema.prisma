  tenantId                    String   @db.Uuid
  produtorId                  String   @unique
  score                       Int      @default(700)
  rating                      String   @default("BBB")
  status                      String   @default("REGULAR")
  vendasBrutasAcumuladasCents BigInt   @default(0)
  adiantamentosAtivosCents     BigInt   @default(0)
  reservaSegurancaPercent     Decimal  @default(15.0) @db.Decimal(5, 2)
  reservaSegurancaCents       BigInt   @default(0)
  garantiasAportadasCents     BigInt   @default(0)
  limiteCreditoCents          BigInt   @default(10000000)
  exposicaoLiquidaCents       BigInt   @default(0)
  utilizacaoLimitePercent     Decimal  @default(0.0) @db.Decimal(5, 2)
  taxaChargebackPercent       Decimal  @default(0.0) @db.Decimal(5, 2)
  contadoresDisputa           Int      @default(0)
  ultimaAvaliacaoEm           DateTime @default(now())
