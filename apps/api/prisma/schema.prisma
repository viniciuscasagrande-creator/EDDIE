  nivel                  String   @default("NIVEL_2_BANCO_LIQUIDACAO") // NIVEL_1_OPERACIONAL, NIVEL_2_BANCO_LIQUIDACAO, NIVEL_3_BANCO_LEDGER
  correspondenciaTipo    String?  // RECEBIVEL, ORDEM_PAGAMENTO, TARIFA, TRANSFERENCIA, PIX
  correspondenciaId      String?
