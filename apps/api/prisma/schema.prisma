// ============================================================================
//  INVENTÁRIO — Núcleo de Inventário, Pools, Holds com TTL e Alocação (EDDIE 11.29.2)
// ============================================================================

model InventoryPool {
  id                    String              @id @default(uuid()) @db.Uuid
  eventoId              String              @db.Uuid
  sessaoId              String              @db.Uuid
  setorId               String              @db.Uuid
  loteId                String              @db.Uuid
  capacidadeTotal       Int
  capacidadeDisponivel  Int
  capacidadeReservada   Int                 @default(0)
  capacidadeVendida     Int                 @default(0)
  capacidadeBloqueada   Int                 @default(0)
  versaoLock            Int                 @default(0)
  criadoEm              DateTime            @default(now())
  atualizadoEm          DateTime            @updatedAt

  items                 InventoryItem[]
  holdItens             InventoryHoldItem[]

  @@unique([loteId, setorId])
  @@index([eventoId, sessaoId])
  @@map("inventory_pools")
  @@schema("inventario")
}

model InventoryItem {
  id                    String         @id @default(uuid()) @db.Uuid
  poolId                String         @db.Uuid
  eventoId              String         @db.Uuid
  sessaoId              String         @db.Uuid
  setorId               String         @db.Uuid
  loteId                String         @db.Uuid
  assento               String?
  status                String         @default("DISPONIVEL") // DISPONIVEL, RESERVADO, VENDIDO, BLOQUEADO, CORTESIA
  holdId                String?        @db.Uuid
  versaoLock            Int            @default(0)
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt

  pool                  InventoryPool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  hold                  InventoryHold? @relation(fields: [holdId], references: [id])

  @@index([poolId, status])
  @@index([poolId, assento])
  @@index([holdId])
  @@map("inventory_items")
  @@schema("inventario")
}

model InventoryHold {
  id                    String              @id @default(uuid()) @db.Uuid
  clienteId             String?             @db.Uuid
  sessaoCarrinhoId      String?
  status                String              @default("ATIVA") // ATIVA, EXPIRADA, CONVERTIDA_EM_PEDIDO, LIBERADA_MANUALMENTE
  criadoEm              DateTime            @default(now())
  expiraEm              DateTime
  pedidoId              String?             @db.Uuid

  itens                 InventoryHoldItem[]
  itemsAtrelados        InventoryItem[]

  @@index([status, expiraEm])
  @@index([clienteId])
  @@index([pedidoId])
  @@map("inventory_holds")
  @@schema("inventario")
}

model InventoryHoldItem {
  id                    String         @id @default(uuid()) @db.Uuid
  holdId                String         @db.Uuid
  poolId                String         @db.Uuid
  loteId                String         @db.Uuid
  setorId               String         @db.Uuid
  assento               String?
  quantidade            Int            @default(1)
  precoFace             Decimal        @db.Decimal(12, 2)
  taxaConveniencia      Decimal        @db.Decimal(12, 2)

  hold                  InventoryHold  @relation(fields: [holdId], references: [id], onDelete: Cascade)
  pool                  InventoryPool  @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([holdId])
  @@index([poolId])
  @@map("inventory_hold_items")
  @@schema("inventario")
}

// ============================================================================
//  PAGAMENTOS — Núcleo de Pagamentos, Processamento & Conciliação (EDDIE 11.29.3)
// ============================================================================

enum StatusIntencaoPagamento {
  CRIADA
  PROCESSANDO
  APROVADA
  RECUSADA
  CANCELADA
  ESTORNADA
  EXPIRADA

  @@schema("pagamentos")
}

enum MetodoPagamentoCore {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO

  @@schema("pagamentos")
}

model PaymentIntent {
  id                    String                   @id @default(uuid()) @db.Uuid
  tenantId              String                   @db.Uuid
  pedidoId              String                   @db.Uuid
  eventoId              String                   @db.Uuid
  produtorId            String                   @db.Uuid
  idempotencyKey        String                   @unique
  status                StatusIntencaoPagamento  @default(CRIADA)
  metodo                MetodoPagamentoCore      @default(PIX)

  valorTotal            Decimal                  @db.Decimal(14, 2)
  valorIngressos        Decimal                  @db.Decimal(14, 2)
  taxaServico           Decimal                  @db.Decimal(14, 2)
  splitProdutor         Decimal                  @db.Decimal(14, 2)
  splitPlataforma       Decimal                  @db.Decimal(14, 2)

  compradorNome         String
  compradorDocumento    String
  compradorEmail        String
  compradorTelefone     String?

  adquirente            String?
  transacaoId           String?
  nsu                   String?
  codigoAutorizacao     String?
  parcelas              Int                      @default(1)

  taxaMdrPercentual     Decimal?                 @db.Decimal(5, 2)
  taxaMdrFixa           Decimal?                 @db.Decimal(14, 2)
  custoProcessamento    Decimal?                 @db.Decimal(14, 2)
  valorLiquidoEsperado  Decimal?                 @db.Decimal(14, 2)

  expiraEm              DateTime?
  confirmadoEm          DateTime?
  recusadoEm            DateTime?
  motivoRecusa          String?

  metadata              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  pixDetail             PixPaymentDetail?
  transacoes            PaymentTransaction[]

  @@index([tenantId, status])
  @@index([pedidoId])
  @@index([eventoId])
  @@index([produtorId])
  @@map("payment_intents")
  @@schema("pagamentos")
}

model PixPaymentDetail {
  id                    String         @id @default(uuid()) @db.Uuid
  paymentIntentId       String         @unique @db.Uuid
  txid                  String         @unique
  chavePix              String
  qrCodeCopiaECola      String
  qrCodeBase64          String?
  psp                   String         @default("BACEN_DIRETO")
  endToEndId            String?
  expiraEm              DateTime
  status                String         @default("ATIVA")
  pagoEm                DateTime?
  createdAt             DateTime       @default(now())

  paymentIntent         PaymentIntent  @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([txid])
  @@index([status, expiraEm])
  @@map("pix_payment_details")
  @@schema("pagamentos")
}

model PaymentTransaction {
  id                    String         @id @default(uuid()) @db.Uuid
  paymentIntentId       String         @db.Uuid
  tipo                  String         // AUTORIZACAO, CAPTURA, CANCELAMENTO, CONSULTA, PIX_PAYIN
  adquirente            String
  transacaoExtId        String?
  nsu                   String?
  status                String         // SUCESSO, FALHA, PENDENTE
  codigoRetorno         String?
  mensagemRetorno       String?
  tempoRespostaMs       Int?
  payloadEnvio          Json?
  payloadResposta       Json?
  createdAt             DateTime       @default(now())

  paymentIntent         PaymentIntent  @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
  @@index([adquirente, status])
  @@map("payment_transactions")
  @@schema("pagamentos")
}

model PaymentWebhookEvent {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String?        @db.Uuid
  adquirente            String
  webhookEventId        String
  tipoEvento            String
  payload               Json
  processado            Boolean        @default(false)
  processadoEm          DateTime?
  erro                  String?
  createdAt             DateTime       @default(now())

  @@unique([adquirente, webhookEventId])
  @@index([processado, createdAt])
  @@map("payment_webhook_events")
  @@schema("pagamentos")
}

model ConciliacaoAdquirenteLote {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  adquirente            String
  dataReferencia        DateTime
  arquivoExtrato        String?
  quantidadeTransacoes  Int            @default(0)
  valorBrutoTotal       Decimal        @db.Decimal(14, 2)
  valorTaxasMdr         Decimal        @db.Decimal(14, 2)
  valorLiquidoTotal     Decimal        @db.Decimal(14, 2)
  status                String         @default("CONCILIADO")
  divergenciasEncontradas Int          @default(0)
  createdAt             DateTime       @default(now())

  @@index([tenantId, adquirente])
  @@map("conciliacao_adquirentes_lotes")
  @@schema("pagamentos")
}

// ============================================================================
//  PÓS-EVENTO E HISTÓRICO DO PÚBLICO — EDDIE 11.29.5
//  Presença real da portaria, desduplicação determinística, consentimento LGPD,
//  segmentações avançadas, pesquisas pós-evento e campanhas mensuradas
// ============================================================================

model PerfilPublico {
  id                    String                    @id @default(uuid()) @db.Uuid
  tenantId              String                    @db.Uuid
  nomePrincipal         String
  documentoNormalizado  String?
  emailPrincipal        String?
  telefonePrincipal     String?
  totalPresencas        Int                       @default(0)
  totalEventosComprados Int                       @default(0)
  scoreEngajamento      Decimal                   @default(1.00) @db.Decimal(5, 2)
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  identidades           IdentidadePublico[]
  contatos              ContatoPublico[]
  participacoes         ParticipacaoEvento[]
  historicos            HistoricoRelacionamento[]
  consentimentos        ConsentimentoComunicacao[]

  @@index([tenantId])
  @@index([documentoNormalizado])
  @@index([emailPrincipal])
  @@index([telefonePrincipal])
  @@map("perfis_publico")
  @@schema("posevento")
}

model IdentidadePublico {
  id                    String         @id @default(uuid()) @db.Uuid
  perfilId              String         @db.Uuid
  tipoDocumento         String         // CPF, RG, PASSAPORTE, EMAIL_NORMALIZADO, TELEFONE_NORMALIZADO
  valorNormalizado      String
  confianca             Decimal        @default(1.00) @db.Decimal(3, 2)
  origem                String         // CHECKIN_PORTARIA, CHECKOUT_COMPRADOR, NOMINACAO_TITULAR, IMPORTACAO
  createdAt             DateTime       @default(now())

  perfil                PerfilPublico  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId])
  @@index([valorNormalizado])
  @@map("identidades_publico")
  @@schema("posevento")
}

model ContatoPublico {
  id                    String         @id @default(uuid()) @db.Uuid
  perfilId              String         @db.Uuid
  canal                 String         // WHATSAPP, EMAIL, SMS, PUSH
  endereco              String
  verificado            Boolean        @default(false)
  optOut                Boolean        @default(false)
  optOutAt              DateTime?
  optOutOrigem          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  perfil                PerfilPublico  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId, canal])
  @@index([endereco])
  @@map("contatos_publico")
  @@schema("posevento")
}

model ParticipacaoEvento {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  eventoId              String         @db.Uuid
  perfilId              String?        @db.Uuid
  ingressoId            String         @unique @db.Uuid
  pedidoId              String?        @db.Uuid
  numeroIngresso        String
  compradorNome         String?
  compradorEmail        String?
  titularNome           String?
  titularEmail          String?
  titularTelefone       String?
  titularDocumento      String?
  identificacaoIndividual Boolean      @default(false)
  compareceu            Boolean        @default(false)
  checkinAt             DateTime?
  checkinPortaria       String?
  checkinOperadorId     String?
  sessaoNome            String?
  setorNome             String?
  loteNome              String?
  canalVenda            String         @default("ONLINE_DIRETO")
  parceiroId            String?
  parceiroNome          String?
  createdAt             DateTime       @default(now())

  perfil                PerfilPublico? @relation(fields: [perfilId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventoId, compareceu])
  @@index([perfilId])
  @@index([parceiroId])
  @@map("participacoes_evento")
  @@schema("posevento")
}

model HistoricoRelacionamento {
  id                    String         @id @default(uuid()) @db.Uuid
  perfilId              String         @db.Uuid
  eventoId              String         @db.Uuid
  tenantId              String         @db.Uuid
  tipo                  String         // COMPRA, CONVITE, PRESENCA, AUSENCIA, CAMPANHA_RECEBIDA, CAMPANHA_CLIQUE, PESQUISA_RESPONDIDA
  descricao             String
  detalhes              Json?
  dataReferencia        DateTime       @default(now())
  createdAt             DateTime       @default(now())

  perfil                PerfilPublico  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId, eventoId])
  @@index([tenantId, tipo])
  @@map("historico_relacionamentos")
  @@schema("posevento")
}

model ConsentimentoComunicacao {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  perfilId              String         @db.Uuid
  finalidade            String         // PESQUISA_POS_EVENTO, RELACIONAMENTO, MARKETING, ATUALIZACOES_EVENTO
  canal                 String         // WHATSAPP, EMAIL, SMS, NOTIFICACAO
  origem                String         // CHECKOUT_TERMO, TOTEM_PORTARIA, FORMULARIO_PESQUISA, PORTAL_COMPRADOR
  versaoTermo           String
  concedidoEm           DateTime       @default(now())
  revogado              Boolean        @default(false)
  revogadoEm            DateTime?
  evidencia             Json?

  perfil                PerfilPublico  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId, canal, finalidade])
  @@index([tenantId])
  @@map("consentimentos_comunicacao")
  @@schema("posevento")
}

model BloqueioComunicacao {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  identificador         String         // Telefone, email ou documento normalizado
  tipoIdentificador     String         // TELEFONE, EMAIL, DOCUMENTO
  canal                 String         // TODOS, WHATSAPP, EMAIL, SMS
  motivo                String         // SOLICITACAO_USUARIO, RECLAMACAO_PROCON, OPT_OUT_MENSAGEM, BOUNCE
  ativo                 Boolean        @default(true)
  bloqueadoEm           DateTime       @default(now())
  desbloqueadoEm        DateTime?

  @@index([tenantId, identificador, canal])
  @@map("bloqueios_comunicacao")
  @@schema("posevento")
}

model SegmentoPublico {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  eventoId              String?        @db.Uuid
  nome                  String
  descricao             String?
  totalMembros          Int            @default(0)
  regras                Json
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([tenantId, eventoId])
  @@map("segmentos_publico")
  @@schema("posevento")
}

model PesquisaPosEvento {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  eventoId              String             @db.Uuid
  titulo                String
  descricao             String?
  status                String             @default("RASCUNHO") // RASCUNHO, PUBLICADA, ENCERRADA
  modeloOrigem          String?            // SATISFACAO_GERAL, EXPERIENCIA_EVENTO, ESTRUTURA_ORGANIZACAO, PARQUE_ATRACAO, SHOW_FESTIVAL, TURISMO_EXCURSAO
  totalRespostas        Int                @default(0)
  satisfacaoMedia       Decimal?           @db.Decimal(3, 2)
  npsMedio              Decimal?           @db.Decimal(4, 1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  perguntas             PerguntaPesquisa[]
  respostas             RespostaPesquisa[]

  @@index([tenantId, eventoId])
  @@map("pesquisas_pos_evento")
  @@schema("posevento")
}

model PerguntaPesquisa {
  id                    String             @id @default(uuid()) @db.Uuid
  pesquisaId            String             @db.Uuid
  ordem                 Int
  enunciado             String
  tipo                  String             // RATING_1_5, SIM_TALVEZ_NAO, TEXTO_LIVRE, NPS_0_10, MULTIPLA_ESCOLHA
  categoria             String             // GERAL, ORGANIZACAO, ACESSO, BANHEIROS, ALIMENTOS_BEBIDAS, ESTRUTURA, RETORNO, SUGESTAO_LIVRE
