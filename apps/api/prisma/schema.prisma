// ============================================================================
//  FISCAL E TRIBUTÁRIO (EDDIE 11.38)
//  Interpretação fiscal e tributária, regras versionadas com vigência (LC 214/2025,
//  LC 227/2026, Reforma Tributária, IBS/CBS), NFS-e, retenções, apurações,
//  obrigações, three-way match de entrada e conciliação em 4 pontos.
//  Regra Inviolável: VENDA DO INGRESSO ≠ RECEITA DA DISK ≠ BASE TRIBUTÁVEL DA DISK.
// ============================================================================

model Tributo {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  codigo              String             // ex: "ISS", "PIS", "COFINS", "CBS", "IBS", "IS"
  nome                String             // ex: "Imposto sobre Serviços", "Contribuição sobre Bens e Serviços"
  esfera              String             // "MUNICIPAL", "FEDERAL", "ESTADUAL"
  tipo                String             // "DIRETO", "INDIRETO", "CONTRIBUICAO"
  aliquotaReferencia  Decimal            @db.Decimal(5, 2) // ex: 5.00
  vigenciaInicio      DateTime           @default(now())
  vigenciaFim         DateTime?
  ativo               Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, codigo])
  @@index([tenantId, ativo])
  @@map("tributos")
  @@schema("fiscal")
}

model RegraTributaria {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  codigo               String               // ex: "RT-INTERMED-01"
  versao               Int                  @default(1)
  descricao            String
  operacaoTipo         String               // "INTERMEDIACAO_VENDA", "TAXA_CONVENIENCIA", "SERVICO_PLATAFORMA", "DESPESA_FORNECEDOR"
  regimeTributario     String               // "LUCRO_PRESUMIDO", "LUCRO_REAL", "SIMPLES_NACIONAL", "REFORMA_TRIBUTARIA"
  municipioIncidencia  String?
  ufIncidencia         String?
  status               String               @default("VIGENTE") // "RASCUNHO", "VIGENTE", "EXPIRADA", "REVOGADA"
  exigeNfse            Boolean              @default(true)
  politicaRetencao     String               @default("DISPENSADA") // "DISPENSADA", "RETENCAO_FONTE"
  vigenciaInicio       DateTime             @default(now())
  vigenciaFim          DateTime?
  criadoPor            String
  aprovadoPor          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  itens                ItemRegraTributaria[]

  @@unique([tenantId, codigo, versao])
  @@index([tenantId, operacaoTipo, status])
  @@map("regras_tributarias")
  @@schema("fiscal")
}

model ItemRegraTributaria {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @db.Uuid
  regraId              String          @db.Uuid
  regra                RegraTributaria @relation(fields: [regraId], references: [id], onDelete: Cascade)
  tributoCodigo        String          // "ISS", "PIS", "COFINS", "CBS", "IBS"
  basePercentual       Decimal         @default(100.00) @db.Decimal(5, 2)
  aliquotaPercentual   Decimal         @db.Decimal(5, 2)
  retencao             Boolean         @default(false)
  responsavelRetencao  String          @default("PRESTADOR") // "TOMADOR", "PRESTADOR"

  @@index([tenantId, regraId])
  @@map("itens_regras_tributarias")
  @@schema("fiscal")
}

