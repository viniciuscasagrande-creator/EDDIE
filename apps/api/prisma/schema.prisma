  numero               String?
  serie                String?
  tipo                 String                 @default("NFSE") // "NFSE", "NFE", "CTE", "OUTRO"
  prestadorCnpj        String                 // String para suportar CNPJ alfanumérico
  tomadorCpfCnpj       String                 // String para suportar CPF e CNPJ alfanumérico
  tomadorNome          String
  competencia          String                 // "2026-09"
  valorTotalCentavos   BigInt
  baseCalculoCentavos  BigInt
  valorTributosCentavos BigInt                @default(0)
  valorLiquidoCentavos BigInt
  status               String                 @default("PENDENTE") // "PENDENTE", "EM_PROCESSAMENTO", "AUTORIZADO", "REJEITADO", "CANCELAMENTO_SOLICITADO", "CANCELADO", "SUBSTITUIDO", "ERRO"
  protocoloAutorizacao String?
  xmlAutorizado        String?                @db.Text
  motivoRejeicao       String?
  origemTipo           String                 // "SERVICO_DISK", "EVENTO_PRODUTOR", "FORNECEDOR_ENTRADA"
  origemReferenciaId   String
  contratoId           String?                @db.Uuid
  eventoId             String?                @db.Uuid
  produtorId           String?                @db.Uuid
  substituiDocumentoId String?                @db.Uuid
  dataEmissao          DateTime               @default(now())
  dataAutorizacao      DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  itens                ItemDocumentoFiscal[]
  retencoes            RetencaoTributaria[]

  @@index([tenantId, competencia, status])
  @@index([tenantId, origemTipo, origemReferenciaId])
  @@index([eventoId])
  @@index([produtorId])
  @@map("documentos_fiscais")
  @@schema("fiscal")
}

model ItemDocumentoFiscal {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @db.Uuid
  documentoFiscalId    String          @db.Uuid
