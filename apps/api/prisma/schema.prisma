// ============================================================================
//  Ticketing ERP — schema Prisma
//  REGRA: um schema Postgres por módulo. Relação CROSS-SCHEMA é PROIBIDA.
//  Se o módulo A precisa de dado do módulo B, ele guarda o ID como escalar
//  (sem @relation) e se atualiza consumindo eventos de domínio.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "eventos", "inventario", "estorno", "financeiro", "crm", "marketing", "contabilidade", "sac", "suporte"]
}


// ============================================================================
//  PLATFORM — infraestrutura do modulith (módulo Developer)
// ============================================================================

/// Transactional Outbox. Gravado na MESMA transação do dado de negócio.
/// Um worker publica no RabbitMQ e marca publishedAt. Garante zero evento perdido.
model OutboxMessage {
  id            String    @id @default(uuid()) @db.Uuid
  eventName     String
  source        String
  tenantId      String    @db.Uuid
  correlationId String    @db.Uuid
  causationId   String?   @db.Uuid
  actorType     String
  actorId       String?
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([publishedAt, occurredAt])
  @@index([correlationId])
  @@map("outbox_messages")
  @@schema("platform")
}

/// Idempotência dos consumers. Antes de processar, INSERT aqui; violação de
/// unique = evento já processado, descarte silenciosamente.
model ProcessedEvent {
  eventId     String   @db.Uuid
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
  @@map("processed_events")
  @@schema("platform")
}

/// Audit log imutável. Obrigatório para financeiro, contabilidade e estorno.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  module     String
  entity     String
  entityId   String
  action     String
  actorId    String?
  actorIp    String?
  before     Json?
  after      Json?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([module, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
  @@schema("platform")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  /// Rollout percentual 0-100 ou lista de tenants.
  rules       Json?
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
  @@schema("platform")
}

/// Observabilidade de IA: custo e qualidade por prompt. (módulo Developer)
model LlmCall {
  id            String   @id @default(uuid()) @db.Uuid
  module        String
  promptKey     String
  model         String
  inputTokens   Int
  outputTokens  Int
  costCents     Int
  latencyMs     Int
  success       Boolean
  traceId       String?
  createdAt     DateTime @default(now())

  @@index([module, promptKey, createdAt])
  @@map("llm_calls")
  @@schema("platform")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  cnpj      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("tenants")
  @@schema("platform")
}

// ============================================================================
//  EVENTOS — catálogo de eventos, sessões, setores e lotes
// ============================================================================

enum StatusEvento {
  rascunho
  publicado
  esgotado
  adiado
  cancelado
  encerrado

  @@schema("eventos")
}

model Produtor {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  nome          String
  documento     String   @unique
  email         String
  /// % de taxa da plataforma sobre o valor de face (ex.: 10.00)
  taxaPlataforma Decimal @db.Decimal(5, 2)
  /// Dias entre o evento e o repasse final.
  prazoRepasseDias Int    @default(30)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  eventos       Evento[]

  @@index([tenantId])
  @@map("produtores")
  @@schema("eventos")
}

model Local {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  nome      String
  endereco  String
  cidade    String
  uf        String    @db.Char(2)
  cep       String
  capacidade Int
  /// Mapa de assentos em SVG/JSON. Null = local sem marcação.
  mapaJson  Json?
  sessoes   Sessao[]

  @@map("locais")
  @@schema("eventos")
}

model Evento {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  produtorId         String       @db.Uuid
  produtor           Produtor     @relation(fields: [produtorId], references: [id])
  nome               String
  slug               String       @unique
  descricao          String?
  categoria          String
  classificacaoEtaria Int         @default(0)
  imagemUrl          String?
  status             StatusEvento @default(rascunho)
  publicadoEm        DateTime?
  canceladoEm        DateTime?
  motivoCancelamento String?
  /// Política de estorno específica deste evento (sobrepõe a padrão).
  politicaEstorno    Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  sessoes            Sessao[]

  @@index([tenantId, status])
  @@index([produtorId])
  @@map("eventos")
  @@schema("eventos")
}

model Sessao {
  id              String   @id @default(uuid()) @db.Uuid
  eventoId        String   @db.Uuid
  evento          Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  localId         String   @db.Uuid
  local           Local    @relation(fields: [localId], references: [id])
  inicioEm        DateTime
  fimEm           DateTime?
  /// Antes desta data não é possível comprar.
  vendaAbreEm     DateTime
  vendaFechaEm    DateTime
  capacidadeTotal Int
  adiadaDe        DateTime?
  setores         Setor[]
  lotes           Lote[]

  @@index([eventoId, inicioEm])
  @@map("sessoes")
  @@schema("eventos")
}

model Setor {
  id          String  @id @default(uuid()) @db.Uuid
  sessaoId    String  @db.Uuid
  sessao      Sessao  @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  nome        String          // "Pista", "Camarote A"
  /// true = assento marcado; false = pista/geral.
  marcado     Boolean @default(false)
  capacidade  Int
  cor         String?
  lotes       Lote[]

  @@index([sessaoId])
  @@map("setores")
  @@schema("eventos")
}

model Lote {
  id               String    @id @default(uuid()) @db.Uuid
  sessaoId         String    @db.Uuid
  sessao           Sessao    @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  setorId          String    @db.Uuid
  setor            Setor     @relation(fields: [setorId], references: [id], onDelete: Cascade)
  nome             String              // "1º Lote"
  ordem            Int
  precoFace        Decimal   @db.Decimal(14, 2)
  taxaConveniencia Decimal   @db.Decimal(14, 2)
  quantidade       Int
  /// Espelho denormalizado alimentado por eventos do módulo Inventário.
  /// NUNCA é a fonte da verdade da disponibilidade — serve só para dashboard.
  vendidos         Int       @default(0)
  abreEm           DateTime
  fechaEm          DateTime?
  ativo            Boolean   @default(true)

  @@unique([setorId, ordem])
  @@index([sessaoId, abreEm])
  @@map("lotes")
  @@schema("eventos")
}

// ============================================================================
//  ESTORNO — máquina de estados de reembolso
// ============================================================================

enum StatusEstorno {
  solicitado
  em_analise
  aprovado
  negado
  processando
  concluido
  falhou

  @@schema("estorno")
}

model SolicitacaoEstorno {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  /// IDs de outros módulos: escalares, SEM @relation (cross-schema proibido).
  pedidoId        String        @db.Uuid
  pagamentoId     String?       @db.Uuid
  clienteId       String        @db.Uuid
  chamadoId       String?       @db.Uuid

  status          StatusEstorno @default(solicitado)
  motivo          String
  /// Array de itemIds. Vazio = estorno total.
  itensIds        String[]      @db.Uuid

  valorSolicitado Decimal       @db.Decimal(14, 2)
  valorAprovado   Decimal?      @db.Decimal(14, 2)
  taxaRetida      Decimal?      @db.Decimal(14, 2)
  debitoProdutor  Decimal?      @db.Decimal(14, 2)

  analisadoPor    String?
  motivoNegativa  String?
  tentativas      Int           @default(0)
  erroAdquirente  String?

  solicitadoEm    DateTime      @default(now())
  decididoEm      DateTime?
  concluidoEm     DateTime?
  transicoes      TransicaoEstorno[]

  @@index([tenantId, status])
  @@index([pedidoId])
  @@map("solicitacoes_estorno")
  @@schema("estorno")
}

/// Trilha completa da máquina de estados. Append-only.
model TransicaoEstorno {
  id          String             @id @default(uuid()) @db.Uuid
  estornoId   String             @db.Uuid
  estorno     SolicitacaoEstorno @relation(fields: [estornoId], references: [id], onDelete: Cascade)
  de          StatusEstorno?
  para        StatusEstorno
  atorId      String?
  observacao  String?
  criadoEm    DateTime           @default(now())

  @@index([estornoId, criadoEm])
  @@map("transicoes_estorno")
  @@schema("estorno")
}

model Chargeback {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  pedidoId      String   @db.Uuid
  valor         Decimal  @db.Decimal(14, 2)
  codigoRazao   String
  adquirente    String
  prazoDefesaEm DateTime
  defesaEnviada Boolean  @default(false)
  evidencias    Json?
  resultado     String?  // ganho | perdido | pendente
  createdAt     DateTime @default(now())

  @@index([tenantId, resultado])
  @@map("chargebacks")
  @@schema("estorno")
}

// ============================================================================
//  FINANCEIRO — ledger de partidas dobradas e conta gráfica do produtor
// ============================================================================

model LancamentoLedger {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  produtorId          String   @db.Uuid
  eventoId            String?  @db.Uuid
  bucket              String   // disponivel | bloqueado | reservado_estorno | retido
  tipo                String   // entrada | saida
  valor               Decimal  @db.Decimal(14, 2)
  origem              String   // pedido_pago | estorno | repasse | antecipacao | transferencia | fornecedor
  referenciaId        String   // id da entidade ou evento de domínio que gerou
  contrapartidaId     String?  @db.Uuid
  historico           String
  criadoEm            DateTime @default(now())

  @@index([tenantId, produtorId, bucket])
  @@index([eventoId, bucket])
  @@unique([origem, referenciaId, bucket, tipo])
  @@map("lancamentos_ledger")
  @@schema("financeiro")
}

model TransferenciaInterEvento {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  produtorId          String   @db.Uuid
  eventoOrigemId      String   @db.Uuid
  eventoDestinoId     String   @db.Uuid
  valor               Decimal  @db.Decimal(14, 2)
  justificativa       String
  autorId             String
  lancamentoDebitoId  String   @db.Uuid
  lancamentoCreditoId String   @db.Uuid
  executadaEm         DateTime @default(now())

  @@index([tenantId, produtorId])
  @@index([eventoOrigemId])
  @@index([eventoDestinoId])
  @@map("transferencias_inter_eventos")
  @@schema("financeiro")
}

model SolicitacaoRepasse {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  produtorId             String    @db.Uuid
  eventoId               String?   @db.Uuid
  valor                  Decimal   @db.Decimal(14, 2)
  taxaRetida             Decimal   @default(0) @db.Decimal(14, 2)
  valorLiquido           Decimal   @db.Decimal(14, 2)
  chavePix               String
  status                 String    @default("solicitado") // solicitado | aprovado | agendado | liquidado | cancelado
  aprovadoPor            String?
  dataProgramada         DateTime
  comprovanteId          String?
  solicitadoEm           DateTime  @default(now())
  liquidadoEm            DateTime?

  @@index([tenantId, produtorId, status])
  @@map("solicitacoes_repasse")
  @@schema("financeiro")
}

model SolicitacaoAntecipacao {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  produtorId             String    @db.Uuid
  eventoId               String    @db.Uuid
  valorBruto             Decimal   @db.Decimal(14, 2)
  taxaDesagioPercentual  Decimal   @db.Decimal(5, 2)
  custoDesagio           Decimal   @db.Decimal(14, 2)
  valorLiquido           Decimal   @db.Decimal(14, 2)
  diasAntecipados        Int
  status                 String    @default("solicitada") // solicitada | aprovada | liquidada | recusada
  analisadoPor           String?
  comprovanteId          String?
  solicitadoEm           DateTime  @default(now())
  liquidadoEm            DateTime?

  @@index([tenantId, produtorId, status])
  @@map("solicitacoes_antecipacao")
  @@schema("financeiro")
}

model ContaPagar {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  produtorId          String    @db.Uuid
  eventoId            String    @db.Uuid
  fornecedorNome      String
  fornecedorDocumento String
  chavePix            String?
  categoria           String
  descricao           String
  valor               Decimal   @db.Decimal(14, 2)
  vencimentoEm        DateTime
  status              String    @default("pendente") // pendente | aprovada | paga | cancelada
  aprovadoPor         String?
  pagoEm              DateTime?
  lancamentoId        String?   @db.Uuid
  criadoEm            DateTime  @default(now())

  @@index([tenantId, eventoId, status])
  @@map("contas_a_pagar")
  @@schema("financeiro")
}

model DivergenciaConciliacao {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  produtorId          String    @db.Uuid
  adquirente          String
  transacaoId         String
  tipo                String
  valorEsperado       Decimal   @db.Decimal(14, 2)
  valorRecebido       Decimal   @db.Decimal(14, 2)
  diferenca           Decimal   @db.Decimal(14, 2)
  resolvida           Boolean   @default(false)
  resolvidaEm         DateTime?
  resolvidaPor        String?
  detectadaEm         DateTime  @default(now())

  @@index([tenantId, resolvida])
  @@map("divergencias_conciliacao")
  @@schema("financeiro")
}

// ============================================================================
//  COMERCIAL / CRM — Relacionamento B2B, Carteira, Pipeline e Negociações
//  Regra: Clientes são exclusivamente os PRODUTORES (B2B). Comprador final é do SAC.
// ============================================================================

model ProdutorB2B {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @db.Uuid
  razaoSocial            String
  nomeFantasia           String
  documento              String                 // CNPJ ou CPF do produtor
  email                  String
  telefone               String?
  executivoResponsavelId String                 @db.Uuid
  status                 String                 @default("prospeccao") // prospeccao | ativo | inativo | em_negociacao
  observacoes            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  oportunidades          OportunidadeComercial[]
  condicoes              CondicaoComercial[]
  atividades             AtividadeComercial[]

  @@index([tenantId, executivoResponsavelId])
  @@index([tenantId, status])
  @@map("produtores_b2b")
  @@schema("crm")
}

model OportunidadeComercial {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @db.Uuid
  produtorId             String                   @db.Uuid
  produtor               ProdutorB2B              @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  titulo                 String
  valorEstimado          Decimal                  @db.Decimal(14, 2)
  etapa                  String                   @default("prospeccao") // prospeccao | qualificacao | diagnostico | proposta | negociacao | contrato | ganho | perdido
  probabilidadePercentual Int                     @default(20)
  dataFechamentoPrevista DateTime?
  executivoId            String                   @db.Uuid
  motivoPerda            String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  historicoEtapas        HistoricoEtapaPipeline[]
  atividades             AtividadeComercial[]

  @@index([tenantId, executivoId, etapa])
  @@index([produtorId])
  @@map("oportunidades_comerciais")
  @@schema("crm")
}

model HistoricoEtapaPipeline {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  oportunidadeId String                @db.Uuid
  oportunidade   OportunidadeComercial @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  etapaAnterior  String
  etapaNova      String
  motivo         String?
  alteradoPor    String                @db.Uuid
  alteradoEm     DateTime              @default(now())

  @@index([oportunidadeId])
  @@map("historico_etapas_pipeline")
  @@schema("crm")
}

model CondicaoComercial {
  id                          String      @id @default(uuid()) @db.Uuid
  tenantId                    String      @db.Uuid
  produtorId                  String      @db.Uuid
  produtor                    ProdutorB2B @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  /// ID do evento no schema eventos (escalar sem @relation cross-schema). Null = condição padrão do produtor
  eventoId                    String?     @db.Uuid
  taxaServicoPercentual       Decimal     @db.Decimal(5, 2)
  taxaProcessamentoPercentual Decimal     @db.Decimal(5, 2)
  prazoRepasseDias            Int         @default(2)
  vigenciaInicio              DateTime
  vigenciaFim                 DateTime?
  status                      String      @default("rascunho") // rascunho | em_aprovacao | aprovada | revogada
  aprovadoPor                 String?     @db.Uuid
  aprovadoEm                  DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@index([tenantId, produtorId, status])
  @@index([eventoId])
  @@map("condicoes_comerciais")
  @@schema("crm")
}

model AtividadeComercial {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  produtorId     String                 @db.Uuid
  produtor       ProdutorB2B            @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  oportunidadeId String?                @db.Uuid
  oportunidade   OportunidadeComercial? @relation(fields: [oportunidadeId], references: [id], onDelete: SetNull)
  tipo           String                 // ligacao | reuniao | email | proposta | visita | followup
  descricao      String
  dataAgendada   DateTime
  realizada      Boolean                @default(false)
  realizadaEm    DateTime?
  executadoPor   String                 @db.Uuid
  createdAt      DateTime               @default(now())

  @@index([tenantId, executadoPor, realizada])
  @@index([produtorId])
  @@map("atividades_comerciais")
  @@schema("crm")
}

model MetaComercial {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  executivoId    String   @db.Uuid
  periodo        String   // Ex: "2026-Q3", "2026-09"
  valorMeta      Decimal  @db.Decimal(14, 2)
  valorRealizado Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, executivoId, periodo])
  @@map("metas_comerciais")
  @@schema("crm")
}

// ============================================================================
//  MARKETING — Campanhas, Tracking Multi-Pixel, Central UTM e Atribuição
// ============================================================================

model CampanhaMarketing {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  produtorId     String                @db.Uuid
  /// ID do evento no schema eventos (escalar sem @relation cross-schema)
  eventoId       String                @db.Uuid
  nome           String
  objetivo       String                // lancamento | virada_lote | contagem_regressiva | promocional | reengajamento
  status         String                @default("rascunho") // rascunho | agendada | ativa | pausada | com_alerta | erro | encerrada
  orcamentoTotal Decimal               @db.Decimal(14, 2)
  gastoAtual     Decimal               @default(0) @db.Decimal(14, 2)
  canais         String[]              // meta, google, tiktok, spotify, whatsapp, email
  iniciaEm       DateTime?
  terminaEm      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  utms           UtmLink[]
  cupons         CupomMarketing[]
  conversoes     ConversaoMarketing[]
  alertas        AlertaMarketing[]

  @@index([tenantId, eventoId, status])
  @@index([produtorId])
  @@map("campanhas_marketing")
  @@schema("marketing")
}

model PixelTracking {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  produtorId       String    @db.Uuid
  /// ID do evento no schema eventos (escalar sem @relation cross-schema)
  eventoId         String    @db.Uuid
  provedor         String    // meta | google | tiktok | spotify
  pixelExternalId  String    // identificador externo na plataforma (ex: pixel id Meta)
  nome             String?
  status           String    @default("ativo") // ativo | inativo | com_falha
  ultimaAtividadeEm DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, eventoId, provedor])
  @@map("pixels_tracking")
  @@schema("marketing")
}

model CupomMarketing {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  produtorId    String             @db.Uuid
  /// ID do evento no schema eventos (escalar sem @relation cross-schema)
  eventoId      String             @db.Uuid
  campanhaId    String?            @db.Uuid
  campanha      CampanhaMarketing? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  codigo        String             // ex: "DESCONTO10"
  tipoDesconto  String             // percentual | valor_fixo
  descontoValor Decimal            @db.Decimal(14, 2)
  limiteUso     Int?
  usosAtuais    Int                @default(0)
  validoAte     DateTime?
  ativo         Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  conversoes    ConversaoMarketing[]

  @@unique([tenantId, eventoId, codigo])
  @@map("cupons_marketing")
  @@schema("marketing")
}

model UtmLink {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  produtorId     String             @db.Uuid
  /// ID do evento no schema eventos (escalar sem @relation cross-schema)
  eventoId       String             @db.Uuid
  campanhaId     String?            @db.Uuid
  campanha       CampanhaMarketing? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  canal          String             // meta | google | tiktok | spotify | whatsapp | email | afiliado | link_direto
  urlDestino     String
  utmSource      String
  utmMedium      String
  utmCampaign    String
  utmContent     String?
  utmTerm        String?
  qrCodeDataUrl  String?
  cliques        Int                @default(0)
  createdAt      DateTime           @default(now())
  conversoes     ConversaoMarketing[]

  @@index([tenantId, eventoId, utmSource, utmCampaign])
  @@map("utm_links")
  @@schema("marketing")
}

model ConversaoMarketing {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  produtorId       String             @db.Uuid
  eventoId         String             @db.Uuid
  /// ID do pedido no schema pedidos/pagamentos (escalar sem @relation cross-schema)
  pedidoId         String             @db.Uuid
  campanhaId       String?            @db.Uuid
  campanha         CampanhaMarketing? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  utmLinkId        String?            @db.Uuid
  utmLink          UtmLink?           @relation(fields: [utmLinkId], references: [id], onDelete: SetNull)
  cupomId          String?            @db.Uuid
  cupom            CupomMarketing?    @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  canal            String?
  modeloAtribuicao String             @default("last_click") // last_click | first_click | linear | cupom_direto
  valorTotal       Decimal            @db.Decimal(14, 2)
  receitaAtribuida Decimal            @db.Decimal(14, 2)
  atribuidaEm      DateTime           @default(now())

  @@index([tenantId, eventoId, campanhaId])
  @@index([pedidoId])
  @@map("conversoes_marketing")
  @@schema("marketing")
}

model AlertaMarketing {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  produtorId  String             @db.Uuid
  campanhaId  String?            @db.Uuid
  campanha    CampanhaMarketing? @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  eventoId    String?            @db.Uuid
  tipo        String             // pixel_sem_eventos | orcamento_esgotado | aumento_cpa | integracao_degradada
  severidade  String             @default("aviso") // aviso | erro | critico
  mensagem    String
  resolvido   Boolean            @default(false)
  resolvidoEm DateTime?
  createdAt   DateTime           @default(now())

  @@index([tenantId, resolvido])
  @@map("alertas_marketing")
  @@schema("marketing")
}

// ============================================================================
//  CONTABILIDADE — Plano de Contas, Escrituração em Partidas Dobradas,
//  Razão, Diário, Balancete, DRE e Fechamento de Competência.
//  Regra: Segregação estrita entre recursos de terceiros (produtor) e receita própria.
// ============================================================================

model ContaContabil {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  codigo                String                // ex: "1.1.1.01", "2.1.2.01", "3.1.1.01"
  nome                  String                // ex: "Disponibilidades em Bancos", "Valores a Repassar a Produtores"
  tipo                  String                // ativo | passivo | patrimonio_liquido | receita | despesa
  natureza              String                // devedora | credora
  nivel                 Int                   // 1 a 5
  analitica             Boolean               @default(true) // true = aceita lançamentos; false = totalizadora
  contaPaiId            String?               @db.Uuid
  contaPai              ContaContabil?        @relation("HierarquiaContas", fields: [contaPaiId], references: [id], onDelete: Restrict)
  contasFilhas          ContaContabil[]       @relation("HierarquiaContas")
  ativa                 Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  partidas              PartidaContabil[]
  conciliacoes          ConciliacaoContabil[]

  @@unique([tenantId, codigo])
  @@index([tenantId, tipo, analitica])
  @@map("contas_contabeis")
  @@schema("contabilidade")
}

model LancamentoContabil {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  numeroLancamento      Int                   @default(autoincrement())
  data                  DateTime
  competencia           String                // "AAAA-MM", ex: "2026-09"
  total                 Decimal               @db.Decimal(14, 2)
  historico             String
  origemTipo            String                // pedido_pago | repasse_produtor | estorno | manual | ajuste
  origemReferenciaId    String
  /// ID escalar do evento no schema eventos (sem @relation cross-schema)
  eventoId              String?               @db.Uuid
  /// ID escalar do produtor no schema crm/eventos (sem @relation cross-schema)
  produtorId            String?               @db.Uuid
  status                String                @default("confirmado") // rascunho | confirmado | estornado
  estornoDeId           String?               @db.Uuid
  criadoPor             String
  createdAt             DateTime              @default(now())
  partidas              PartidaContabil[]

  @@index([tenantId, competencia, status])
  @@index([tenantId, origemTipo, origemReferenciaId])
  @@index([eventoId])
  @@map("lancamentos_contabeis")
  @@schema("contabilidade")
}

model PartidaContabil {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  lancamentoId          String                @db.Uuid
  lancamento            LancamentoContabil    @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  contaId               String                @db.Uuid
  conta                 ContaContabil         @relation(fields: [contaId], references: [id], onDelete: Restrict)
  tipo                  String                // D (Débito) | C (Crédito)
  valor                 Decimal               @db.Decimal(14, 2)
  historicoComplementar String?

  @@index([tenantId, contaId])
  @@index([lancamentoId])
  @@map("partidas_contabeis")
  @@schema("contabilidade")
}

model FechamentoContabil {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  competencia           String                // "AAAA-MM", ex: "2026-09"
  status                String                @default("fechado") // fechado | reaberto
  totalDebitos          Decimal               @db.Decimal(14, 2)
  totalCreditos         Decimal               @db.Decimal(14, 2)
  resultadoExercicio    Decimal               @db.Decimal(14, 2)
  fechadoPor            String                @db.Uuid
  fechadoEm             DateTime              @default(now())
  reabertoPor           String?               @db.Uuid
  reabertoEm            DateTime?
  motivoReabertura      String?

  @@unique([tenantId, competencia])
  @@map("fechamentos_contabeis")
  @@schema("contabilidade")
}

model ConciliacaoContabil {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  contaId               String                @db.Uuid
  conta                 ContaContabil         @relation(fields: [contaId], references: [id], onDelete: Restrict)
  competencia           String                // "AAAA-MM"
  saldoContabil         Decimal               @db.Decimal(14, 2)
  saldoExtrato          Decimal               @db.Decimal(14, 2)
  diferenca             Decimal               @db.Decimal(14, 2)
  status                String                // conciliado | divergente
  observacoes           String?
  conciliadoPor         String                @db.Uuid
  conciliadoEm          DateTime              @default(now())

  @@unique([tenantId, contaId, competencia])
  @@map("conciliacoes_contabeis")
  @@schema("contabilidade")
}

// ============================================================================
//  SAC — Atendimento ao comprador final, chamados e SLA (ITIL)
// ============================================================================
//  SAC — Atendimento ao comprador final, chamados e SLA
// ============================================================================

model ChamadoSac {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  protocolo     String    @unique
  clienteNome   String
  cpf           String?
  telefone      String?
  email         String?
  pedidoId      String?
  eventoId      String?   @db.Uuid
  assunto       String
  descricao     String
  canal         String
  prioridade    String    @default("normal")
  status        String    @default("aberto")
  responsavelId String?
  slaVenceEm    DateTime?
  resolvidoEm   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, cpf])
  @@index([tenantId, telefone])
  @@map("chamados")
  @@schema("sac")
}

// ============================================================================
//  SUPORTE — Operação e ocorrências do produtor no dia do evento
// ============================================================================

model OcorrenciaEvento {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  eventoId      String    @db.Uuid
  produtorId    String    @db.Uuid
  titulo        String
  descricao     String
  categoria     String
  prioridade    String    @default("normal")
  status        String    @default("aberto")
  responsavelId String?
  resolvidoEm   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, eventoId, status])
  @@map("ocorrencias")
  @@schema("suporte")
}




