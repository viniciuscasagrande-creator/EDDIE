  respostasPerguntas    Json               @default("{}")
  topicosDetectados     Json?
  respondidoEm          DateTime           @default(now())

  pesquisa              PesquisaPosEvento  @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)

  @@index([pesquisaId])
  @@map("respostas_pesquisa")
  @@schema("posevento")
}

model TabelaPrecoComunicacao {
