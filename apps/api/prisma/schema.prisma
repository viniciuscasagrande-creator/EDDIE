model ConfiguracaoTaxaEvento {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @db.Uuid
  eventoId                String    @unique
  produtorId              String
  tipo                    String    @default("PERCENTUAL") // PERCENTUAL, FIXA, HIBRIDA
  percentual              Decimal   @default(15.0) @db.Decimal(5, 2)
  valorFixo               Decimal   @default(0.0) @db.Decimal(14, 2)
  taxaMinimaPorIngresso   Decimal   @default(0.0) @db.Decimal(14, 2)
  taxaConvenienciaPercent Decimal   @default(10.0) @db.Decimal(5, 2)
  taxaConvenienciaFixa    Decimal   @default(0.0) @db.Decimal(14, 2)
  absorverTaxaProdutor    Boolean   @default(false)
  custoAdquirenteEstimado Decimal   @default(2.5) @db.Decimal(5, 2)
  vigenciaInicio          DateTime  @default(now())
  vigenciaFim             DateTime?
  status                  String    @default("VIGENTE") // VIGENTE, EXPIRADA, REVISADA, RASCUNHO
  versao                  Int       @default(1)
  criadoPor               String
  aprovadoPor             String?
  criadoEm                DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

