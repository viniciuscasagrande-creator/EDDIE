# Frontend EDDIE (Vercel)
# URL pública do backend NestJS. Pode informar domínio puro ou terminar em /api.
API_INTERNAL_URL="https://api.seu-dominio.com"
# Navegador sempre usa o proxy same-origin do Next.js.
NEXT_PUBLIC_API_URL="/api"
# Obrigatório em produção enquanto o contexto do produtor ainda não vier da autenticação.
NEXT_PUBLIC_PRODUTOR_ID="UUID_REAL_DO_PRODUTOR"
NEXT_PUBLIC_EVENTO_ID=""
