                                            <i class="ph-chart-pie me-1"></i> Dashboard da Tesouraria
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTreasuryTab('accounts'); event.preventDefault();" id="trz-tab-link-accounts">
                                            <i class="ph-bank me-1"></i> Contas Bancárias
                                        </a>
                                    </li>
                                    <li class="nav-item">
