                            <!-- PANE 4: Pagamentos em Lote & CNAB -->
                            <div class="card-body p-3" id="trz-pane-batches" style="display:none;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="fw-bold text-dark fs-sm">Lotes de Pagamento &amp; Remessa CNAB 240</span>
                                        <div class="text-muted fs-xs">Agrupamento em lote, validação de alçadas Maker/Checker e geração de arquivos FEBRABAN</div>
                                    </div>
                                    <button class="btn btn-sm btn-info text-white fw-bold" onclick="window.openCreateTreasuryBatchModal()" style="background-color: #0284c7;">
                                        <i class="ph-stack me-1"></i> Novo Lote CNAB
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light fs-xs text-uppercase text-muted">
                                            <tr>
                                                <th>ID Lote</th>
                                                <th>Título</th>
                                                <th>Banco de Origem</th>
                                                <th>Itens</th>
                                                <th>Valor Total</th>
                                                <th>Status</th>
                                                <th>Arquivo Remessa</th>
                                                <th class="text-end">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="trz-tbody-batches" class="fs-xs">
                                            <!-- Renderizado dinamicamente -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- PANE 5: Retorno Bancário & Conciliação -->
                            <div class="card-body p-3" id="trz-pane-reconciliation" style="display:none;">
                                <div class="card border p-3 mb-3 bg-light">
                                    <h6 class="fw-bold text-dark mb-1"><i class="ph-file-arrow-up me-1 text-primary"></i> Processador de Arquivos de Retorno CNAB 240 / 400</h6>
                                    <div class="text-secondary fs-xs mb-3">
                                        Faça upload do arquivo <code>.RET</code> fornecido pelo banco para leitura de ocorrências (00 = Pago, 03 = Rejeição), baixa automática de contas e conciliação bancária.
                                    </div>
                                    <div class="row g-2 align-items-center">
                                        <div class="col-md-6">
                                            <input type="file" class="form-control form-control-sm" id="trz-cnab-retorno-file" accept=".ret,.txt,.rem" onchange="window.handleCnabRetornoUpload(event)">
                                        </div>
                                        <div class="col-md-6">
                                            <span class="fs-xs text-muted"><i class="ph-info me-1"></i> Suporta layouts bancários FEBRABAN 240 e CNAB 400 padrão de todos os bancos integrados.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- PANE 6: Trilha de Auditoria -->
                            <div class="card-body p-3" id="trz-pane-audit" style="display:none;">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light fs-xs text-uppercase text-muted">
                                            <tr>
                                                <th>Data / Hora</th>
                                                <th>Ator</th>
                                                <th>Entidade</th>
                                                <th>Ação</th>
                                                <th>Resumo</th>
                                                <th>Correlation ID</th>
                                            </tr>
                                        </thead>
                                        <tbody id="trz-tbody-audit" class="fs-xs">
                                            <!-- Renderizado dinamicamente -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </section>


                    <!-- MODAL: VISÃO COMPLETA DO FORNECEDOR -->
                    <div class="modal fade" id="modal-supplier-360" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded bg-primary text-white p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                            <i class="ph-buildings fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="modal-title fw-bold text-dark mb-0" id="s360-trade-name">Visão Completa do Fornecedor</h5>
                                            <div class="text-muted fs-xs" id="s360-legal-name">Razão Social Completa</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <!-- 4 Cards Métricas do Fornecedor -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border rounded bg-light text-center">
                                                <div class="fs-xs text-muted fw-bold text-uppercase">Total Contratado</div>
                                                <div class="fw-bold fs-sm text-dark mt-1" id="s360-metric-contracted">R$ 0,00</div>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border rounded bg-light text-center">
                                                <div class="fs-xs text-muted fw-bold text-uppercase">Total Pago</div>
                                                <div class="fw-bold fs-sm text-success mt-1" id="s360-metric-paid">R$ 0,00</div>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border rounded bg-light text-center">
                                                <div class="fs-xs text-muted fw-bold text-uppercase">Saldo Pendente</div>
                                                <div class="fw-bold fs-sm text-warning mt-1" id="s360-metric-pending">R$ 0,00</div>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border rounded bg-light text-center">
                                                <div class="fs-xs text-muted fw-bold text-uppercase">Avaliação Média</div>
                                                <div class="fw-bold fs-sm text-primary mt-1" id="s360-metric-rating">5.0 / 5.0</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Detalhes em Linhas -->
                                    <div class="row g-3 fs-sm mb-3">
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-white h-100">
                                                <div class="fw-bold text-uppercase fs-xs text-muted mb-2">Dados Cadastrais &amp; Contato</div>
                                                <div class="mb-1"><strong>CNPJ/CPF:</strong> <span class="font-monospace" id="s360-tax-id"></span></div>
                                                <div class="mb-1"><strong>Categoria Primária:</strong> <span id="s360-category"></span></div>
                                                <div class="mb-1"><strong>Situação:</strong> <span id="s360-status"></span></div>
                                                <div><strong>Contato:</strong> <span id="s360-contact"></span></div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-white h-100">
                                                <div class="fw-bold text-uppercase fs-xs text-muted mb-2">Dados Financeiros &amp; Bancários</div>
                                                <div class="mb-1"><strong>Chave PIX:</strong> <span class="font-monospace text-primary fw-bold" id="s360-pix"></span></div>
                                                <div class="mb-1"><strong>Dados Bancários:</strong> <span id="s360-bank"></span></div>
                                                <div class="fs-xs text-muted mt-2">Validação automática de titularidade de conta integrada ao CPF/CNPJ da receita federal.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Documentos e Certidões -->
                                    <div class="border rounded p-3 bg-white">
                                        <div class="fw-bold text-uppercase fs-xs text-muted mb-2">Conformidade Regulatória (Certidões &amp; CNDs)</div>
                                        <ul class="list-group list-group-flush" id="s360-docs-list">
                                            <!-- Preenchido via JS -->
                                        </ul>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: NOVO CONTRATO COM RATEIO MULTI-EVENTO -->
                    <div class="modal fade" id="modal-new-contract" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-md modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <h5 class="modal-title fw-bold text-dark mb-0">Novo Contrato com Rateio Multi-Evento</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase">Fornecedor Homologado</label>
                                        <select id="contract-supplier-select" class="form-select fw-semibold border-secondary">
                                            <!-- Preenchido via JS -->
                                        </select>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase">Valor Total do Contrato</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">R$</span>
                                                <input type="number" step="0.01" id="contract-total-amount" class="form-control fw-bold text-dark" value="30000.00">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase">Nº de Parcelas</label>
                                            <input type="number" id="contract-installments" class="form-control" value="3">
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase">Objeto do Contrato</label>
                                        <input type="text" id="contract-object" class="form-control" value="Prestação de serviços contínuos de iluminação e som">
                                    </div>
                                    <!-- Validador de Rateio Multi-Evento -->
                                    <div class="border rounded p-3 bg-light mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fs-xs fw-bold text-uppercase text-dark">Rateio entre Eventos:</span>
                                            <span class="badge bg-success text-white">Soma Obrigatória = 100.00%</span>
                                        </div>
                                        <div class="fs-xs text-muted mb-2">
                                            • Evento #3368 (Música e Natureza): <strong>50.00%</strong> (R$ 15.000,00)<br>
                                            • Evento #3195 (Knife Show Curitiba): <strong>30.00%</strong> (R$ 9.000,00)<br>
                                            • Evento #3178 (Feijoada e Costela): <strong>20.00%</strong> (R$ 6.000,00)
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" style="width: 50%;"></div>
                                            <div class="progress-bar bg-info" style="width: 30%;"></div>
                                            <div class="progress-bar bg-success" style="width: 20%;"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="window.saveNewContractAction()">Formalizar Contrato</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: CONFERÊNCIA 3-WAY MATCH -->
                    <div class="modal fade" id="modal-threeway-match" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-md modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <h5 class="modal-title fw-bold text-dark mb-0">Conferência Tríplice (3-Way Match)</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <input type="hidden" id="match-po-id">
                                    <div class="p-3 border rounded bg-light mb-3 fs-sm">
                                        <div class="mb-1"><strong>Fornecedor do Pedido:</strong> <span id="match-po-supplier"></span></div>
                                        <div><strong>Valor Emitido no Pedido:</strong> <span class="fw-bold text-primary" id="match-po-amount"></span></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase">Nº da Nota Fiscal / Documento Recebido</label>
                                        <input type="text" id="match-inv-number" class="form-control" value="NF-89210">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase">Valor Apontado na Nota Fiscal (R$)</label>
                                        <input type="number" step="0.01" id="match-inv-amount" class="form-control fw-bold text-dark">
                                    </div>
                                    <div class="alert alert-info border-0 py-2 fs-xs mb-0">
                                        <i class="ph-info me-1"></i> O motor compara automaticamente CNPJ, valores e quantidades físicas recebidas. Se houver discrepância, a conta a pagar permanece bloqueada.
                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="button" class="btn btn-sm btn-success fw-bold" onclick="window.executeThreeWayMatchAction()">Executar Conferência</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================================================ -->
                    <!-- MEGA PACOTE 1: GERENCIAMENTO DE ACESSO, RBAC, ESCOPOS & AUDITORIA              -->
                    <!-- ============================================================================ -->
                    <section id="view-access-management" class="page-section" style="display:none;">
                        <!-- Header da Central de Acesso -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                    <i class="ph-shield-check text-primary"></i> Gerenciamento de Acesso &amp; Governança
                                </h5>
                                <div class="text-muted fs-xs">
                                    Controle Central de Usuários &bull; Perfis &bull; Permissões RBAC &bull; Alçadas &bull; Escopos &bull; Auditoria
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-primary fw-bold d-flex align-items-center gap-1 shadow-sm" onclick="window.openCreateUserWizard()">
                                    <i class="ph-user-plus"></i> Novo Usuário
                                </button>
                                <button type="button" class="btn btn-sm btn-light border text-secondary" title="Recarregar" onclick="window.accessManagementController.renderCurrentTab()">
                                    <i class="ph-arrows-clockwise"></i>
                                </button>
                            </div>
                        </div>

                        <!-- 8 Abas Canônicas de Navegação de Acesso -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2 px-3">
                                <div class="btn-group btn-group-sm flex-wrap" role="group" id="access-management-tabs">
                                    <button type="button" class="btn btn-primary text-white fw-bold active tab-access-link" id="tab-access-visao-geral" onclick="window.switchAccessTab('visao-geral')">Visão Geral</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-usuarios" onclick="window.switchAccessTab('usuarios')">Usuários</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-perfis" onclick="window.switchAccessTab('perfis')">Perfis de Acesso</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-permissoes" onclick="window.switchAccessTab('permissoes')">Permissões</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-alcadas" onclick="window.switchAccessTab('alcadas')">Alçadas de Aprovação</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-escopos" onclick="window.switchAccessTab('escopos')">Eventos e Escopos</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-seguranca" onclick="window.switchAccessTab('seguranca')">Sessões e Segurança</button>
                                    <button type="button" class="btn btn-light text-dark fw-semibold tab-access-link" id="tab-access-auditoria" onclick="window.switchAccessTab('auditoria')">Auditoria de Acessos</button>
                                </div>
                            </div>

                            <!-- Conteúdo Renderizado Dinamicamente -->
                            <div class="card-body p-3" id="access-management-content-pane">
                                <!-- Preenchido pelo accessManagementController.renderCurrentTab() -->
                            </div>
                        </div>
                    </section>

                    <!-- Tela Oficial de Acesso Negado (403) com Princípio de Menor Privilégio -->
                    <section id="view-access-denied" class="page-section" style="display:none;">
                        <div class="container py-5 text-center" style="max-width: 600px;">
                            <div class="card border-0 shadow-lg p-4">
                                <div class="mb-3 text-danger">
                                    <i class="ph-shield-warning" style="font-size: 64px;"></i>
                                </div>
                                <h4 class="fw-bold text-dark mb-1">Acesso Não Autorizado (Código 403)</h4>
                                <p class="text-muted fs-xs mb-3">
                                    Seu perfil ou operador atual não possui a permissão requerida ou o escopo necessário para acessar este recurso da plataforma.
                                </p>
                                <div class="alert alert-warning py-2 px-3 fs-xxs text-start mb-3">
                                    <strong><i class="ph-lock-key me-1"></i> Governança Corporativa Disk:</strong><br>
                                    A segurança do sistema é baseada no princípio do menor privilégio. Nenhuma ação administrativa ou financeira pode ser executada sem autorização explícita e alçada válida.
                                </div>
                                <div>
                                    <button type="button" class="btn btn-primary fw-bold px-4" onclick="window.AppRouter.navigate('/dashboard')">
                                        <i class="ph-arrow-left me-1"></i> Voltar ao Painel Geral
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Tela Oficial de Autenticação / Login -->
                    <section id="view-auth-login" class="page-section" style="display:none;">
                        <div class="container py-5" style="max-width: 480px;">
                            <div class="card border-0 shadow-lg p-4">
                                <div class="text-center mb-4">
                                    <h4 class="fw-bold text-dark mb-0">DISK INGRESSOS</h4>
                                    <span class="fs-xs text-muted text-uppercase fw-semibold">Central de Autenticação &amp; Acesso</span>
                                </div>
                                <form id="form-app-login" onsubmit="event.preventDefault(); window.executeAppLogin(event);">
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-semibold text-dark">E-mail Corporativo</label>
                                        <input type="email" class="form-control" id="login-input-email" required placeholder="seu.email@diskingressos.com.br" value="carlos.lima@diskingressos.com.br">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-semibold text-dark">Senha de Acesso</label>
                                        <input type="password" class="form-control" id="login-input-password" required placeholder="Digite sua senha" value="senha123">
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-3 fs-xs">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="login-keep-connected" checked>
                                            <label class="form-check-label text-muted" for="login-keep-connected">Manter conectado</label>
                                        </div>
                                        <a href="#" class="text-primary text-decoration-none" onclick="alert('Instruções de redefinição serão enviadas ao e-mail cadastrado.')">Esqueci minha senha</a>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm mb-3">
                                        <i class="ph-sign-in me-1"></i> Acessar Sistema
                                    </button>
                                </form>

                                <hr class="my-3">
                                <span class="fs-xxs text-uppercase fw-bold text-muted d-block text-center mb-2">Simulação Rápida de Perfis (Ambiente Demo):</span>
                                <div class="d-grid gap-1">
                                    <button type="button" class="btn btn-xs btn-outline-success text-start d-flex justify-content-between align-items-center" onclick="window.quickLoginAs('user-fin-mariana')">
                                        <span><strong>Maria Souza</strong> &bull; Financeiro Operacional (N1)</span>
                                        <span class="badge bg-success">N1 &bull; R$ 50k</span>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="window.quickLoginAs('user-admin-carlos')">
                                        <span><strong>Carlos Lima</strong> &bull; Gestor Financeiro (N2)</span>
                                        <span class="badge bg-primary">N2 &bull; R$ 500k</span>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-warning text-dark text-start d-flex justify-content-between align-items-center" onclick="window.quickLoginAs('user-producer-joao')">
                                        <span><strong>João Silva</strong> &bull; Produtor Parque Jaime Lerner</span>
                                        <span class="badge bg-warning text-dark">Produtor</span>
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-dark text-start d-flex justify-content-between align-items-center" onclick="window.quickLoginAs('user-admin-master')">
                                        <span><strong>Admin Master</strong> &bull; Acesso Irrestrito</span>
                                        <span class="badge bg-dark">Master</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ============================================================================ -->
                    <!-- CENTRAL UNIFICADA DE APROVAÇÕES (WORKFLOW TRANSVERSAL PRODUTOR -> FINANCEIRO)   -->
                    <!-- ============================================================================ -->
                    <section id="view-financial-approvals" class="page-section" style="display:none;">
                        <!-- Header com Título e Switcher de Perfil RBAC / Simulação -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
