                        <!-- Cabeçalho Principal -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-md-center py-2 px-3 mb-3 border-0" style="border-radius: 12px; background: #fff;">
                            <div class="d-flex align-items-center gap-3">
