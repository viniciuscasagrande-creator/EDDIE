                                        <!-- VIEW: Financeiro - Saldo Consolidado -->
                    <section id="view-financial-balance" class="page-section"  style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-0" style="border-radius: 6px;">
                            <h5 class="fw-bold mb-0">Financeiro</h5>
                            <div class="d-flex flex-wrap gap-2 align-items-center w-100 w-md-auto">
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" id="financial-export-csv-btn" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-file-csv"></i> Exportar CSV
                                </button>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="toggleFinancialShowClosed()" id="btn-financial-closed" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
