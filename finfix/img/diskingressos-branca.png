                            <!-- SUBTAB 3.5: Borderô -->
                            <div class="financial-subpane p-3" id="subpane-bordero" >
                                <!-- Event Selector & Badge Header -->
                                <div class="card card-body bg-light border p-2 d-flex flex-row justify-content-between align-items-center mb-3 flex-wrap gap-2" style="border-radius: 6px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="form-label mb-0 fw-bold fs-xs text-muted text-uppercase" for="financial-bordero-event-selector">Selecionar Evento:</label>
                                        <select class="form-select form-select-sm fw-bold border-secondary" id="financial-bordero-event-selector" style="width: 250px;" onchange="loadEventBorderoData(this.value)" title="Selecionar evento para o borderô">
                                            <!-- Dynamically filled -->
                                        </select>
                                    </div>
                                    <div class="d-flex align-items-center gap-2" id="bordero-status-container">
                                        <!-- Loaded dynamically -->
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <!-- Left: Detailed Bordero Calculation Sheet -->
                                    <div class="col-xl-8 col-lg-7">
                                        <div class="card shadow-sm border h-100" style="border-radius: 8px;">
                                            <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                                                <h6 class="fw-bold mb-0 text-dark"><i class="ph-file-text text-primary me-2"></i> Demonstrativo Financeiro (Borderô)</h6>
                                                <span class="fs-xs text-muted" id="bordero-date-stamp"></span>
                                            </div>
                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table mb-0 align-middle">
                                                    <tbody>
                                                        <tr class="bg-light">
                                                            <td class="fw-bold text-dark" style="width: 60%">1. RECEITA BRUTA DE VENDAS</td>
                                                            <td class="text-right fw-bold text-dark font-monospace text-end" id="bordero-val-gross">R$ 0,00</td>
                                                        </tr>
                                                        <tr>
                                                            <td class="ps-4 text-muted fs-xs">Ingressos Vendidos (Vendas)</td>
                                                            <td class="text-right text-dark font-monospace text-end" id="bordero-val-sales-qty">0 un.</td>
                                                        </tr>
                                                        <tr>
                                                            <td class="ps-4 text-muted fs-xs">Ingressos Cortesia (Emissões Gratuitas)</td>
                                                            <td class="text-right text-dark font-monospace text-end" id="bordero-val-cortesia-qty">0 un.</td>
                                                        </tr>
                                                        <tr class="bg-light">
                                                            <td class="fw-bold text-danger">2. TAXAS E RETENÇÕES OPERACIONAIS</td>
                                                            <td class="text-right fw-bold text-danger font-monospace text-end" id="bordero-val-total-fees">- R$ 0,00</td>
                                                        </tr>
                                                        <tr>
                                                            <td class="ps-4 text-muted fs-xs">Taxa Administrativa Plataforma (10%)</td>
                                                            <td class="text-right text-dark font-monospace text-end" id="bordero-val-platform-fee">- R$ 0,00</td>
                                                        </tr>
                                                        <tr>
                                                            <td class="ps-4 text-muted fs-xs">Taxa Cartão de Crédito/PIX (5%)</td>
                                                            <td class="text-right text-dark font-monospace text-end" id="bordero-val-card-fee">- R$ 0,00</td>
                                                        </tr>
                                                        <tr>
                                                            <td class="ps-4 text-muted fs-xs">Despesas Lançadas (Operação de Caixa/ECAD)</td>
                                                            <td class="text-right text-dark font-monospace text-end" id="bordero-val-expenses">- R$ 0,00</td>
                                                        </tr>
                                                        <tr class="bg-success bg-opacity-10" style="font-weight: 800; font-size: 13px;">
                                                            <td class="text-success">3. VALOR LÍQUIDO A REPASSAR AO PRODUTOR</td>
                                                            <td class="text-right text-success font-monospace text-end fs-5" id="bordero-val-net" style="font-weight: 800;">R$ 0,00</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right: Autentique Digital Signature and Finance Scheduling Form -->
                                    <div class="col-xl-4 col-lg-5">
                                        <div class="d-flex flex-column gap-3">
                                            <!-- Box 1: Digital Signature Autentique -->
                                            <div class="card shadow-sm border p-3" style="border-radius: 8px;">
                                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                                    <i class="ph-signature text-primary me-2"></i> Assinatura Autentique
                                                </h6>
                                                <p class="text-muted fs-xs mb-3">Este borderô deve ser assinado digitalmente pelo produtor e pelo departamento financeiro antes da liberação do saldo.</p>
                                                
                                                <div class="d-flex flex-column gap-2">
                                                    <a href="https://painel.autentique.com.br/" target="_blank" class="btn btn-primary btn-sm fw-bold w-100 d-inline-flex align-items-center justify-content-center gap-1">
                                                        <i class="ph-pencil-line"></i> ASSINAR VIA AUTENTIQUE
                                                    </a>
                                                    
                                                    <button class="btn btn-outline-primary btn-sm fw-bold w-100 d-inline-flex align-items-center justify-content-center gap-1" onclick="sendBorderoSignatureNotification()">
                                                        <i class="ph-bell"></i> Notificar Assinatura do Borderô
                                                    </button>
                                                </div>
                                                
                                                <!-- Log message of signature alert status -->
                                                <div class="mt-3 bg-light border rounded p-2 text-dark fs-xxs" id="bordero-notification-log">
                                                    <i class="ph-info me-1 text-primary"></i> Status: Notificação de assinatura não disparada hoje.
                                                </div>
                                            </div>

                                            <!-- Box 2: Finance Department Scheduling Form -->
                                            <div class="card shadow-sm border p-3" style="border-radius: 8px;">
                                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                                    <i class="ph-calendar-plus text-success me-2"></i> Programação pelo Financeiro
                                                </h6>
                                                <form id="bordero-finance-programming-form" onsubmit="saveBorderoProgramming(event)">
                                                    <div class="mb-2">
                                                        <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="bordero-payment-date">Data Programada para Pagamento</label>
                                                        <input type="date" id="bordero-payment-date" class="form-control form-control-sm" required>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="bordero-target-bank">Banco para Liquidação</label>
                                                        <select id="bordero-target-bank" class="form-select form-select-sm" required title="Selecione o banco de destino">
                                                            <option value="">Selecione a conta...</option>
                                                            <option value="bb">Banco do Brasil (001) - CC: 98765-4</option>
                                                            <option value="itau">Itaú Unibanco (341) - CC: 10452-3</option>
                                                            <option value="bradesco">Bradesco (237) - CC: 77521-8</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="bordero-finance-notes">Observações Financeiras</label>
                                                        <textarea id="bordero-finance-notes" class="form-control form-control-sm" rows="3" placeholder="Instruções de liquidação ou restrições..."></textarea>
                                                    </div>
                                                    <button type="submit" class="btn btn-success btn-sm fw-bold w-100">
                                                        <i class="ph-floppy-disk me-1"></i> Gravar Programação
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                        </div>
                    </section>

                    <!-- VIEW: Financeiro - Dashboard Portal -->
                    <section id="view-financial-dashboard" class="page-section"  style="display:none;">
                        <!-- Dashboard Header -->
                        <div class="card card-body shadow-sm d-flex flex-row justify-content-between align-items-center py-3 mb-3 hub-header-gradient text-white" style="border-radius: 12px; border: 0;">
                            <div>
                                <h4 class="fw-bold mb-0 text-white"><i class="ph-wallet text-warning me-2"></i> Hub Financeiro</h4>
                                <p class="text-muted fs-xs mb-0 mt-1">Selecione uma das opções abaixo para gerenciar a saúde financeira de seus eventos</p>
                            </div>
                            <span class="badge bg-warning text-dark fw-bold px-3 py-2">Módulos Ativos</span>
                        </div>

                        <!-- Hub Categories -->
                        <div class="row g-3">
                            <!-- Category 1: Operações e Caixa -->
                            <div class="col-md-12">
                                <h6 class="fw-bold text-muted text-uppercase fs-xxs letter-spacing-1 mb-2">Operações de Caixa</h6>
                                <div class="row g-3">
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-balance')" style="border-top: 3px solid #3b82f6 !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #3b82f6; background: rgba(59, 130, 246, 0.1);"><i class="ph-wallet"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Saldo Consolidado</h6>
                                            <p class="text-muted fs-xxs mb-0">Saldo geral acumulado e exportes rápidos.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-repass')" style="border-top: 3px solid #10b981 !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #10b981; background: rgba(16, 185, 129, 0.1);"><i class="ph-hand-coins"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Solicitar Repasse</h6>
                                            <p class="text-muted fs-xxs mb-0">Solicite a transferência para sua conta.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-advance')" style="border-top: 3px solid #f59e0b !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #f59e0b; background: rgba(245, 158, 11, 0.1);"><i class="ph-trend-up"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Antecipações</h6>
                                            <p class="text-muted fs-xxs mb-0">Antecipe o recebimento de vendas a prazo.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-statement')" style="border-top: 3px solid #6b7280 !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #6b7280; background: rgba(107, 114, 128, 0.1);"><i class="ph-receipt"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Extrato Geral</h6>
                                            <p class="text-muted fs-xxs mb-0">Filtre, pesquise e analise lançamentos.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-pdv')" style="border-top: 3px solid #d946ef !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #d946ef; background: rgba(217, 70, 239, 0.1);"><i class="ph-storefront"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Pontos de Venda (PDV)</h6>
                                            <p class="text-muted fs-xxs mb-0">Gerencie bilheterias físicas e quiosques.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-refunds')" style="border-top: 3px solid #ef4444 !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #ef4444; background: rgba(239, 68, 68, 0.1);"><i class="ph-arrow-counter-clockwise"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Devoluções / Estornos</h6>
                                            <p class="text-muted fs-xxs mb-0">Estorne ingressos e gerencie cancelamentos.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Category 2: Advanced & Inteligência -->
                            <div class="col-md-12 mt-4">
                                <h6 class="fw-bold text-muted text-uppercase fs-xxs letter-spacing-1 mb-2">Advanced &amp; Inteligência</h6>
                                <div class="row g-3">
                                    <div class="col-md-2 col-sm-6">
                                        <div class="card h-100 card-financial-hub p-3" onclick="window.switchActiveView('financial-advanced')" style="border-top: 3px solid #8b5cf6 !important;">
                                            <div class="icon-box-gradient mb-2" style="color: #8b5cf6; background: rgba(139, 92, 246, 0.1);"><i class="ph-presentation-chart"></i></div>
                                            <h6 class="fw-bold text-dark mb-1 fs-xs">Financeiro Advanced</h6>
                                            <p class="text-muted fs-xxs mb-0">Fluxo de caixa previsto, contas a pagar e a receber.</p>
                                        </div>
                                    </div>
