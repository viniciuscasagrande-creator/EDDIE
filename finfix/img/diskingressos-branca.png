                                                            <th>Status do Lote</th>
                                                            <th>Homologado Por</th>
                                                            <th class="text-end pe-3">Ações de Lote</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="table-financeiro-lotes-body">
