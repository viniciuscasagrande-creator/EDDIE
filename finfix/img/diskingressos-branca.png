                                                        <th class="text-end">Custo Fixo Gateway</th>
                                                        <th class="text-end">Antifraude</th>
                                                        <th class="text-end fw-bold">Custo Total Est.</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="taxas-costs-tbody" class="fs-xs">
                                                    <!-- Preenchido via controller -->
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- MDR e Liquidações por Adquirente (Implantação 5.2) -->
                                        <div class="card mt-3 shadow-none border">
                                            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-0 fw-bold fs-xs text-uppercase text-dark"><i class="ph-credit-card me-1 text-primary"></i> MDR e Liquidações por Adquirente (Real)</h6>
                                                    <div class="text-muted fs-xxs">Cielo, Rede, Stone e PagBank &bull; Contrato &times; Custo Retido &times; Líquido Liquidado</div>
                                                </div>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fs-xxs">Fonte: Adquirência Real</span>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th>Adquirente</th>
                                                            <th class="text-end">Transações</th>
                                                            <th class="text-end">Volume Bruto</th>
                                                            <th class="text-end">MDR Contratado</th>
                                                            <th class="text-end">MDR Retido</th>
                                                            <th class="text-end">Líquido Liquidado</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="fin-acquirer-breakdown" class="fs-xs">
                                                        <!-- Preenchido dinamicamente via controller -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- TAB 3: SIMULADOR DE COMPOSIÇÃO -->
                                    <div class="tab-pane fade" id="pane-taxas-simulador" role="tabpanel">
                                        <div class="row g-3">
                                            <div class="col-md-5">
                                                <div class="card border p-3 bg-light shadow-none mb-0">
                                                    <h6 class="fw-bold text-dark fs-xs text-uppercase mb-2">Parâmetros de Simulação</h6>
                                                    <div class="mb-2">
                                                        <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Evento Base</label>
                                                        <select class="form-select form-select-sm" id="sim-event-select">
                                                            <option value="3368">3368 - Parque Jaime Lerner (15%)</option>
                                                            <option value="3195">3195 - Festival de Inverno (12%)</option>
                                                            <option value="3178">3178 - Stand-up Especial (10%)</option>
                                                            <option value="934">934 - Show Rock Nacional (R$ 5,00/ing)</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Volume de Vendas Brutas (R$)</label>
                                                        <input type="number" class="form-control form-control-sm" id="sim-gross-amount" value="1000000" step="1000">
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Quantidade de Ingressos</label>
                                                        <input type="number" class="form-control form-control-sm" id="sim-ticket-count" value="10000" step="100">
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Estornos Solicitados (R$)</label>
                                                        <input type="number" class="form-control form-control-sm" id="sim-refunds-amount" value="30000" step="500">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Chargebacks Registrados (R$)</label>
                                                        <input type="number" class="form-control form-control-sm" id="sim-chargeback-amount" value="5000" step="500">
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-primary w-100" id="btn-run-composition-sim">
                                                        <i class="ph-calculator me-1"></i> Calcular Composição Exata
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-md-7">
                                                <div class="card border p-3 shadow-none mb-0 h-100">
                                                    <h6 class="fw-bold text-dark fs-xs text-uppercase mb-2">Resultado da Decomposição Financeira</h6>
                                                    <ul class="list-group list-group-flush fs-xs" id="sim-composition-results-list">
                                                        <!-- Renderizado dinamicamente -->
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- TAB 4: HISTÓRICO VERSIONADO -->
                                    <div class="tab-pane fade" id="pane-taxas-historico" role="tabpanel">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0">
                                                <thead class="table-light fs-xs text-uppercase text-muted">
                                                    <tr>
                                                        <th>Versão</th>
                                                        <th>Data / Hora</th>
                                                        <th>Usuário / Ator</th>
                                                        <th>Evento / Produtor</th>
                                                        <th>Tipo</th>
                                                        <th class="text-end">Valor Anterior</th>
                                                        <th class="text-end fw-bold text-success">Novo Valor</th>
                                                        <th>Justificativa</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="taxas-history-tbody" class="fs-xs">
                                                    <!-- Preenchido via controller -->
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- MODAL: CONFIGURAÇÃO DE REGRA DE TAXA -->
                    <div class="modal fade" id="modal-configure-fee-rule" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header py-2 bg-light">
                                    <h6 class="modal-title fw-bold fs-sm text-dark">
                                        <i class="ph-sliders me-1 text-primary"></i> Configurar Regra de Taxa Disk
                                    </h6>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <form id="form-configure-fee-rule">
                                        <div class="mb-2">
                                            <label class="form-label fs-xxs text-uppercase fw-bold text-muted mb-1">Evento Alvo (ou Padrão)</label>
                                            <select class="form-select form-select-sm" id="modal-fee-target" required>
                                                <option value="DEFAULT">Padrão Global da Plataforma</option>
                                                <option value="3368">3368 - Parque Jaime Lerner</option>
                                                <option value="3195">3195 - Festival de Inverno 2026</option>
                                                <option value="3178">3178 - Stand-up Comedy Especial</option>
                                                <option value="934">934 - Show Rock Nacional</option>
                                                <option value="1001">1001 - Encontro Gastronômico</option>
                                                <option value="1002">1002 - Turnê Sinfônica 2026</option>
                                            </select>
                                        </div>
                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <label class="form-label fs-xxs text-uppercase fw-bold text-muted mb-1">Tipo de Taxa</label>
                                                <select class="form-select form-select-sm" id="modal-fee-type">
                                                    <option value="PERCENTAGE">Percentual (%)</option>
                                                    <option value="FIXED_PER_TICKET">Fixo por Ingresso (R$)</option>
                                                    <option value="FIXED_EVENT">Fixo por Evento (R$)</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fs-xxs text-uppercase fw-bold text-muted mb-1">Valor da Taxa</label>
                                                <input type="number" class="form-control form-control-sm" id="modal-fee-rate" step="0.01" value="15" required>
                                            </div>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label fs-xxs text-uppercase fw-bold text-muted mb-1">Base de Cálculo</label>
                                            <select class="form-select form-select-sm" id="modal-fee-base">
                                                <option value="GROSS_SALES">Vendas Brutas (GMV)</option>
                                                <option value="NET_SALES">Vendas Líquidas de Estornos</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fs-xxs text-uppercase fw-bold text-muted mb-1">Justificativa / Motivo da Alteração</label>
                                            <textarea class="form-control form-control-sm" id="modal-fee-reason" rows="2" placeholder="Ex: Negociação comercial aditivo contratual #2026-B..." required></textarea>
                                        </div>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-sm btn-primary">Salvar Regra</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: EDITOR DE TAXA DO EVENTO (IMPLANTAÇÃO 5.1) -->
                    <div class="modal fade" id="fee-rule-modal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-2">
                                    <div>
                                        <h6 class="modal-title fw-bold text-dark mb-0"><i class="ph-sliders me-1 text-primary"></i> Configurar Taxa do Evento</h6>
                                        <div class="text-muted fs-xs" id="fee-rule-event-name"></div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <input type="hidden" id="fee-rule-event-id">
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Modelo da Taxa</label>
                                        <select class="form-select form-select-sm fw-bold" id="fee-rule-type">
                                            <option value="PERCENT">Percentual sobre vendas (%)</option>
                                            <option value="FIXED_PER_TICKET">Valor fixo por ingresso (R$/ing)</option>
                                            <option value="FIXED_EVENT">Valor fixo por evento (R$/evento)</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Valor da Taxa</label>
                                        <input class="form-control form-control-sm fw-bold font-monospace" id="fee-rule-value" type="number" min="0" step="0.01">
                                        <div class="form-text fs-xxs text-muted">Para percentual, informe 15 para 15%. Para valor fixo, informe o valor em reais.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Início da Vigência</label>
                                        <input class="form-control form-control-sm" id="fee-rule-effective-from" type="date">
                                    </div>
                                    <div class="alert alert-info py-2 mb-0 fs-xs">
                                        <i class="ph-info me-1"></i> A alteração cria uma nova vigência. A regra anterior é preservada no histórico para auditoria e memória de cálculo.
                                    </div>
                                </div>
                                <div class="modal-footer py-2 bg-light">
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button class="btn btn-sm btn-primary fw-bold" onclick="window.saveFeeRule()">Salvar Nova Vigência</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL / DRAWER: COMPOSIÇÃO FINANCEIRA DETALHADA -->
                    <div class="modal fade" id="modal-financial-composition-drawer" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header py-2 bg-light">
                                    <h6 class="modal-title fw-bold fs-sm text-dark d-flex align-items-center gap-2">
                                        <i class="ph-tree-structure text-primary"></i> <span id="composition-drawer-title">Composição Financeira Detalhada</span>
                                    </h6>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <div class="alert alert-light border py-2 px-3 mb-3 fs-xs text-muted d-flex align-items-center justify-content-between">
                                        <div>
                                            <strong>Regra Aplicada:</strong> <span id="comp-rule-badge" class="badge bg-primary">Percentual 15%</span>
                                        </div>
                                        <div>
                                            <strong>Status:</strong> <span class="badge bg-success">Homologado no Ledger</span>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped align-middle mb-0 fs-xs">
                                            <tbody>
                                                <tr>
                                                    <td class="fw-semibold">1. Vendas Brutas (GMV)</td>
                                                    <td class="text-end fw-bold text-dark" id="comp-row-gross">R$ 0,00</td>
                                                </tr>
                                                <tr class="table-warning">
                                                    <td>(-) Taxa da Plataforma Disk (Comissão)</td>
                                                    <td class="text-end text-danger fw-semibold" id="comp-row-disk-fee">- R$ 0,00</td>
                                                </tr>
                                                <tr class="table-warning">
                                                    <td>(-) Custos de Meios de Pagamento (MDR + Antifraude)</td>
                                                    <td class="text-end text-danger fw-semibold" id="comp-row-costs">- R$ 0,00</td>
                                                </tr>
                                                <tr class="table-danger">
                                                    <td>(-) Estornos Aprovados</td>
                                                    <td class="text-end text-danger fw-semibold" id="comp-row-refunds">- R$ 0,00</td>
                                                </tr>
                                                <tr class="table-danger">
                                                    <td>(-) Chargebacks Efetivados</td>
                                                    <td class="text-end text-danger fw-semibold" id="comp-row-chargebacks">- R$ 0,00</td>
                                                </tr>
                                                <tr class="table-info fw-bold">
                                                    <td>(=) Recursos Totais do Produtor Gerados</td>
                                                    <td class="text-end text-primary" id="comp-row-producer-funds">R$ 0,00</td>
                                                </tr>
                                                <tr>
                                                    <td>(-) Repasses Já Efetuados e Liquidados</td>
                                                    <td class="text-end text-muted" id="comp-row-paid">- R$ 0,00</td>
                                                </tr>
                                                <tr>
                                                    <td>(-) Bloqueios Judiciais e Reservas Técnicas</td>
                                                    <td class="text-end text-muted" id="comp-row-reserves">- R$ 0,00</td>
                                                </tr>
                                                <tr>
                                                    <td>(-) Valores Comprometidos em Solicitações</td>
                                                    <td class="text-end text-muted" id="comp-row-committed">- R$ 0,00</td>
                                                </tr>
                                                <tr class="table-success fw-bold fs-6">
                                                    <td>(=) SALDO DISPONÍVEL ATUAL</td>
                                                    <td class="text-end text-success" id="comp-row-available">R$ 0,00</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="modal-footer py-1 bg-light">
                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================================================ -->
                    <!-- IMPLANTAÇÃO 5.3: FECHAMENTO FINANCEIRO POR EVENTO (ORIGEM REAL NO LEDGER)    -->
                    <!-- ============================================================================ -->
                    <section id="view-financial-fechamento" class="page-section" style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                    <i class="ph-file-lock text-warning"></i> <span id="closing-header-title">Fechamento Financeiro</span>
                                    <span id="closing-header-status-badge" class="badge bg-secondary fs-xs">Em Apuração</span>
                                </h5>
                                <div class="text-muted fs-xs" id="closing-header-period">
                                    Apuração oficial por evento &bull; Rastreabilidade total Vendas &rarr; Deduções &rarr; Repasses &rarr; Conciliação
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="btn-print-closing-report">
                                    <i class="ph-printer"></i> <span>Imprimir / Gerar PDF</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="btn-closing-approve-disk">
                                    <i class="ph-seal-check"></i> <span>Aprovar Fechamento (Disk)</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-success text-white d-flex align-items-center gap-1" id="btn-closing-accept-producer">
                                    <i class="ph-signature"></i> <span>Confirmar Ciência (Produtor)</span>
                                </button>
                            </div>
                        </div>

                        <!-- Filtros de Topo -->
                        <div class="card card-body shadow-sm py-2 mb-3 bg-light" style="border-radius: 6px;">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-5">
                                    <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Evento em Fechamento</label>
                                    <select class="form-select form-select-sm fw-bold" id="closing-filter-event">
                                        <option value="5096">#5096 - Festival Sunset Disk 2026 (Ref. R$ 50.960,00 | 514 Ingressos)</option>
                                        <option value="3368">#3368 - Circuito Gastronômico Jaime Lerner (R$ 150.000,00)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Período Contábil</label>
                                    <select class="form-select form-select-sm" id="closing-filter-period">
                                        <option value="2026-09" selected>Setembro / 2026</option>
                                        <option value="2026-08">Agosto / 2026</option>
                                        <option value="ALL">Todo o Histórico</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Status da Conciliação</label>
                                    <select class="form-select form-select-sm" id="closing-filter-status">
                                        <option value="ALL">Todos os Status</option>
                                        <option value="PRONTO_FECHAMENTO" selected>Pronto para Fechamento</option>
                                        <option value="FECHADO">Fechado &amp; Homologado</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 12 KPIs de Fechamento -->
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #3b82f6 !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Vendas Brutas</span>
                                    <h6 class="fw-bold text-primary mb-0 mt-1" id="closing-kpi-gross">R$ 50.960,00</h6>
                                    <span class="fs-xxs text-muted">GMV Total</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #6366f1 !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Ingressos Vendidos</span>
                                    <h6 class="fw-bold text-dark mb-0 mt-1" id="closing-kpi-sold">476</h6>
                                    <span class="fs-xxs text-muted">Ingressos Pagos</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #f59e0b !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Cortesias</span>
                                    <h6 class="fw-bold text-warning mb-0 mt-1" id="closing-kpi-complimentary">38</h6>
                                    <span class="fs-xxs text-muted">Cortesias Emitidas</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #10b981 !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Total de Ingressos</span>
                                    <h6 class="fw-bold text-success mb-0 mt-1" id="closing-kpi-tickets-total">514</h6>
                                    <span class="fs-xxs text-muted">Vendidos + Cortesias</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #f59e0b !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Taxa Disk</span>
                                    <h6 class="fw-bold text-warning mb-0 mt-1" id="closing-kpi-disk-fee">-R$ 5.096,00</h6>
                                    <span class="fs-xxs text-muted">10% Contratual</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #ef4444 !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">MDR / Adquirência</span>
                                    <h6 class="fw-bold text-danger mb-0 mt-1" id="closing-kpi-acquiring">-R$ 1.135,80</h6>
                                    <span class="fs-xxs text-muted">Cielo, Rede, Stone</span>
                                </div>
                            </div>

                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #ec4899 !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Estornos</span>
                                    <h6 class="fw-bold text-danger mb-0 mt-1" id="closing-kpi-refunds">-R$ 800,00</h6>
                                    <span class="fs-xxs text-muted">Processados</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
                                <div class="card shadow-sm border-0 mb-0 h-100 p-2" style="border-left: 3px solid #8b5cf6 !important;">
                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Chargebacks</span>
                                    <h6 class="fw-bold text-muted mb-0 mt-1" id="closing-kpi-chargebacks">R$ 0,00</h6>
                                    <span class="fs-xxs text-muted">Contestações</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-xl-2">
