                                            <input type="date" class="form-control" value="2026-09-03">
                                            <span class="align-self-center text-muted">até</span>
                                            <input type="date" class="form-control" value="2026-09-07">
                                        </div>
                                    </div>
                                </div>

                                <!-- Controle de Frequência Card -->
