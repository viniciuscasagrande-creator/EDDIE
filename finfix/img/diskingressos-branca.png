                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                                    <i class="ph-chart-line text-primary"></i> Curva de Caixa Projetada (Dia a Dia)
                                                </h6>
                                                <span class="badge bg-light text-muted border fs-xs" id="ft-fc-curve-legend">Evolução de Saldo</span>
                                            </div>
                                            <div style="height: 250px; position: relative;" id="ft-fc-chart-container">
                                                <canvas id="ft-fc-chart-curve"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-4">
                                        <div class="card h-100 border shadow-none p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                                    <i class="ph-chart-bar text-success"></i> Entradas vs Saídas Diárias
                                                </h6>
                                                <span class="badge bg-light text-muted border fs-xs">Fluxo Diário</span>
                                            </div>
                                            <div style="height: 250px; position: relative;">
                                                <canvas id="ft-fc-chart-flow"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Seção de Cobertura Recomendada & Alertas Preditivos -->
                                <div id="ft-fc-coverage-section" class="mb-4 d-none">
                                    <div class="card border-danger-subtle bg-danger-subtle p-3 mb-0">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="ph-warning-octagon text-danger fs-4"></i>
                                                <div>
                                                    <h6 class="fw-bold text-danger mb-0">Recomendações de Cobertura entre Eventos do Mesmo Produtor</h6>
                                                    <span class="fs-xs text-danger">Eventos com déficit projetado identificados. Cobertura calculada com base na capacidade segura dos candidatos.</span>
                                                </div>
                                            </div>
                                            <span class="badge bg-danger text-white fs-xs" id="ft-fc-coverage-count-badge">0 Alertas</span>
                                        </div>
                                        <div class="row g-2 mt-2" id="ft-fc-coverage-cards-container">
                                            <!-- Cards de Cobertura gerados via JS -->
                                        </div>
                                    </div>
                                </div>

                                <!-- Tabela Preditiva por Evento -->
                                <div class="card border shadow-none">
                                    <div class="card-header bg-transparent border-bottom py-2 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                            <i class="ph-table text-primary"></i> Posição Preditiva Detalhada por Evento
                                        </h6>
                                        <span class="badge bg-light text-muted border fs-xs">Classificação de Risco &amp; Ações</span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light fs-xs text-uppercase text-muted">
                                                <tr>
                                                    <th style="width: 24%;">Evento</th>
                                                    <th style="width: 11%;" class="text-end">Disponível Real</th>
                                                    <th style="width: 11%;" class="text-end">Entradas Prev.</th>
                                                    <th style="width: 11%;" class="text-end">Saídas Prev.</th>
                                                    <th style="width: 11%;" class="text-end">Saldo Projetado</th>
                                                    <th style="width: 11%;" class="text-end">Menor Saldo</th>
                                                    <th style="width: 9%;" class="text-center">Status Risco</th>
                                                    <th style="width: 12%;" class="text-center">Ações</th>
                                                </tr>
                                            </thead>
                                            <tbody id="ft-fc-events-tbody" class="fs-xs">
                                                <!-- Preenchido via JS -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- PANE 7: Motor Central de Regras de Repasse e Prioridades Financeiras (Fase 26.17.9.5.6) -->
                            <div class="card-body p-3" id="ft-pane-rules" style="display:none;">
                                <!-- Top Banner do Motor de Regras -->
                                <div class="card shadow-sm border-0 mb-3" style="background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%); border-left: 5px solid #7c3aed !important;">
                                    <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="rounded-circle bg-white shadow-sm p-2 text-purple d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; color: #7c3aed;">
                                                <i class="ph-cpu fs-4"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark fs-sm d-flex align-items-center gap-2">
                                                    Motor Central de Regras de Repasse e Prioridades Financeiras
                                                    <span class="badge text-white fs-xs" style="background-color: #7c3aed;">Fase 26.17.9.5.6</span>
                                                    <span class="badge bg-light text-dark border fs-xs">5 Respostas Formais</span>
                                                </div>
                                                <div class="text-secondary fs-xs mt-1">
                                                    Orquestração central pré-operacional: <code>ALLOW</code>, <code>ALLOW_WITH_APPROVAL</code>, <code>ALLOW_PARTIAL</code>, <code>HOLD</code> e <code>BLOCK</code>. Sem regras hardcoded, com reservas dinâmicas, 9 prioridades auditáveis e simulador interativo.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-white text-dark border px-3 py-2 fs-xs fw-semibold shadow-sm d-flex align-items-center gap-1" id="ft-rules-engine-status-badge">
                                                <i class="ph-check-circle text-success fs-sm"></i> Motor Operacional Ativo
                                            </span>
                                            <button class="btn btn-sm text-white fw-bold d-flex align-items-center gap-1" onclick="window.switchRulesSubTab('simulator')" style="font-size: 12px; background-color: #7c3aed; border-color: #6d28d9;">
                                                <i class="ph-play-circle"></i> Abrir Simulador
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- 6 KPIs Principais do Motor -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Políticas Ativas</span>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-rul-kpi-policies-count">3</div>
                                            <span class="fs-xs text-muted">Global / Prod / Ev</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Reserva Mínima</span>
                                            <div class="fs-5 fw-bold text-primary mt-1" id="ft-rul-kpi-min-reserve">10% / R$ 1.500</div>
                                            <span class="fs-xs text-muted">Regra: Maior valor</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Teto Sem Aprovação</span>
                                            <div class="fs-5 fw-bold text-success mt-1" id="ft-rul-kpi-max-without-app">R$ 10.000,00</div>
                                            <span class="fs-xs text-muted">Liberação direta</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Dupla Aprovação</span>
                                            <div class="fs-5 fw-bold text-warning mt-1" id="ft-rul-kpi-two-level-app">Acima de R$ 50k</div>
                                            <span class="fs-xs text-muted">Alçada Diretoria</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Janela Operacional</span>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-rul-kpi-window-status">08h - 18h</div>
                                            <span class="fs-xs text-success" id="ft-rul-kpi-window-sub">Dias Úteis (Ativa)</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Exceções Vigentes</span>
                                            <div class="fs-5 fw-bold text-purple mt-1" id="ft-rul-kpi-exceptions-count" style="color: #7c3aed;">0</div>
                                            <span class="fs-xs text-muted">Com alçada formal</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card das 8 Sub-abas Administrativas -->
                                <div class="card border shadow-none mb-3">
                                    <div class="card-header bg-light border-bottom p-2">
                                        <ul class="nav nav-pills" id="ft-rules-subtabs" style="gap: 6px;">
                                            <li class="nav-item">
                                                <button class="nav-link active py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('policies')" id="ft-rul-btn-subtab-policies">
                                                    <i class="ph-files me-1"></i> Políticas
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('priorities')" id="ft-rul-btn-subtab-priorities">
                                                    <i class="ph-list-numbers me-1"></i> Prioridades (9)
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('reserves')" id="ft-rul-btn-subtab-reserves">
                                                    <i class="ph-vault me-1"></i> Reservas
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('blocks')" id="ft-rul-btn-subtab-blocks">
                                                    <i class="ph-lock-key me-1"></i> Bloqueios
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('limits')" id="ft-rul-btn-subtab-limits">
                                                    <i class="ph-shield-star me-1"></i> Alçadas
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('exceptions')" id="ft-rul-btn-subtab-exceptions">
                                                    <i class="ph-asterisk me-1"></i> Exceções
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold text-purple" onclick="window.switchRulesSubTab('simulator')" id="ft-rul-btn-subtab-simulator" style="font-weight: 700;">
                                                    <i class="ph-chart-polar me-1"></i> Simulador
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchRulesSubTab('audit')" id="ft-rul-btn-subtab-audit">
                                                    <i class="ph-clock-counter-clockwise me-1"></i> Auditoria
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="card-body p-3">
                                        <!-- SUB-PANE 1: POLÍTICAS CONFIGURADAS -->
                                        <div id="ft-rul-pane-policies" class="rul-subpane">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Políticas de Repasse e Limites Financeiros</h6>
                                                    <span class="fs-xs text-muted">Configurações ativas por escopo hierárquico (Evento &gt; Produtor &gt; Global). Prevalece sempre a condição mais restritiva.</span>
                                                </div>
                                                <span class="badge bg-light text-muted border fs-xs">Persistência Central</span>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th style="width: 25%;">Nome da Política</th>
                                                            <th style="width: 10%;">Escopo</th>
                                                            <th style="width: 10%;" class="text-center">Precedência</th>
                                                            <th style="width: 15%;">Reserva Mínima</th>
                                                            <th style="width: 12%;" class="text-end">Teto Direto</th>
                                                            <th style="width: 13%;" class="text-end">Dupla Alçada</th>
                                                            <th style="width: 15%;" class="text-center">Janela Bancária</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="ft-rul-policies-tbody" class="fs-xs">
                                                        <!-- Renderizado dinamicamente -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 2: 9 PRIORIDADES FINANCEIRAS OFICIAIS -->
                                        <div id="ft-rul-pane-priorities" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Ordem Canônica de Prioridades Financeiras</h6>
                                                    <span class="fs-xs text-muted">Estrutura oficial de destinação e liquidação de caixa do ecossistema SafeSaff / PDT.</span>
                                                </div>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fs-xs">Validado pela Controladoria</span>
                                            </div>
                                            <div class="row g-2" id="ft-rul-priorities-container">
                                                <!-- Renderizado dinamicamente -->
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 3: RESERVAS MÍNIMAS -->
                                        <div id="ft-rul-pane-reserves" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Cálculo e Composição de Reservas Mínimas</h6>
                                                    <span class="fs-xs text-muted">Buffer de segurança operacional contra chargebacks, estornos e garantias contratuais.</span>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="card h-100 border p-3 shadow-none bg-light">
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <i class="ph-scales text-primary fs-4"></i>
                                                            <h6 class="fw-bold text-dark mb-0">Regra GREATER_OF</h6>
                                                        </div>
                                                        <p class="fs-xs text-muted mb-2">A reserva mínima aplica o <strong>maior valor</strong> entre a Reserva Fixa estipulada em contrato e o Percentual Mínimo sobre o saldo liquidado.</p>
                                                        <div class="p-2 bg-white rounded border fs-xs font-monospace text-dark">
                                                            Reserva = Math.max(minReserveFixed, settledBase * minReservePercent)
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card h-100 border p-3 shadow-none bg-light">
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <i class="ph-shield-warning text-danger fs-4"></i>
                                                            <h6 class="fw-bold text-dark mb-0">Fundo Garantidor de Chargebacks</h6>
                                                        </div>
                                                        <p class="fs-xs text-muted mb-2">Retenção de segurança de 100% de qualquer contestação ou chargeback em aberto, bloqueando saídas até encerramento do litígio com a adquirente.</p>
                                                        <div class="p-2 bg-white rounded border fs-xs font-monospace text-danger">
                                                            CapacidadeLíquida = Math.max(0, SaldoDisponível - Reserva)
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card h-100 border p-3 shadow-none bg-light">
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <i class="ph-percentage text-success fs-4"></i>
                                                            <h6 class="fw-bold text-dark mb-0">Teto Percentual Liberável</h6>
                                                        </div>
                                                        <p class="fs-xs text-muted mb-2">Parâmetro de proteção que limita o repasse máximo a 90% (Global) ou 85%/80% (Específico) do total liquidado acumulado até o término do evento.</p>
                                                        <div class="p-2 bg-white rounded border fs-xs font-monospace text-success">
                                                            MaxLiberável = SaldoLiquidado * MaxReleasePercent
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 4: BLOQUEIOS & TRAVAS -->
                                        <div id="ft-rul-pane-blocks" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Matriz de Travas e Bloqueios Operacionais</h6>
                                                    <span class="fs-xs text-muted">Condições obrigatórias que forçam decisões <code>BLOCK</code> ou retenções temporárias <code>HOLD</code>.</span>
                                                </div>
                                            </div>
                                            <div class="row g-2" id="ft-rul-blocks-matrix-container">
                                                <!-- Renderizado dinamicamente -->
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 5: ALÇADAS DE APROVAÇÃO -->
                                        <div id="ft-rul-pane-limits" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Alçadas e Segregação de Funções (SoD)</h6>
                                                    <span class="fs-xs text-muted">Níveis hierárquicos de aprovação financeira para repasses, transferências e estornos.</span>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="card h-100 border p-3 shadow-none bg-light" style="border-top: 3px solid #10b981 !important;">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <h6 class="fw-bold text-success mb-1">Aprovação Automática</h6>
                                                            <span class="badge bg-success-subtle text-success fs-xs">Até R$ 10.000,00</span>
                                                        </div>
                                                        <p class="fs-xs text-muted mt-2 mb-0">Operações que respeitam todas as políticas, limites e reservas sem exigir intervenção manual. Status: <code>CONCLUIDA</code> imediato.</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card h-100 border p-3 shadow-none bg-light" style="border-top: 3px solid #f59e0b !important;">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <h6 class="fw-bold text-warning mb-1">Alçada Nível 1 — Controladoria</h6>
                                                            <span class="badge bg-warning-subtle text-dark fs-xs">R$ 10.000 a R$ 50.000</span>
                                                        </div>
                                                        <p class="fs-xs text-muted mt-2 mb-0">Requer validação formal de analista ou coordenador de controladoria financeira antes do envio ao gateway bancário.</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="card h-100 border p-3 shadow-none bg-light" style="border-top: 3px solid #7c3aed !important;">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <h6 class="fw-bold text-purple mb-1" style="color: #7c3aed;">Alçada Nível 2 — Diretoria</h6>
                                                            <span class="badge text-white fs-xs" style="background-color: #7c3aed;">Acima de R$ 50.000,00</span>
                                                        </div>
                                                        <p class="fs-xs text-muted mt-2 mb-0">Dupla aprovação mandatória com chancela do Diretor Financeiro ou CFO. Segregação rigorosa: solicitante não pode aprovar.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 6: EXCEÇÕES AUDITÁVEIS -->
                                        <div id="ft-rul-pane-exceptions" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Gestão de Exceções Operacionais Temporárias</h6>
                                                    <span class="fs-xs text-muted">Contorno excepcional de travas com justificativa formal, vigência pré-fixada e alçada de Diretoria.</span>
                                                </div>
                                                <button class="btn btn-sm btn-primary fw-bold d-flex align-items-center gap-1" onclick="window.openCreateExceptionModal()" style="font-size: 12px;">
                                                    <i class="ph-plus-circle"></i> Cadastrar Exceção
                                                </button>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th style="width: 15%;">Código / Data</th>
                                                            <th style="width: 12%;">Regra Contornada</th>
                                                            <th style="width: 12%;">Escopo</th>
                                                            <th style="width: 28%;">Justificativa Formal</th>
                                                            <th style="width: 15%;">Aprovador</th>
                                                            <th style="width: 10%;">Validade</th>
                                                            <th style="width: 8%;" class="text-center">Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="ft-rul-exceptions-tbody" class="fs-xs">
                                                        <!-- Renderizado dinamicamente -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 7: SIMULADOR DE REGRAS FINANCEIRAS -->
                                        <div id="ft-rul-pane-simulator" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                                        <i class="ph-chart-polar text-purple" style="color: #7c3aed;"></i> Simulador de Regras Financeiras em Tempo Real
                                                    </h6>
                                                    <span class="fs-xs text-muted">Teste antecipado de qualquer operação financeira sem gerar movimentação contábil ou financeira no sistema.</span>
                                                </div>
                                            </div>

                                            <div class="row g-3">
                                                <!-- Form de Simulação -->
                                                <div class="col-12 col-xl-5">
                                                    <div class="card border p-3 shadow-none bg-light h-100">
                                                        <h6 class="fw-bold text-dark mb-3 fs-xs text-uppercase">Parâmetros da Simulação</h6>
                                                        
                                                        <div class="mb-2">
                                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Tipo de Operação</label>
                                                            <select id="sim-rul-operation-type" class="form-select form-select-sm fw-bold">
                                                                <option value="PAYOUT">Repasse ao Produtor (PAYOUT)</option>
                                                                <option value="EVENT_TRANSFER" selected>Transferência entre Eventos (EVENT_TRANSFER)</option>
                                                                <option value="ADVANCE">Antecipação de Recebíveis (ADVANCE)</option>
                                                                <option value="EXPENSE">Pagamento de Despesa / Fornecedor (EXPENSE)</option>
                                                                <option value="REVERSAL">Estorno Operacional (REVERSAL)</option>
                                                                <option value="MANUAL_ADJUSTMENT">Ajuste Manual da Tesouraria (MANUAL_ADJUSTMENT)</option>
                                                            </select>
                                                        </div>

                                                        <div class="mb-2">
                                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Produtor</label>
                                                            <select id="sim-rul-producer-select" class="form-select form-select-sm" onchange="window.updateRulesSimEvents(this.value)">
                                                                <option value="prod-1">DiskIngressos Eventos Ltda</option>
                                                                <option value="prod-2">CWB Brasil Entretenimento</option>
                                                            </select>
                                                        </div>

                                                        <div class="mb-2">
                                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Evento de Origem</label>
                                                            <select id="sim-rul-event-select" class="form-select form-select-sm">
                                                                <!-- Preenchido via JS -->
                                                            </select>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Valor da Operação (R$)</label>
                                                            <div class="input-group input-group-sm">
                                                                <span class="input-group-text bg-white fw-bold">R$</span>
                                                                <input type="number" step="0.01" min="0.01" id="sim-rul-amount-input" class="form-control fw-bold" placeholder="0,00" value="1200.00">
                                                            </div>
                                                        </div>

                                                        <button class="btn btn-dark w-100 fw-bold d-flex align-items-center justify-content-center gap-1 py-2" onclick="window.runRulesSimulation()">
                                                            <i class="ph-play-circle fs-5"></i> Simular Operação
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Painel de Resultado da Simulação -->
                                                <div class="col-12 col-xl-7">
                                                    <div class="card border p-3 shadow-none h-100" id="sim-rul-result-card" style="background: #ffffff;">
                                                        <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-3">
                                                            <div>
                                                                <span class="fs-xs text-muted text-uppercase fw-bold">Resultado da Avaliação</span>
                                                                <div class="fs-4 fw-bold mt-1" id="sim-rul-res-decision-badge">Aguardando simulação...</div>
                                                            </div>
                                                            <span class="badge bg-light text-muted border fs-xs" id="sim-rul-res-corr-id">—</span>
                                                        </div>

                                                        <div class="row g-2 mb-3">
                                                            <div class="col-4">
                                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                                    <span class="fs-xs text-muted">Máximo Permitido</span>
                                                                    <div class="fw-bold text-success fs-6 mt-1" id="sim-rul-res-max-allowed">R$ 0,00</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-4">
                                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                                    <span class="fs-xs text-muted">Reserva Mínima</span>
                                                                    <div class="fw-bold text-primary fs-6 mt-1" id="sim-rul-res-reserve">R$ 0,00</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-4">
                                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                                    <span class="fs-xs text-muted">Alçada Exigida</span>
                                                                    <div class="fw-bold text-dark fs-6 mt-1" id="sim-rul-res-approval-level">Automática</div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Avisos e Motivos de Bloqueio -->
                                                        <div id="sim-rul-res-alerts-container" class="mb-3"></div>

                                                        <!-- Políticas Avaliadas -->
                                                        <div class="border rounded p-2 bg-light">
                                                            <span class="fs-xs text-muted fw-bold text-uppercase d-block mb-1">Políticas Financeiras Avaliadas:</span>
                                                            <ul id="sim-rul-res-policies-list" class="list-unstyled mb-0 fs-xs">
                                                                <li class="text-muted">Nenhuma simulação executada ainda.</li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 8: TRILHA DE AUDITORIA DE REGRAS -->
                                        <div id="ft-rul-pane-audit" class="rul-subpane" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">Log Imutável de Decisões do Motor de Regras</h6>
                                                    <span class="fs-xs text-muted">Trilha de auditoria append-only de todas as avaliações, simulações, políticas e exceções.</span>
                                                </div>
                                                <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1" onclick="window.refreshRulesData()">
                                                    <i class="ph-arrows-clockwise"></i> Atualizar
                                                </button>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th style="width: 15%;">Data / Hora</th>
                                                            <th style="width: 15%;">Ator / Perfil</th>
                                                            <th style="width: 12%;">Ação</th>
                                                            <th style="width: 10%;">Decisão</th>
                                                            <th style="width: 33%;">Detalhes</th>
                                                            <th style="width: 15%;">Correlation ID</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="ft-rul-audit-tbody" class="fs-xs">
                                                        <!-- Renderizado dinamicamente -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            
                            <!-- PANE 8: Agenda Financeira, Repasse Automático e Lotes de Repasse (Fase 26.17.9.5.7) -->
                            <div class="card-body p-3" id="ft-pane-schedule" style="display:none;">
                                <!-- Top Banner da Agenda Financeira -->
                                <div class="card shadow-sm border-0 mb-3" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-left: 5px solid #0284c7 !important;">
                                    <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="rounded-circle bg-white shadow-sm p-2 text-primary d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; color: #0284c7;">
                                                <i class="ph-calendar-check fs-4"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark fs-sm d-flex align-items-center gap-2">
                                                    Agenda Financeira, Repasse Automático &amp; Lotes de Repasse
                                                    <span class="badge text-white fs-xs" style="background-color: #0284c7;">Fase 26.17.9.5.7</span>
                                                    <span class="badge bg-light text-dark border fs-xs">Maker / Checker &bull; Idempotência</span>
                                                </div>
                                                <div class="text-secondary fs-xs mt-1">
                                                    Ciclo Completo: <strong>Agendamento</strong> &rarr; <strong>Reavaliação no Motor de Regras</strong> &rarr; <strong>Reserva</strong> &rarr; <strong>Aprovação em Lote</strong> &rarr; <strong>Envio Bancário</strong> &rarr; <strong>Retorno / Conciliação</strong> &rarr; <strong>Reprocessamento Seguro</strong>.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <button class="btn btn-sm btn-outline-primary fw-bold d-flex align-items-center gap-1" onclick="window.refreshScheduleData()" style="font-size: 12px;">
                                                <i class="ph-arrows-clockwise"></i> Atualizar
                                            </button>
                                            <button class="btn btn-sm btn-info text-white fw-bold d-flex align-items-center gap-1" onclick="window.openCreatePayoutBatchModal()" style="font-size: 12px; background-color: #0284c7; border-color: #0284c7;">
                                                <i class="ph-stack"></i> Criar Lote
                                            </button>
                                            <button class="btn btn-sm btn-success fw-bold d-flex align-items-center gap-1" onclick="window.openSchedulePayoutModal()" style="font-size: 12px; background-color: #00a65a; border-color: #008d4c;">
                                                <i class="ph-calendar-plus"></i> Novo Agendamento
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- 6 KPIs da Agenda & Lotes -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Total Agendado</span>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-sch-kpi-total-amount">R$ 0,00</div>
                                            <span class="fs-xs text-muted" id="ft-sch-kpi-total-count">0 agendamentos</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Vencimento Hoje</span>
                                            <div class="fs-5 fw-bold text-primary mt-1" id="ft-sch-kpi-today-amount">R$ 0,00</div>
                                            <span class="fs-xs text-muted" id="ft-sch-kpi-today-count">0 itens hoje</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Próximos 7 Dias</span>
                                            <div class="fs-5 fw-bold text-info mt-1" id="ft-sch-kpi-week-amount">R$ 0,00</div>
                                            <span class="fs-xs text-muted">Janela prioritária</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Lotes Pendentes</span>
                                            <div class="fs-5 fw-bold text-warning mt-1" id="ft-sch-kpi-batches-pending">0</div>
                                            <span class="fs-xs text-muted">Aguardando Aprovação</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Lotes Liquidados</span>
                                            <div class="fs-5 fw-bold text-success mt-1" id="ft-sch-kpi-batches-settled">0</div>
                                            <span class="fs-xs text-muted">Concluídos com retorno</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Falhas / Retry Seguro</span>
                                            <div class="fs-5 fw-bold text-danger mt-1" id="ft-sch-kpi-retryable">0</div>
                                            <span class="fs-xs text-muted">Rejeições técnicas</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sub-abas da Agenda Financeira -->
                                <div class="card border shadow-none mb-3">
                                    <div class="card-header bg-light border-bottom p-2">
                                        <ul class="nav nav-pills" id="ft-schedule-subtabs" style="gap: 6px;">
                                            <li class="nav-item">
                                                <button class="nav-link active py-1 px-3 fs-xs fw-bold" onclick="window.switchScheduleSubTab('calendar')" id="ft-sch-btn-subtab-calendar">
                                                    <i class="ph-calendar me-1"></i> Agenda de Repasses
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchScheduleSubTab('batches')" id="ft-sch-btn-subtab-batches">
                                                    <i class="ph-stack me-1"></i> Central de Lotes
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchScheduleSubTab('webhook')" id="ft-sch-btn-subtab-webhook">
                                                    <i class="ph-plugs me-1"></i> Retorno Bancário &amp; Webhook
                                                </button>
                                            </li>
                                            <li class="nav-item">
                                                <button class="nav-link py-1 px-3 fs-xs fw-bold" onclick="window.switchScheduleSubTab('audit')" id="ft-sch-btn-subtab-audit">
                                                    <i class="ph-shield-check me-1"></i> Trilha de Auditoria &amp; Idempotência
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="card-body p-3">
                                        <!-- SUB-PANE 1: Agenda de Repasses -->
                                        <div id="ft-sch-subpane-calendar">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <span class="fw-bold text-dark fs-sm">Repasses Agendados &bull; Visão Operacional</span>
                                                    <div class="text-muted fs-xs">Selecione itens para agrupar em um lote de repasse automático ou manual</div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-xs btn-outline-secondary" onclick="window.selectAllScheduleItems(true)">Marcar Todos</button>
                                                    <button class="btn btn-xs btn-outline-secondary" onclick="window.selectAllScheduleItems(false)">Desmarcar</button>
                                                    <button class="btn btn-xs btn-primary fw-bold" onclick="window.openBatchFromSelection()">
                                                        <i class="ph-stack-plus me-1"></i> Agrupar Selecionados em Lote
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th style="width: 40px;"><input type="checkbox" id="ft-sch-check-all" onchange="window.toggleSelectAllSchedule(this.checked)"></th>
                                                            <th>ID</th>
                                                            <th>Evento</th>
                                                            <th>Data Vencimento</th>
                                                            <th>Tipo</th>
                                                            <th>Prioridade</th>
                                                            <th>Valor (BRL)</th>
                                                            <th>Conta Beneficiária</th>
                                                            <th>Status</th>
                                                            <th class="text-end">Ações</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="ft-sch-tbody-calendar" class="fs-xs">
                                                        <!-- Renderizado dinamicamente -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 2: Central de Lotes -->
                                        <div id="ft-sch-subpane-batches" style="display:none;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <span class="fw-bold text-dark fs-sm">Lotes de Repasse Programados</span>
                                                    <div class="text-muted fs-xs">Ciclo de vida, validação do motor de regras, aprovação Maker/Checker e liquidação bancária</div>
                                                </div>
                                                <button class="btn btn-xs btn-info text-white fw-bold" onclick="window.openCreatePayoutBatchModal()" style="background-color: #0284c7;">
                                                    <i class="ph-plus-circle me-1"></i> Novo Lote
                                                </button>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th>ID Lote</th>
                                                            <th>Título</th>
                                                            <th>Data Programada</th>
                                                            <th>Itens</th>
                                                            <th>Valor Total</th>
                                                            <th>Valor Aprovado</th>
                                                            <th>Status</th>
                                                            <th>Criado por</th>
                                                            <th>Idempotency Key</th>
                                                            <th class="text-end">Ações</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="ft-sch-tbody-batches" class="fs-xs">
                                                        <!-- Renderizado dinamicamente -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 3: Retorno Bancário & Webhook Simulator -->
                                        <div id="ft-sch-subpane-webhook" style="display:none;">
                                            <div class="card border p-3 mb-3 bg-light">
                                                <h6 class="fw-bold text-dark mb-1"><i class="ph-plugs me-1 text-primary"></i> Simulador de Retorno Bancário / Webhook de Liquidação</h6>
                                                <div class="text-secondary fs-xs mb-3">
                                                    Simula a resposta do provedor bancário (Pix/CNAB) para conciliação contábil automática e baixa nas reservas de saldo.
                                                </div>
                                                <div class="row g-3">
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xs fw-bold">ID da Transação Bancária / Item</label>
                                                        <input type="text" class="form-control form-control-sm" id="ft-sch-sim-txid" placeholder="Ex: BK-TRX-882910 ou PIT-1001">
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xs fw-bold">Status Bancário de Retorno</label>
                                                        <select class="form-select form-select-sm" id="ft-sch-sim-status">
                                                            <option value="PAGO">PAGO (Liquidado com sucesso)</option>
                                                            <option value="REJEITADO">REJEITADO (Falha técnica / Retry)</option>
                                                            <option value="DEVOLVIDO">DEVOLVIDO (Estorno de Saldo)</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xs fw-bold">Código de Ocorrência / Erro</label>
                                                        <select class="form-select form-select-sm" id="ft-sch-sim-error">
                                                            <option value="">Nenhum (Sucesso)</option>
                                                            <option value="TIMEOUT">TIMEOUT (Falha Técnica - Elegível a Retry)</option>
                                                            <option value="COMMUNICATION_FAIL">COMMUNICATION_FAIL (Falha Técnica)</option>
                                                            <option value="ERR_ACCOUNT_INVALID">ERR_ACCOUNT_INVALID (Dados Inválidos - Sem Retry)</option>
                                                            <option value="ERR_COMPLIANCE">ERR_COMPLIANCE (Compliance - Sem Retry)</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3 d-flex align-items-end">
                                                        <button class="btn btn-sm btn-primary w-100 fw-bold" onclick="window.submitSimulatedBankWebhook()">
                                                            <i class="ph-paper-plane-tilt me-1"></i> Disparar Webhook
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- SUB-PANE 4: Trilha de Auditoria & Idempotência -->
                                        <div id="ft-sch-subpane-audit" style="display:none;">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th>Data / Hora</th>
                                                            <th>Ator</th>
                                                            <th>Tipo</th>
                                                            <th>Ação</th>
                                                            <th>Resumo</th>
                                                            <th>Correlation ID</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="ft-sch-tbody-audit" class="fs-xs">
                                                        <!-- Renderizado dinamicamente -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
</div>
                        </div>
                    </section>

                    <!-- MODAL: Cadastrar Exceção Temporária no Motor de Regras (Fase 26.17.9.5.6) -->
                    <div class="modal fade" id="modal-create-financial-exception" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-md modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded bg-purple text-white p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; background-color: #7c3aed;">
                                            <i class="ph-asterisk fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="modal-title fw-bold text-dark mb-0">Cadastrar Exceção Financeira</h6>
                                            <div class="text-muted fs-xs">Alçada de Controladoria &bull; Trilha Auditada</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <form id="form-create-financial-exception" onsubmit="window.handleCreateException(event)">
                                        <div class="mb-2">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Regra a Contornar</label>
                                            <select id="exc-input-rule" class="form-select form-select-sm fw-bold" required>
                                                <option value="DIVERGENCIA_CONTABIL">Divergência Contábil (DIVERGENCIA_CONTABIL)</option>
                                                <option value="RESERVA_MINIMA">Reserva Mínima Contratual (RESERVA_MINIMA)</option>
                                                <option value="JANELA_OPERACIONAL">Janela Operacional Bancária (JANELA_OPERACIONAL)</option>
                                                <option value="CONCILIACAO_PENDENTE">Aguardando Conciliação Diária (CONCILIACAO_PENDENTE)</option>
                                                <option value="CHARGEBACK_CRITICO">Volume de Chargeback em Disputa (CHARGEBACK_CRITICO)</option>
                                                <option value="COMPLIANCE_PENDENTE">Bloqueio de Compliance / Documentos (COMPLIANCE_PENDENTE)</option>
                                            </select>
                                        </div>

                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Escopo</label>
                                                <select id="exc-input-scope" class="form-select form-select-sm">
                                                    <option value="GLOBAL">Global</option>
                                                    <option value="PRODUCER">Produtor Ativo</option>
                                                    <option value="EVENT">Evento Específico</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Vigência Até</label>
                                                <input type="date" id="exc-input-valid-until" class="form-control form-control-sm" required>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Aprovador Responsável</label>
                                            <input type="text" id="exc-input-approved-by" class="form-control form-control-sm fw-bold" value="Controladoria Financeira" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Justificativa Formal Obrigatória</label>
                                            <textarea id="exc-input-justification" class="form-control form-control-sm" rows="3" placeholder="Detalhe a razão operacional e comercial da concessão da exceção..." required></textarea>
                                        </div>

                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-xs btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-xs btn-primary fw-bold" style="background-color: #7c3aed; border-color: #6d28d9;">Salvar Exceção</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: Timeline Gráfica da Transferência (Fase 26.17.9.5.3) -->
                    <div class="modal fade" id="modal-transfer-timeline" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-md modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div>
                                        <h5 class="modal-title fw-bold text-dark mb-0">Linha do Tempo da Operação</h5>
                                        <div class="text-muted fs-xs" id="m-tl-transfer-code">Código: TRF-XXXXXXXX</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-4" id="m-tl-content-body">
                                    <!-- Preenchido via JS -->
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: Ação de Decisão da Alçada (Aprovar/Rejeitar) (Fase 26.17.9.5.2) -->
                    <div class="modal fade" id="modal-transfer-approval-action" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-sm modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-2">
                                    <h6 class="modal-title fw-bold text-dark mb-0" id="m-act-title">Decisão de Alçada</h6>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <input type="hidden" id="m-act-transfer-id">
                                    <input type="hidden" id="m-act-type">
                                    <p class="fs-xs text-muted mb-2" id="m-act-desc">Deseja confirmar a ação?</p>
                                    <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Justificativa / Comentário</label>
                                    <textarea id="m-act-comment" class="form-control form-control-sm" rows="3" placeholder="Observações para registro em auditoria..."></textarea>
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-xs btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="button" class="btn btn-xs btn-primary fw-bold" id="m-act-confirm-btn" onclick="window.confirmApprovalAction()">Confirmar</button>
                                </div>
                            </div>
                        </div>
                    </div>

<!-- MODAL: Nova Transferência entre Eventos (Fases 26.17.9.5 & 26.17.9.5.1) -->
                    <div class="modal fade" id="modal-balance-transfer" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded bg-primary text-white p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                            <i class="ph-arrows-left-right fs-5"></i>
                                        </div>
                                        <div>
                                            <h5 class="modal-title fw-bold text-dark mb-0">Transferência entre Eventos</h5>
                                            <div class="text-muted fs-xs">Realocação interna de saldo disponível &bull; Mesmo Produtor</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <form id="form-balance-transfer" onsubmit="window.handleBalanceTransferSubmit(event)">
                                        <!-- Produtor -->
                                        <div class="mb-3">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase">Produtor Ativo</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i class="ph-buildings"></i></span>
                                                <input type="text" class="form-control bg-light fw-bold text-dark" id="trf-input-producer-name" readonly value="DiskIngressos Eventos Ltda">
                                            </div>
                                            <div class="form-text fs-xs text-muted">Apenas eventos deste produtor podem participar da transferência (RN01).</div>
                                        </div>

                                        <div class="row g-3">
                                            <!-- Evento de Origem -->
                                            <div class="col-md-6">
                                                <label for="trf-select-source" class="form-label fs-xs fw-bold text-muted text-uppercase">Evento de Origem (Cede Saldo)</label>
                                                <select id="trf-select-source" class="form-select fw-semibold border-secondary" required onchange="window.updateTransferPreview()">
                                                    <option value="">Selecione a origem...</option>
                                                </select>
                                                <div class="mt-2 p-2 bg-light rounded border fs-xs">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="text-muted">Saldo Contábil:</span>
                                                        <span class="fw-bold text-dark font-monospace" id="trf-source-settled-label">R$ 0,00</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="text-muted">Valores Comprometidos:</span>
                                                        <span class="fw-bold text-warning font-monospace" id="trf-source-committed-label">R$ 0,00</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center border-top pt-1">
                                                        <span class="text-dark fw-semibold">Saldo Disponível:</span>
                                                        <span class="fw-bold text-success font-monospace" id="trf-source-available-label">R$ 0,00</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Evento de Destino -->
                                            <div class="col-md-6">
                                                <label for="trf-select-target" class="form-label fs-xs fw-bold text-muted text-uppercase">Evento de Destino (Recebe Saldo)</label>
                                                <select id="trf-select-target" class="form-select fw-semibold border-secondary" required onchange="window.updateTransferPreview()">
                                                    <option value="">Selecione o destino...</option>
                                                </select>
                                                <div class="mt-2 p-2 bg-light rounded border fs-xs">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="text-muted">Saldo Contábil Atual:</span>
                                                        <span class="fw-bold text-dark font-monospace" id="trf-target-settled-label">R$ 0,00</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center border-top pt-1">
                                                        <span class="text-dark fw-semibold">Saldo Disponível Atual:</span>
                                                        <span class="fw-bold text-primary font-monospace" id="trf-target-available-label">R$ 0,00</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row g-3 mt-1">
                                            <!-- Valor a Transferir -->
                                            <div class="col-md-6">
                                                <label for="trf-input-amount" class="form-label fs-xs fw-bold text-muted text-uppercase">Valor a Transferir (R$)</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light fw-bold">R$</span>
                                                    <input type="number" step="0.01" min="0.01" class="form-control fw-bold text-dark" id="trf-input-amount" placeholder="0,00" required oninput="window.updateTransferPreview()">
                                                </div>
                                                <div class="mt-2 d-flex gap-1">
                                                    <button type="button" class="btn btn-xs btn-outline-secondary" onclick="window.setTransferPercentage(0.25)">25%</button>
                                                    <button type="button" class="btn btn-xs btn-outline-secondary" onclick="window.setTransferPercentage(0.50)">50%</button>
                                                    <button type="button" class="btn btn-xs btn-outline-secondary" onclick="window.setTransferPercentage(0.75)">75%</button>
                                                    <button type="button" class="btn btn-xs btn-outline-success" onclick="window.setTransferPercentage(1.00)">100% (Total)</button>
                                                </div>
                                            </div>

                                            <!-- Motivo -->
                                            <div class="col-md-6">
                                                <label for="trf-input-reason" class="form-label fs-xs fw-bold text-muted text-uppercase">Motivo da Transferência <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="trf-input-reason" placeholder="Ex.: Cobertura de despesas operacionais" required minlength="3" oninput="window.updateTransferPreview()">
                                                <div class="form-text fs-xs text-muted">Obrigatório para registro de conformidade e auditoria.</div>
                                            </div>
                                        </div>

                                        <!-- Campos Opcionais: Centro de Custo e Observações -->
                                        <div class="row g-3 mt-1">
                                            <div class="col-md-6">
                                                <label for="trf-input-cost-center" class="form-label fs-xs fw-bold text-muted text-uppercase">Centro de Custo (Opcional)</label>
                                                <input type="text" class="form-control" id="trf-input-cost-center" placeholder="Ex.: CC-OPERACIONAL-01">
                                            </div>
                                            <div class="col-md-6">
                                                <label for="trf-input-notes" class="form-label fs-xs fw-bold text-muted text-uppercase">Observações / Anotações Internas</label>
                                                <input type="text" class="form-control" id="trf-input-notes" placeholder="Informações adicionais para a controladoria">
                                            </div>
                                        </div>

                                        <!-- PRÉVIA OBRIGATÓRIA (Simulação Instantânea com Impacto) -->
                                        <div class="mt-4 p-3 rounded border bg-light" id="trf-preview-box">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-xs fw-bold text-uppercase text-dark d-flex align-items-center gap-1">
                                                    <i class="ph-chart-pie-slice text-primary"></i> Prévia de Impacto Obrigatória (RN03 & RN05)
                                                </span>
                                                <span id="trf-preview-badge" class="badge bg-secondary-subtle text-secondary border">Aguardando preenchimento</span>
                                            </div>
                                            
                                            <div class="row g-2 text-center" id="trf-preview-grid">
                                                <!-- Origem -->
                                                <div class="col-md-4">
                                                    <div class="p-2 bg-white rounded border">
                                                        <div class="fs-xs text-muted">Origem após transferência</div>
                                                        <div class="fw-bold text-dark fs-sm mt-1" id="trf-prev-source-val">R$ 0,00</div>
                                                        <div class="fs-xs text-danger" id="trf-prev-source-delta">(-) R$ 0,00</div>
                                                    </div>
                                                </div>
                                                <!-- Destino -->
                                                <div class="col-md-4">
                                                    <div class="p-2 bg-white rounded border">
                                                        <div class="fs-xs text-muted">Destino após transferência</div>
                                                        <div class="fw-bold text-dark fs-sm mt-1" id="trf-prev-target-val">R$ 0,00</div>
                                                        <div class="fs-xs text-success" id="trf-prev-target-delta">(+) R$ 0,00</div>
                                                    </div>
                                                </div>
                                                <!-- Consolidado Invariável -->
                                                <div class="col-md-4">
                                                    <div class="p-2 bg-white rounded border">
                                                        <div class="fs-xs text-muted">Saldo Consolidado Total</div>
                                                        <div class="fw-bold text-dark fs-sm mt-1" id="trf-prev-cons-val">R$ 0,00</div>
                                                        <div class="fs-xs text-success fw-semibold" id="trf-prev-cons-status">&Delta; R$ 0,00 (Invariável)</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div id="trf-preview-alert" class="alert alert-warning p-2 fs-xs mt-2 mb-0 d-none">
                                                <!-- Alerta de validação -->
                                            </div>
                                        </div>

                                        <div class="modal-footer px-0 pb-0 pt-3 border-top mt-3">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-success fw-bold d-flex align-items-center gap-1 shadow-sm" id="btn-submit-balance-transfer" disabled>
                                                <i class="ph-paper-plane-tilt"></i> Solicitar Transferência
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: Extrato de Movimentações do Evento -->
                    <div class="modal fade" id="modal-event-movements" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div>
                                        <h5 class="modal-title fw-bold text-dark mb-0" id="m-movements-event-title">Movimentações Financeiras do Evento</h5>
                                        <div class="text-muted fs-xs" id="m-movements-event-subtitle">Extrato cronológico que compõe o saldo do evento</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-0">
                                    <div class="table-responsive" style="max-height: 420px;">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light fs-xs text-uppercase text-muted sticky-top">
                                                <tr>
                                                    <th>Data</th>
                                                    <th>Tipo</th>
                                                    <th>Descrição</th>
                                                    <th class="text-end">Valor</th>
                                                    <th class="text-end pe-3">Saldo Resultante</th>
                                                </tr>
                                            </thead>
                                            <tbody id="m-movements-tbody" class="fs-xs">
                                                <!-- Preenchido via JS -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: Detalhes e Auditoria da Transferência -->
                    <div class="modal fade" id="modal-transfer-audit-detail" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-md modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div>
                                        <h5 class="modal-title fw-bold text-dark mb-0">Comprovante de Transferência</h5>
                                        <div class="text-muted fs-xs" id="m-audit-code-label">Código: TRF-XXXXXXXX</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-3 fs-sm" id="m-audit-content-body">
                                    <!-- Preenchido via JS -->
                                </div>
                                <div class="modal-footer bg-light border-top py-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
                                    <button type="button" class="btn btn-sm btn-primary" onclick="window.printTransferReceipt()"><i class="ph-printer me-1"></i> Imprimir</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: Simulador de Cobertura entre Eventos (Fase 26.17.9.5.5) -->
                    <div class="modal fade" id="modal-forecast-coverage-simulator" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-3">
                                    <div>
                                        <h5 class="modal-title fw-bold text-dark mb-0">Simulador de Cobertura Financeira entre Eventos</h5>
                                        <div class="text-muted fs-xs">Simulação preditiva sem impacto financeiro real imediato (RN07 &amp; RN08)</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="row g-3 mb-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase">Evento em Risco (Destino)</label>
                                            <select class="form-select form-select-sm" id="sim-select-target" onchange="window.updateCoverageSimulation()">
                                                <!-- Opções de eventos em déficit -->
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase">Evento Candidato à Cobertura (Origem)</label>
                                            <select class="form-select form-select-sm" id="sim-select-source" onchange="window.updateCoverageSimulation()">
                                                <!-- Opções de eventos candidatos com saldo real -->
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-0">Valor da Cobertura Simulada</label>
                                            <span class="fs-xs fw-bold text-primary" id="sim-amount-display">R$ 0,00</span>
                                        </div>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">R$</span>
                                            <input type="number" step="100" min="0" class="form-control" id="sim-input-amount" value="1000" oninput="window.updateCoverageSimulation()">
                                        </div>
                                    </div>
                                    <!-- Painel de Comparação Antes vs Depois -->
                                    <div class="card border bg-light p-3 mb-3">
                                        <h6 class="fw-bold fs-xs text-uppercase text-muted mb-3">Resultado da Simulação Comparativa</h6>
                                        <div class="row g-3 text-center">
                                            <div class="col-12 col-md-6 border-end">
                                                <div class="fw-bold fs-xs text-muted text-uppercase mb-2">Evento Origem (Candidato)</div>
                                                <div class="d-flex justify-content-around">
                                                    <div>
                                                        <span class="fs-xs text-muted">Menor Saldo Antes</span>
                                                        <div class="fw-bold fs-sm text-dark mt-1" id="sim-res-source-before">R$ 0,00</div>
                                                    </div>
                                                    <i class="ph-arrow-right text-muted align-self-center"></i>
                                                    <div>
                                                        <span class="fs-xs text-muted">Menor Saldo Depois</span>
                                                        <div class="fw-bold fs-sm text-primary mt-1" id="sim-res-source-after">R$ 0,00</div>
                                                    </div>
                                                </div>
