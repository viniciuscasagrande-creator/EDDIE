                                        <i class="ph-user"></i> Produtor
                                    </button>
                                    <button type="button" class="btn btn-xs btn-success active fw-semibold" id="btn-profile-financeiro" onclick="window.switchApprovalRole('FINANCEIRO')">
                                        <i class="ph-bank"></i> Financeiro
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-dark fw-semibold" id="btn-profile-admin" onclick="window.switchApprovalRole('ADMINISTRADOR')">
                                        <i class="ph-shield-check"></i> Master
                                    </button>
                                </div>
                                <span class="badge bg-light text-dark border fs-xxs py-1 px-2 fw-semibold" id="approval-current-role-badge">
                                    Mariana Controladoria
                                </span>
                                <button type="button" class="btn btn-xs btn-light border shadow-sm text-secondary" title="Recarregar solicitações" onclick="window.refreshApprovalsDashboard()">
                                    <i class="ph-arrows-clockwise"></i>
                                </button>
                            </div>
                        </div>

                        <!-- 5 Cards de Indicadores Superiores (KPIs) -->
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6 col-xl">
                                <div class="card card-body shadow-sm border-0 border-start border-primary border-4 p-2 h-100">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fs-xxs text-uppercase fw-bold text-muted d-block">Aguardando Aprovação</span>
                                            <h4 class="fw-bold mb-0 text-primary mt-1" id="kpi-appr-pending-count">17</h4>
                                        </div>
                                        <div class="p-2 bg-primary-subtle text-primary rounded-circle">
                                            <i class="ph-hourglass fs-3"></i>
                                        </div>
                                    </div>
                                    <div class="fs-xxs text-muted mt-2">
                                        <i class="ph-info"></i> Fila ativa para análise
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl">
                                <div class="card card-body shadow-sm border-0 border-start border-success border-4 p-2 h-100">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fs-xxs text-uppercase fw-bold text-muted d-block">Valor Aguardando</span>
                                            <h4 class="fw-bold mb-0 text-success mt-1" id="kpi-appr-pending-amount">R$ 284.500,00</h4>
                                        </div>
                                        <div class="p-2 bg-success-subtle text-success rounded-circle">
                                            <i class="ph-currency-dollar-simple fs-3"></i>
                                        </div>
                                    </div>
                                    <div class="fs-xxs text-muted mt-2">
                                        <i class="ph-lock-key"></i> Saldo comprometido retido
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl">
                                <div class="card card-body shadow-sm border-0 border-start border-danger border-4 p-2 h-100">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fs-xxs text-uppercase fw-bold text-muted d-block">Urgentes / Críticas</span>
                                            <h4 class="fw-bold mb-0 text-danger mt-1" id="kpi-appr-urgent-count">4</h4>
                                        </div>
                                        <div class="p-2 bg-danger-subtle text-danger rounded-circle">
                                            <i class="ph-warning-octagon fs-3"></i>
                                        </div>
                                    </div>
                                    <div class="fs-xxs text-muted mt-2">
                                        <i class="ph-lightning"></i> Prioridade alta de análise
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl">
                                <div class="card card-body shadow-sm border-0 border-start border-warning border-4 p-2 h-100">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fs-xxs text-uppercase fw-bold text-muted d-block">Vencendo SLA</span>
                                            <h4 class="fw-bold mb-0 text-warning mt-1" id="kpi-appr-sla-expiring">3</h4>
                                        </div>
                                        <div class="p-2 bg-warning-subtle text-warning rounded-circle">
                                            <i class="ph-clock-countdown fs-3"></i>
                                        </div>
                                    </div>
                                    <div class="fs-xxs text-muted mt-2">
                                        <i class="ph-alarm"></i> Menos de 2h para limite
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-xl">
                                <div class="card card-body shadow-sm border-0 border-start border-info border-4 p-2 h-100">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fs-xxs text-uppercase fw-bold text-muted d-block">Aprovadas Hoje</span>
                                            <h4 class="fw-bold mb-0 text-info mt-1" id="kpi-appr-approved-today">21</h4>
                                        </div>
                                        <div class="p-2 bg-info-subtle text-info rounded-circle">
                                            <i class="ph-check-circle fs-3"></i>
                                        </div>
                                    </div>
                                    <div class="fs-xxs text-muted mt-2">
                                        <i class="ph-trend-up"></i> Liquidações autorizadas
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card de Tabela Operacional com Abas e Filtros -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2 px-3">
                                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-2">
                                    <!-- Abas de Navegação -->
                                    <div class="btn-group btn-group-sm flex-wrap" role="group" id="approval-status-tabs">
                                        <button type="button" class="btn btn-light text-dark fw-semibold tab-approval-link" id="tab-appr-todas" onclick="window.switchApprovalTab('todas')">Todas</button>
                                        <button type="button" class="btn btn-primary text-white fw-bold active tab-approval-link" id="tab-appr-pendentes" onclick="window.switchApprovalTab('pendentes')">Novas</button>
                                        <button type="button" class="btn btn-light text-dark fw-semibold tab-approval-link" id="tab-appr-em_analise" onclick="window.switchApprovalTab('em_analise')">Em Análise</button>
                                        <button type="button" class="btn btn-light text-dark fw-semibold tab-approval-link" id="tab-appr-devolvidas" onclick="window.switchApprovalTab('devolvidas')">Aguardando Correção</button>
                                        <button type="button" class="btn btn-light text-dark fw-semibold tab-approval-link" id="tab-appr-aprovadas" onclick="window.switchApprovalTab('aprovadas')">Aprovadas</button>
                                        <button type="button" class="btn btn-light text-dark fw-semibold tab-approval-link" id="tab-appr-rejeitadas" onclick="window.switchApprovalTab('rejeitadas')">Reprovadas</button>
                                        <button type="button" class="btn btn-light text-dark fw-semibold tab-approval-link" id="tab-appr-concluidas" onclick="window.switchApprovalTab('concluidas')">Concluídas</button>
                                    </div>

                                    <!-- Filtros e Busca Rápida -->
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <div class="input-group input-group-sm" style="width: 220px;">
                                            <span class="input-group-text bg-light border-end-0"><i class="ph-magnifying-glass"></i></span>
                                            <input type="text" class="form-control border-start-0" id="input-filter-approval-search" placeholder="Buscar ID, produtor, evento..." oninput="window.filterApprovalTable()">
                                        </div>
                                        <select class="form-select form-select-sm" id="select-filter-approval-category-group" style="width: 175px;" onchange="window.switchApprovalCategoryGroup(this.value)">
                                            <option value="TODAS">Todos Agrupamentos</option>
                                            <option value="MOVIMENTACAO">Movimentações</option>
                                            <option value="CREDITO_RECEBIVEIS">Crédito &amp; Recebíveis</option>
                                            <option value="CADASTRO_FINANCEIRO">Cadastro Financeiro</option>
                                            <option value="SAIDAS">Saídas (Pag/Estorno)</option>
                                        </select>
                                        <select class="form-select form-select-sm" id="select-filter-approval-queue" style="width: 140px;" onchange="window.switchApprovalQueue(this.value)">
                                            <option value="todas">Todas as Filas</option>
                                            <option value="minha-fila">Minha Fila</option>
                                            <option value="nao-atribuidas">Não Atribuídas</option>
                                        </select>
                                        <select class="form-select form-select-sm" id="select-filter-approval-type" style="width: 170px;" onchange="window.filterApprovalTable()">
                                            <option value="TODOS">Todos os Tipos</option>
                                            <option value="REPASSE">Repasse Financeiro</option>
                                            <option value="ANTECIPACAO">Antecipação Recebíveis</option>
                                            <option value="TRANSFERENCIA_EVENTOS">Transf. entre Eventos</option>
                                            <option value="PAGAMENTO">Pagamento Fornecedor</option>
                                            <option value="PAGAMENTO_LOTE">Pagamento em Lote</option>
                                            <option value="PIX">Transferência PIX</option>
                                            <option value="ALTERACAO_DADOS_BANCARIOS">Alteração Bancária</option>
                                            <option value="ESTORNO">Estorno Financeiro</option>
                                            <option value="COMPRA">Compra / Contratação</option>
                                            <option value="CONTRATO">Contrato de Serviço</option>
                                            <option value="ALTERACAO_TAXA">Alteração de Taxa</option>
                                            <option value="ALTERACAO_REGRA_REPASSE">Regra de Repasse</option>
                                            <option value="DESPESA_EXTRAORDINARIA">Despesa Extraordinária</option>
                                        </select>
                                        <select class="form-select form-select-sm" id="select-filter-approval-risk" style="width: 130px;" onchange="window.filterApprovalTable()">
                                            <option value="TODOS">Todos Riscos</option>
                                            <option value="BAIXO">Baixo Risco</option>
                                            <option value="MEDIO">Médio Risco</option>
                                            <option value="ALTO">Alto Risco</option>
                                            <option value="CRITICO">Crítico</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 fs-xs">
                                    <thead class="table-light text-uppercase fs-xxs text-muted fw-bold">
                                        <tr>
                                            <th style="width: 130px;">Solicitação</th>
                                            <th style="width: 180px;">Tipo de Operação</th>
                                            <th>Produtor &bull; Evento</th>
