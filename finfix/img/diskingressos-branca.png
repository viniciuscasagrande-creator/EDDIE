                    <!-- SUBTAB 2.1: Todos Eventos -->
                    <section id="view-events-list" class="page-section"  style="display:none;">
                        <!-- Action row toolbar -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <!-- Left: Page Title -->
                            <h5 class="fw-bold mb-0">Eventos</h5>
                            
                            <!-- Right: Toolbar Controls -->
                            <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-md-auto">
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="alert('Comparativo de vendas iniciado...')" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-arrows-left-right"></i> Comparar
                                </button>
                                
                                <div class="btn-group">
                                    <button class="btn btn-outline-primary fw-bold active toggle-btn" data-filter="ativos" id="events-tab-ativos" style="height: 36px; border-radius: 6px 0 0 6px; font-size: 13px;"><i class="ph-check-circle me-1"></i> Ativos</button>
                                    <button class="btn btn-outline-light text-dark fw-bold border toggle-btn" data-filter="inativos" id="events-tab-inativos" style="height: 36px; font-size: 13px;"><i class="ph-minus-circle me-1"></i> Inativos</button>
                                    <button class="btn btn-outline-light text-dark fw-bold border toggle-btn" data-filter="todos" id="events-tab-todos" style="height: 36px; border-radius: 0 6px 6px 0; font-size: 13px;"><i class="ph-list me-1"></i> Todos</button>
                                </div>

