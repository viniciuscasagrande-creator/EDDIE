                    <!-- VIEW: Financeiro - Métodos de Pagamento -->
                    <section id="view-financial-paymethods" class="page-section"  style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-row justify-content-between align-items-center py-2 mb-3" style="border-radius: 6px;">
                            <h5 class="fw-bold mb-0 text-dark"><i class="ph-credit-card me-1 text-primary"></i> Métodos de Pagamento</h5>
                            <span class="fs-xs text-muted fw-semibold">Configurações de Gateway</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-7">
                                <div class="card shadow-sm p-3 border-0" style="border-radius: 8px;">
                                    <h6 class="fw-bold text-dark mb-3"><i class="ph-sliders text-success me-1"></i> Tarifas e Prazos por Método</h6>
                                    <form id="paymethods-form" onsubmit="window.savePaymentMethods(event)">
                                        <div class="mb-3 border-bottom pb-3">
                                            <div class="row align-items-center">
                                                <div class="col-md-4"><span class="fw-bold text-dark"><i class="ph-qr-code me-1 text-success"></i> PIX</span></div>
                                                <div class="col-md-4">
                                                    <label class="fs-xxs text-muted d-block mb-1">MDR (%)</label>
                                                    <input type="number" class="form-control form-control-sm" id="pm-pix-mdr" value="0.95" step="0.01">
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="fs-xxs text-muted d-block mb-1">Prazo de Repasse</label>
                                                    <select class="form-select form-select-sm" id="pm-pix-days">
                                                        <option value="0" selected>Imediato (D+0)</option>
                                                        <option value="1">D+1</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3 border-bottom pb-3">
                                            <div class="row align-items-center">
                                                <div class="col-md-4"><span class="fw-bold text-dark"><i class="ph-credit-card me-1 text-primary"></i> Cartão de Crédito (1x)</span></div>
                                                <div class="col-md-4">
                                                    <label class="fs-xxs text-muted d-block mb-1">MDR (%)</label>
                                                    <input type="number" class="form-control form-control-sm" id="pm-cc-mdr" value="2.35" step="0.01">
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="fs-xxs text-muted d-block mb-1">Prazo de Repasse</label>
                                                    <select class="form-select form-select-sm" id="pm-cc-days">
                                                        <option value="1">D+1</option>
                                                        <option value="30" selected>D+30 (ou Antecipado)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3 border-bottom pb-3">
                                            <div class="row align-items-center">
                                                <div class="col-md-4"><span class="fw-bold text-dark"><i class="ph-barcode me-1 text-danger"></i> Boleto Bancário</span></div>
                                                <div class="col-md-4">
                                                    <label class="fs-xxs text-muted d-block mb-1">Tarifa Fixa (R$)</label>
                                                    <input type="number" class="form-control form-control-sm" id="pm-boleto-fee" value="1.50" step="0.10">
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="fs-xxs text-muted d-block mb-1">Prazo de Repasse</label>
                                                    <select class="form-select form-select-sm" id="pm-boleto-days">
                                                        <option value="1">D+1</option>
                                                        <option value="2" selected>D+2 útil</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-end mt-4">
                                            <button class="btn btn-success btn-sm text-white fw-bold" type="submit"><i class="ph-floppy-disk me-1"></i> Salvar Tarifas</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="card shadow-sm p-3 border-0" style="border-radius: 8px;">
                                    <h6 class="fw-bold text-dark mb-3"><i class="ph-chart-pie-slice text-primary me-1"></i> Share de Vendas (Volume)</h6>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1"><span class="fs-xs text-muted">PIX</span><span class="fs-xs fw-bold">45%</span></div>
                                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-success" style="width: 45%;"></div></div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1"><span class="fs-xs text-muted">Cartão de Crédito</span><span class="fs-xs fw-bold">40%</span></div>
                                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-primary" style="width: 40%;"></div></div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1"><span class="fs-xs text-muted">Boleto Bancário</span><span class="fs-xs fw-bold">12%</span></div>
                                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-danger" style="width: 12%;"></div></div>
                                    </div>
                                    <div>
                                        <div class="d-flex justify-content-between mb-1"><span class="fs-xs text-muted">Cartão de Débito</span><span class="fs-xs fw-bold">3%</span></div>
                                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-warning" style="width: 3%;"></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- VIEW: Financeiro - Pagamentos Customizados -->
                    <section id="view-financial-custompay" class="page-section"  style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-row justify-content-between align-items-center py-2 mb-3" style="border-radius: 6px;">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0 text-dark"><i class="ph-gear me-1 text-primary"></i> Pagamentos Customizados</h5>
                                <span class="badge bg-purple bg-opacity-10 text-purple fw-bold">Parcerias &amp; Cortesia</span>
                            </div>
                            <button class="btn btn-sm btn-orange text-white fw-bold" onclick="window.addNewCustomPay()"><i class="ph-plus me-1"></i> Nova Regra Customizada</button>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <div class="card shadow-sm border p-0" style="border-radius: 8px;">
                                    <div class="card-header bg-transparent border-bottom py-2 px-3">
                                        <h6 class="fw-bold text-dark mb-0"><i class="ph-list text-primary me-1"></i> Regras de Cobrança e Gateway Especiais</h6>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 text-start" style="font-size: 13px;">
