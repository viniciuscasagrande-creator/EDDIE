                                    <i class="ph-file-csv"></i> Exportar CSV
                                </button>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="toggleFinancialShowClosed()" id="btn-financial-closed-7" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-eye"></i> Ver encerrados
                                </button>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="openModal('cash-flow')" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-chart-line-up"></i> Fluxo de Caixa
                                </button>
                                <button class="btn btn-success fw-bold d-flex align-items-center gap-1" id="financial-new-repasse-btn-7" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px; background-color: #00a65a; border-color: #008d4c;">
