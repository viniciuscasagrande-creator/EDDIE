                    <!-- 1. Visão Geral Operacional (marketing-overview) -->
                    <section id="view-marketing-overview" class="page-section"  style="display:none;">
                        
                        <!-- 1. Header do Marketing Operacional -->
                        <div class="card card-body shadow-sm mb-3" style="border-radius: 8px; background: #ffffff; border-left: 5px solid #0ea5e9;">
                            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="ph-chart-pie-slice fs-2"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h4 class="fw-bold mb-0 text-dark">Marketing</h4>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 fs-xxs">Operação em Tempo Real</span>
                                        </div>
                                        <p class="text-muted fs-xs mb-0">Acompanhe campanhas, canais e conversões em tempo real.</p>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <!-- Period Filters -->
                                    <div class="btn-group btn-group-sm" role="group" id="mkt-period-btn-group">
                                        <button type="button" class="btn btn-outline-secondary" onclick="setMarketingPeriod('today')">Hoje</button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="setMarketingPeriod('7d')">7 dias</button>
                                        <button type="button" class="btn btn-primary fw-bold active" onclick="setMarketingPeriod('30d')">30 dias</button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="setMarketingPeriod('90d')">90 dias</button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="setMarketingPeriod('custom')">Personalizado</button>
                                    </div>
                                    <!-- Action Buttons -->
                                    <button class="btn btn-primary btn-sm fw-bold d-flex align-items-center gap-1.5 shadow-sm" onclick="navigateTo('marketing-campaign-create')">
                                        <i class="ph-plus fw-bold"></i> Nova Campanha
                                    </button>
                                    <button class="btn btn-outline-primary btn-sm fw-bold d-flex align-items-center gap-1" onclick="navigateTo('marketing-audiences')">
                                        <i class="ph-users"></i> Criar Público
                                    </button>
                                    <button class="btn btn-light border btn-sm fw-bold d-flex align-items-center gap-1" onclick="navigateTo('marketing-reports')">
                                        <i class="ph-chart-bar"></i> Relatórios
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Barra de Ações Rápidas (Quick Actions) -->
                        <div class="card card-body py-2 px-3 shadow-sm mb-3 bg-light border" style="border-radius: 8px;">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <span class="fs-xs fw-bold text-dark text-uppercase d-flex align-items-center gap-1">
                                    <i class="ph-lightning text-warning fs-5"></i> Ações Rápidas:
                                </span>
                                <div class="d-flex flex-wrap gap-1.5">
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-campaign-create')"><i class="ph-plus text-primary me-1"></i> Nova Campanha</button>
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-whatsapp')"><i class="ph-whatsapp-logo text-success me-1"></i> Enviar WhatsApp</button>
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-email')"><i class="ph-envelope-simple text-info me-1"></i> Criar E-mail</button>
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-coupons')"><i class="ph-ticket text-warning me-1"></i> Criar Cupom</button>
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-abandoned-cart')"><i class="ph-shopping-cart-simple text-danger me-1"></i> Recuperar Carrinhos</button>
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-audiences')"><i class="ph-users text-purple me-1"></i> Criar Público</button>
                                    <button class="btn btn-xs btn-white border shadow-2xs fw-semibold" onclick="navigateTo('marketing-utm')"><i class="ph-link text-success me-1"></i> Gerar UTM</button>
                                    <button class="btn btn-xs btn-outline-secondary" onclick="refreshMarketingDashboard()" title="Atualizar dados"><i class="ph-arrows-clockwise"></i></button>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Filtros Globais Integrados -->
                        <div class="card card-body shadow-sm py-2.5 px-3 mb-3" style="border-radius: 8px;">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label mb-0 fs-xxs text-muted text-uppercase fw-bold">Evento:</label>
                                    <select class="form-select form-select-sm" id="mkt-filter-event" onchange="setMarketingFilter('eventId', this.value)">
                                        <option value="all">Todos os Eventos</option>
                                        <option value="1">Festival Summer 2026</option>
                                        <option value="2">Show de Rock Curitiba</option>
                                        <option value="3">Stand-up Comedy Especial</option>
                                        <option value="4">Teatro Guaíra - Orquestra</option>
                                    </select>
