                                        <option value="prod-2">CWB Brasil Entretenimento</option>
                                    </select>
                                </div>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="window.initProcureToPayView()" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-arrows-clockwise"></i> Atualizar
                                </button>
                                <button class="btn btn-outline-primary fw-bold d-flex align-items-center gap-1" onclick="window.switchP2PTab('contracts'); window.openNewContractModal();" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-scroll"></i> Novo Contrato
                                </button>
                                <button class="btn btn-success fw-bold d-flex align-items-center gap-1" onclick="window.switchP2PTab('purchases'); window.openNewPurchaseRequestModal ? window.openNewPurchaseRequestModal() : alert('Abra a aba de solicitações');" style="height: 36px; padding: 6px 14px; border-radius: 6px; font-size: 13px; background-color: #00a65a; border-color: #008d4c;">
                                    <i class="ph-plus-circle"></i> Nova Solicitação
                                </button>
                            </div>
                        </div>

                        <!-- Banner de Governança e Regra Maker/Checker (Fase 26.17.9.4.5) -->
                        <div class="card shadow-sm mb-3 border-0" style="background: linear-gradient(135deg, #f8fafc 0%, #eef2f6 100%); border-left: 5px solid #0f172a !important;">
                            <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle bg-white shadow-sm p-2 text-dark d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                        <i class="ph-shield-check fs-4 text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-sm d-flex align-items-center gap-2">
                                            Governança Corporativa de Compras &bull; SafeSaff Procure-to-Pay
                                            <span class="badge bg-primary text-white fs-xs">Enterprise Flow</span>
                                        </div>
                                        <div class="text-secondary fs-xs mt-1">
                                            Segregação estrita de funções: <strong>Maker / Checker ativo</strong> (solicitante não aprova a própria compra).
                                            Comprometimento orçamentário registrado antes do faturamento e validação tríplice <strong>3-Way Match (Pedido × Medição × NF)</strong> obrigatória antes da liberação do Contas a Pagar.
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-white text-success border px-3 py-2 fs-xs fw-bold shadow-sm">
                                        <i class="ph-check-circle me-1"></i> Controle Orçamentário Ativo
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Pills de Navegação Procure-to-Pay -->
                        <div class="card shadow-sm border-0 mb-3">
