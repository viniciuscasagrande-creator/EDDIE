                                                            <option value="CREDITO_1X">Crédito à Vista (1x)</option>
                                                            <option value="CREDITO_2X">Crédito 2x</option>
                                                            <option value="CREDITO_3X" selected>Crédito 3x</option>
                                                            <option value="DEBITO">Débito</option>
                                                            <option value="PIX">PIX Instantâneo</option>
                                                        </select>
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-primary w-100 mb-3" id="btn-gw-simulate-pricing">
                                                        <i class="ph-calculator me-1"></i> Calcular Decomposição
                                                    </button>
                                                    <div id="sim-gw-result-box" class="p-2 border bg-white rounded">
                                                        <!-- Renderizado via controller -->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- TAB 5: LIQUIDAÇÕES & PREVISTO X REAL (IMPLANTAÇÃO 5.4.14 E 5.4.15) -->
                                    <div class="tab-pane fade" id="pane-gw-liquidacoes" role="tabpanel">
                                        <!-- 4 KPIs de Liquidação -->
                                        <div class="row g-2 mb-3">
                                            <div class="col-6 col-lg-3">
                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Volume Processado</span>
                                                    <h6 class="fw-bold text-dark mb-0 mt-1" id="gw-liq-kpi-total-gross">R$ 0,00</h6>
                                                    <span class="fs-xxs text-muted">Total bruto registrado</span>
                                                </div>
                                            </div>
                                            <div class="col-6 col-lg-3">
                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">MDR Previsto × Real</span>
                                                    <h6 class="fw-bold text-primary mb-0 mt-1" id="gw-liq-kpi-mdr-compare">R$ 0,00 / R$ 0,00</h6>
                                                    <span class="fs-xxs text-muted">Contratado vs Retido</span>
                                                </div>
                                            </div>
                                            <div class="col-6 col-lg-3">
                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Divergências Identificadas</span>
                                                    <h6 class="fw-bold text-danger mb-0 mt-1" id="gw-liq-kpi-divergence">R$ 0,00</h6>
                                                    <span class="fs-xxs text-muted">Diferença apurada a conciliar</span>
                                                </div>
                                            </div>
                                            <div class="col-6 col-lg-3">
                                                <div class="card border p-2 bg-light shadow-none mb-0">
                                                    <span class="fs-xxs text-uppercase text-muted fw-bold d-block">Taxa de Conciliação</span>
                                                    <h6 class="fw-bold text-success mb-0 mt-1" id="gw-liq-kpi-rate">100%</h6>
                                                    <span class="fs-xxs text-muted">Automação de conferência</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Barra de Filtros de Liquidação -->
                                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2 bg-light p-2 rounded">
                                            <div class="d-flex gap-2">
                                                <select class="form-select form-select-sm" id="gw-filter-liq-acquirer" style="max-width: 180px;">
                                                    <option value="TODOS">Todas as Adquirentes</option>
                                                    <option value="Cielo">Cielo</option>
                                                    <option value="Rede">Rede</option>
                                                    <option value="Stone">Stone</option>
                                                    <option value="PagBank">PagBank</option>
                                                </select>
                                                <select class="form-select form-select-sm" id="gw-filter-liq-status" style="max-width: 220px;">
                                                    <option value="TODOS">Todos os Status</option>
                                                    <option value="CONCILIADO">Conciliado</option>
                                                    <option value="DIVERGENCIA_MDR">Divergência de MDR</option>
                                                    <option value="DIVERGENCIA_TARIFA">Divergência de Tarifa</option>
                                                    <option value="LIQUIDACAO_NAO_LOCALIZADA">Liquidação Não Localizada</option>
                                                    <option value="CHARGEBACK">Chargeback</option>
                                                </select>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fs-xxs text-muted d-none d-md-inline">Conferência automática: Contrato × Transação × Ledger × Adquirente × Banco.</span>
                                                <button type="button" class="btn btn-xs btn-outline-primary d-flex align-items-center gap-1" onclick="window.gatewayFeeMatrixController.renderTabLiquidacoes()">
                                                    <i class="ph-arrows-clockwise"></i> <span>Reconciliar</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Tabela Analítica de Liquidações -->
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0">
                                                <thead class="table-light fs-xs text-uppercase text-muted">
                                                    <tr>
                                                        <th>Transação / Pedido</th>
                                                        <th>Adquirente &amp; Bandeira</th>
                                                        <th>Modalidade</th>
                                                        <th>Data Venda</th>
                                                        <th>Liq. Real</th>
                                                        <th class="text-end">Valor Bruto</th>
                                                        <th class="text-end">MDR Previsto</th>
                                                        <th class="text-end">MDR Real</th>
                                                        <th class="text-end">Divergência</th>
                                                        <th>Status Conciliação</th>
                                                        <th class="text-center">Ações</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="gw-liquidacoes-tbody" class="fs-xs">
                                                    <!-- Renderizado via controller -->
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- TAB 6: HISTÓRICO & AUDITORIA -->
                                    <div class="tab-pane fade" id="pane-gw-historico" role="tabpanel">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0">
                                                <thead class="table-light fs-xs text-uppercase text-muted">
                                                    <tr>
                                                        <th>Versão</th>
                                                        <th>Adquirente / Regra</th>
                                                        <th>Período de Vigência</th>
                                                        <th class="text-end">Custo Disk</th>
                                                        <th class="text-end">Taxa Comercial</th>
                                                        <th>Cobrado de</th>
                                                        <th>Responsável</th>
                                                        <th>Motivo da Alteração</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="gw-historico-tbody" class="fs-xs">
                                                    <!-- Renderizado via controller -->
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="mt-4 pt-3 border-top">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <h6 class="fw-bold text-dark fs-xs text-uppercase mb-0">
                                                    <i class="ph-shield-check me-1 text-primary"></i> Trilha Imutável de Auditoria (Event Log)
                                                </h6>
                                                <span class="fs-xxs text-muted">Registro contábil e de segurança de ações financeiras</span>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
                                                        <tr>
                                                            <th>ID Evento</th>
                                                            <th>Timestamp</th>
                                                            <th>Tipo de Ação</th>
                                                            <th>Detalhamento</th>
                                                            <th>Ator Responsável</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="gw-audit-tbody" class="fs-xs font-monospace">
                                                        <!-- Renderizado via controller -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- MODAL: NOVA VIGÊNCIA DE TAXA (IMPLANTAÇÃO 5.4) -->
                    <div class="modal fade" id="modal-gw-new-vigency" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-2">
                                    <div>
                                        <h6 class="modal-title fw-bold text-dark mb-0"><i class="ph-calendar-plus me-1 text-primary"></i> Cadastrar Nova Vigência</h6>
                                        <div class="text-muted fs-xs" id="modal-vigency-title">Regra Selecionada</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <input type="hidden" id="modal-vigency-rule-id">
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Custo Disk (MDR %)</label>
                                            <input class="form-control form-control-sm font-monospace" id="modal-vigency-cost" type="number" step="0.01">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Taxa Comercial (%)</label>
                                            <input class="form-control form-control-sm font-monospace" id="modal-vigency-commercial" type="number" step="0.01">
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Quem Suporta a Taxa</label>
                                        <select class="form-select form-select-sm" id="modal-vigency-bearer">
                                            <option value="PRODUTOR">Produtor (Deduz do evento)</option>
                                            <option value="CLIENTE_FINAL">Cliente Final (Cobrado no checkout)</option>
                                            <option value="DISK">Disk (Absorvido)</option>
                                            <option value="DIVIDIDO">Dividido (50% Produtor / 50% Cliente)</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Início da Nova Vigência</label>
                                        <input class="form-control form-control-sm" id="modal-vigency-from" type="date">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Justificativa / Motivo</label>
                                        <textarea class="form-control form-control-sm" id="modal-vigency-reason" rows="2" placeholder="Ex: Reajuste contratual adquirente..."></textarea>
                                    </div>
                                    <div class="alert alert-info py-2 mb-0 fs-xxs">
                                        <i class="ph-info me-1"></i> Esta alteração cria uma nova vigência a partir da data estipulada e preserva integralmente as taxas passadas no histórico para auditoria.
                                    </div>
                                </div>
                                <div class="modal-footer py-2 bg-light">
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button class="btn btn-sm btn-primary fw-bold" id="btn-gw-save-vigency">Salvar Nova Vigência</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: NOVA ADQUIRENTE / OPERADORA (IMPLANTAÇÃO 5.4) -->
                    <div class="modal fade" id="modal-gw-new-acquirer" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-2">
                                    <div>
                                        <h6 class="modal-title fw-bold text-dark mb-0"><i class="ph-buildings me-1 text-primary"></i> Cadastrar Nova Operadora / Adquirente</h6>
                                        <div class="text-muted fs-xs">Adicionar adquirente, gateway ou intermediador de pagamento</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Nome da Adquirente / Gateway *</label>
                                        <input class="form-control form-control-sm" id="modal-acquirer-name" type="text" placeholder="Ex: SafraPay, Adyen, Getnet, Mercado Pago">
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Prazo de Liquidação</label>
                                            <input class="form-control form-control-sm" id="modal-acquirer-settlement" type="text" placeholder="Ex: D+1, D+14, D+30" value="D+30 (Crédito) / D+1 (PIX)">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Status Operacional</label>
                                            <select class="form-select form-select-sm" id="modal-acquirer-status">
                                                <option value="ATIVO" selected>ATIVO / HOMOLOGADO</option>
                                                <option value="EM_HOMOLOGACAO">EM HOMOLOGAÇÃO</option>
                                                <option value="INATIVO">INATIVO</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Ambiente / Canal Padrão</label>
                                        <select class="form-select form-select-sm" id="modal-acquirer-channel">
                                            <option value="ONLINE">Online (E-commerce / Web / App)</option>
                                            <option value="POS_FISICO">Físico (Máquinas POS / Bilheteria)</option>
                                            <option value="HIBRIDO" selected>Híbrido (Online + POS Bilheteria)</option>
                                        </select>
                                    </div>
                                    <div class="alert alert-info py-2 mb-0 fs-xxs">
                                        <i class="ph-info me-1"></i> A nova adquirente ficará disponível imediatamente para cadastro de taxas por bandeira, parametrização comercial e conciliação bancária.
                                    </div>
                                </div>
                                <div class="modal-footer py-2 bg-light">
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button class="btn btn-sm btn-primary fw-bold" id="btn-gw-save-acquirer" onclick="window.gatewayFeeMatrixController.handleSaveAcquirer()">Salvar Adquirente</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MODAL: NOVA BANDEIRA / TAXA / REGRA COMERCIAL (IMPLANTAÇÃO 5.4) -->
                    <div class="modal fade" id="modal-gw-new-rule" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light border-bottom py-2">
                                    <div>
                                        <h6 class="modal-title fw-bold text-dark mb-0"><i class="ph-plus-circle me-1 text-primary"></i> Cadastrar Nova Bandeira, Modalidade e Taxa</h6>
                                        <div class="text-muted fs-xs">Definição de Custo Disk (MDR), Taxa Comercial, Responsável e Vigência</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-3">
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Adquirente / Gateway *</label>
                                            <select class="form-select form-select-sm" id="modal-rule-acquirer">
                                                <!-- Preenchido dinamicamente -->
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Bandeira do Cartão *</label>
                                            <input class="form-control form-control-sm" id="modal-rule-brand" type="text" placeholder="Ex: Visa, Mastercard, Elo, Amex, PIX" list="brand-options-datalist">
                                            <datalist id="brand-options-datalist">
                                                <option value="Visa">
                                                <option value="Mastercard">
                                                <option value="Elo">
                                                <option value="American Express">
                                                <option value="Hipercard">
                                                <option value="PIX">
                                                <option value="Alelo / Sodexo">
                                            </datalist>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Modalidade / Parcelas *</label>
                                            <select class="form-select form-select-sm" id="modal-rule-modality">
                                                <option value="DEBITO">Débito</option>
                                                <option value="CREDITO_1X" selected>Crédito à Vista (1x)</option>
                                                <option value="CREDITO_2X">Crédito 2x</option>
                                                <option value="CREDITO_3X">Crédito 3x</option>
                                                <option value="CREDITO_4X">Crédito 4x</option>
                                                <option value="CREDITO_5X">Crédito 5x</option>
                                                <option value="CREDITO_6X">Crédito 6x</option>
                                                <option value="CREDITO_7_12X">Crédito Parcelado (7x a 12x)</option>
                                                <option value="PIX">PIX Instantâneo</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-2 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Canal de Venda</label>
                                            <select class="form-select form-select-sm" id="modal-rule-channel">
                                                <option value="ONLINE" selected>Online (Web / App)</option>
                                                <option value="POS_FISICO">Bilheteria Física (POS)</option>
                                                <option value="AGENCIA_PDV">Agência / PDV Credenciado</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Escopo de Aplicação</label>
                                            <select class="form-select form-select-sm" id="modal-rule-scope">
                                                <option value="GLOBAL" selected>Padrão Geral Disk</option>
                                                <option value="PRODUCER">Específico por Produtor</option>
                                                <option value="EVENT">Específico por Evento</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Início da Vigência *</label>
                                            <input class="form-control form-control-sm" id="modal-rule-effective-from" type="date">
                                        </div>
                                    </div>

                                    <div class="p-3 bg-light rounded border mb-3">
                                        <div class="fw-bold fs-xs text-dark mb-2 text-uppercase d-flex align-items-center gap-1">
                                            <i class="ph-calculator text-primary"></i> <span>Composição Financeira da Taxa</span>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label class="form-label fs-xs fw-bold text-danger text-uppercase mb-1">Custo Disk (MDR %) *</label>
                                                <input class="form-control form-control-sm font-monospace" id="modal-rule-acquirer-mdr" type="number" step="0.01" placeholder="Ex: 2.15" value="2.15">
                                                <span class="fs-xxs text-muted">Retido pela operadora</span>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Tarifa Fixa (R$)</label>
                                                <input class="form-control form-control-sm font-monospace" id="modal-rule-fixed-cost" type="number" step="0.01" placeholder="0.00" value="0.00">
                                                <span class="fs-xxs text-muted">Por transação</span>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fs-xs fw-bold text-success text-uppercase mb-1">Taxa Comercial (%) *</label>
                                                <input class="form-control form-control-sm font-monospace" id="modal-rule-commercial-fee" type="number" step="0.01" placeholder="Ex: 2.99" value="2.99">
                                                <span class="fs-xxs text-muted">Aplicada na operação</span>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Quem Suporta a Taxa *</label>
                                                <select class="form-select form-select-sm" id="modal-rule-fee-bearer">
                                                    <option value="PRODUTOR" selected>Produtor (deduz do evento)</option>
                                                    <option value="CLIENTE_FINAL">Cliente Final (checkout)</option>
                                                    <option value="DISK">Disk (absorvido)</option>
                                                    <option value="DIVIDIDO">Dividido (Produtor + Cliente)</option>
                                                </select>
                                                <span class="fs-xxs text-muted">Fee Bearer</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Motivo / Justificativa do Cadastro</label>
                                        <textarea class="form-control form-control-sm" id="modal-rule-reason" rows="2" placeholder="Ex: Tabela negociada para novas bandeiras 2026"></textarea>
                                    </div>

                                    <div class="alert alert-secondary py-2 mb-0 fs-xxs">
                                        <i class="ph-shield-check me-1 text-primary"></i> <strong>Rastreabilidade Imutável:</strong> Esta regra gerará a versão 1.0 com histórico auditável. Alterações futuras deverão ser feitas via <em>Nova Vigência</em> para preservar as liquidações passadas.
                                    </div>
                                </div>
                                <div class="modal-footer py-2 bg-light">
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button class="btn btn-sm btn-primary fw-bold" id="btn-gw-save-rule" onclick="window.gatewayFeeMatrixController.handleSaveRule()">Salvar Bandeira / Taxa</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <section id="view-financial-repass" class="page-section"  style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-0" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Repasses &amp; Liquidações Financeiras</h5>
                                <div class="text-muted fs-xs" id="payout-view-subtitle">Portal do Produtor &bull; Visualização de Repasses e Liquidações</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center w-100 w-md-auto">
                                <!-- Switcher de Perfil / Modo de Visualização -->
                                <div class="btn-group shadow-sm" role="group" id="payout-role-view-toggle">
                                    <button type="button" class="btn btn-sm btn-primary fw-bold d-flex align-items-center gap-1" id="btn-payout-role-producer" onclick="window.switchPayoutRoleView('PRODUCER')">
                                        <i class="ph-user"></i> Visão Produtor
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold d-flex align-items-center gap-1" id="btn-payout-role-financeiro" onclick="window.switchPayoutRoleView('FINANCEIRO')">
                                        <i class="ph-shield-check"></i> Visão Financeiro Disk (Opção A + B)
                                    </button>
                                </div>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" id="financial-export-csv-btn-2" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-file-csv"></i> Exportar CSV
                                </button>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="toggleFinancialShowClosed()" id="btn-financial-closed-2" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-eye"></i> Ver encerrados
                                </button>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="openModal('cash-flow')" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-chart-line-up"></i> Fluxo de Caixa
                                </button>
                                <button class="btn btn-success fw-bold d-flex align-items-center gap-1" id="financial-new-repasse-btn-2" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px; background-color: #00a65a; border-color: #008d4c;">
                                    <i class="ph-plus-circle"></i> Solicitar Repasse
                                </button>
                            </div>
                        </div>
                        <div class="card shadow-sm">
                            <div class="card-header bg-transparent border-bottom p-0">
                                <div class="d-flex justify-content-between align-items-center px-3 py-2">
                                    <ul class="nav nav-tabs border-0 mb-0" id="financial-sub-tabs-repass" style="gap: 4px;">
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 py-2" data-view="financial-balance">Saldo Consolidado</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 active py-2" data-view="financial-repass">Solicitações de Repasse</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 py-2" data-view="financial-advance">Antecipações</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 py-2" data-view="financial-statement">Extrato Detalhado</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 py-2" data-view="financial-expenses">Despesas</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 py-2" data-view="financial-accounts">Contas Bancárias</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link submenu-link tab border-0 py-2" data-view="financial-bordero">Borderô</a></li>
                                    </ul>
                                </div>
                            </div>
                            <!-- SUBTAB 3.2: Solicitações de Repasse pane -->
                            <div class="financial-subpane" id="subpane-repasses" style="padding: 20px;">
                                
                                <!-- ================================================================= -->
                                <!-- MODO 1: VISÃO PRODUTOR (RESULTADOS, VALORES REPASSADOS & RECIBOS) -->
                                <!-- ================================================================= -->
                                <div id="payout-producer-container">
                                    <!-- Banner Exclusivo Produtor -->
                                    <div class="alert alert-info border-0 shadow-sm d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 py-2 px-3 gap-2" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-left: 4px solid #0284c7 !important;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded bg-white text-primary shadow-sm d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; color: #0284c7 !important;">
                                                <i class="ph-user-check fs-4"></i>
                                            </div>
                                            <div>
                                                <strong class="text-dark fs-xs d-block">Área Exclusiva do Produtor &bull; Transparência Financeira</strong>
                                                <span class="text-muted fs-xxs">Consulte o status das suas solicitações, valores líquidos repassados e emita seus comprovantes bancários com autenticação eletrônica.</span>
                                            </div>
                                        </div>
                                        <span class="badge bg-white text-primary border fs-xxs fw-semibold px-2 py-1 shadow-sm">Modo Produtor Ativo</span>
                                    </div>

                                    <!-- 4 Cards de Métricas para o Produtor -->
                                    <div class="row g-3 mb-4">
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #10b981 !important;">
                                                <h6 class="text-uppercase text-muted fs-xs fw-bold mb-1">Total Já Repassado</h6>
                                                <h4 class="fw-bold mb-0 text-success" id="prod-kpi-total-repassado">R$ 5.700,00</h4>
                                                <span class="text-muted fs-xs mt-1" id="prod-kpi-count-concluido">Repasses liquidados</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #0284c7 !important;">
                                                <h6 class="text-uppercase text-muted fs-xs fw-bold mb-1">Repasses Aprovados</h6>
                                                <h4 class="fw-bold mb-0 text-primary" id="prod-kpi-aprovados">R$ 3.500,00</h4>
                                                <span class="text-muted fs-xs mt-1">Liberados para liquidação bancária</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #f59e0b !important;">
                                                <h6 class="text-uppercase text-muted fs-xs fw-bold mb-1">Em Análise / Pendentes</h6>
                                                <h4 class="fw-bold mb-0 text-warning" id="prod-kpi-em-analise">R$ 248,96</h4>
                                                <span class="text-muted fs-xs mt-1">Sob validação da controladoria</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #64748b !important;">
                                                <h6 class="text-uppercase text-muted fs-xs fw-bold mb-1">Saldo Disponível p/ Saque</h6>
                                                <h4 class="fw-bold mb-0 text-dark" id="payout-summary-available">R$ 248,96</h4>
                                                <span class="text-muted fs-xs mt-1">Liberado para transferência</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Form de Solicitação de Repasse do Produtor -->
                                    <div class="card border shadow-sm mb-4">
                                        <div class="card-header bg-light bg-opacity-20 border-bottom py-3">
                                            <h6 class="card-title fw-bold mb-0"><i class="ph-hand-coins text-green me-2"></i> Solicitar Novo Repasse Bancário</h6>
                                        </div>
                                        <div class="card-body">
                                            <form id="page-repasse-form">
                                                <div class="row g-4">
                                                    <!-- Coluna 1: Eventos Elegíveis e Contas -->
                                                    <div class="col-lg-7 border-end-lg">
                                                        <!-- Eventos Elegíveis -->
                                                        <div class="mb-4">
                                                            <h6 class="fw-bold text-dark mb-2 fs-sm">Eventos Elegíveis</h6>
                                                            <div class="table-responsive border rounded bg-white">
                                                                <table class="table table-hover align-middle mb-0" style="width: 100%;">
                                                                    <thead>
                                                                        <tr class="table-light">
                                                                            <th style="padding: 6px 10px; width: 40px;"></th>
                                                                            <th style="padding: 6px 10px;">Evento</th>
                                                                            <th style="padding: 6px 10px;">Data</th>
                                                                            <th style="padding: 6px 10px;" class="text-right">Valor Disponível</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody id="financial-eligible-events-rows">
                                                                        <!-- Preenchido dinamicamente via JS -->
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                        <!-- Conta Bancária -->
                                                        <div class="mb-0">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <h6 class="fw-bold text-dark mb-0 fs-sm">Conta Bancária Favorecida</h6>
                                                                <span style="font-size: 11px; color: var(--primary); cursor: pointer; text-decoration: underline;" onclick="alert('Funcionalidade de alteração de contas em desenvolvimento')">(Alterar Conta)</span>
                                                            </div>
                                                            <div class="row g-2">
                                                                <div class="col-md-6">
                                                                    <div class="bank-account-card-option selected" id="bank-opt-inter" onclick="selectRepasseBankCard('inter')">
                                                                        <input type="radio" name="repasse-bank" id="rad-bank-inter" value="inter" checked>
                                                                        <div style="flex: 1;">
                                                                            <strong style="font-size: 12px; display: block; color: var(--neutral-dark);">Banco Inter</strong>
                                                                            <span style="font-size: 10px; color: var(--text-muted); display: block;">Ag. 0001 | CC ********3456</span>
                                                                            <span style="font-size: 9px; display: block; color: var(--color-dashboard); font-weight: 500;">PIX: financeiro@empresa.com.br</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <div class="bank-account-card-option" id="bank-opt-bb" onclick="selectRepasseBankCard('bb')">
                                                                        <input type="radio" name="repasse-bank" id="rad-bank-bb" value="bb">
                                                                        <div style="flex: 1;">
                                                                            <strong style="font-size: 12px; display: block; color: var(--neutral-dark);">Banco do Brasil</strong>
                                                                            <span style="font-size: 10px; color: var(--text-muted); display: block;">Ag. 1234 | CC 98765-4</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <div class="bank-account-card-option" id="bank-opt-itau" onclick="selectRepasseBankCard('itau')">
                                                                        <input type="radio" name="repasse-bank" id="rad-bank-itau" value="itau">
                                                                        <div style="flex: 1;">
                                                                            <strong style="font-size: 12px; display: block; color: var(--neutral-dark);">Itaú</strong>
                                                                            <span style="font-size: 10px; color: var(--text-muted); display: block;">Ag. 5678 | CC 12345-6</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <div class="bank-account-card-option" id="bank-opt-nubank" onclick="selectRepasseBankCard('nubank')">
                                                                        <input type="radio" name="repasse-bank" id="rad-bank-nubank" value="nubank">
                                                                        <div style="flex: 1;">
                                                                            <strong style="font-size: 12px; display: block; color: var(--neutral-dark);">Nubank</strong>
                                                                            <span style="font-size: 10px; color: var(--text-muted); display: block;">Ag. 0001 | CC 76543-2</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-12">
                                                                    <div class="bank-account-card-option" id="bank-opt-pix" onclick="selectRepasseBankCard('pix')">
                                                                        <input type="radio" name="repasse-bank" id="rad-bank-pix" value="pix">
                                                                        <div style="flex: 1;">
                                                                            <strong style="font-size: 12px; display: block; color: var(--neutral-dark);">PIX Instantâneo</strong>
                                                                            <span style="font-size: 10px; color: var(--text-muted); display: block;">Chave PIX: financeiro@empresa.com.br</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Coluna 2: Valores, Resumo e Submissão -->
                                                    <div class="col-lg-5">
                                                        <div class="mb-4">
                                                            <h6 class="fw-bold text-dark mb-2 fs-sm">Valor do Repasse</h6>
                                                            <div class="payout-card-summary mb-2">
                                                                <div class="payout-sum-row">
                                                                    <span>Valor disponível:</span>
                                                                    <strong id="payout-calc-available" class="text-success">R$ 248,96</strong>
                                                                </div>
                                                                <div class="payout-sum-row">
                                                                    <span>Saldo restante:</span>
                                                                    <span id="payout-calc-remaining" class="text-muted">R$ 0,00</span>
                                                                </div>
                                                            </div>
                                                            <div class="form-group mb-0">
                                                                <label class="form-label fw-bold fs-xs text-muted text-uppercase">Valor solicitado</label>
                                                                <div class="d-flex gap-2">
                                                                    <input type="number" id="payout-amount-input" class="form-control" step="0.01" value="248.96" oninput="updatePayoutCalcRemaining()">
                                                                    <button type="button" class="btn btn-light border text-dark btn-sm fw-bold text-nowrap" onclick="setPayoutMaxAmount()">Solicitar Valor Total</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-4">
                                                            <h6 class="fw-bold text-dark mb-2 fs-sm">Forma de Recebimento</h6>
                                                            <div class="d-flex gap-3" id="payout-method-options-list">
                                                                <label class="form-check d-flex align-items-center gap-1 mb-0 cursor-pointer">
                                                                    <input type="radio" name="payout-method" value="PIX" class="form-check-input" checked onchange="updatePayoutMethodState()">
                                                                    <span class="form-check-label fs-sm">PIX</span>
                                                                </label>
                                                                <label class="form-check d-flex align-items-center gap-1 mb-0 cursor-pointer">
                                                                    <input type="radio" name="payout-method" value="TED" class="form-check-input" onchange="updatePayoutMethodState()">
                                                                    <span class="form-check-label fs-sm">TED</span>
                                                                </label>
                                                                <label class="form-check d-flex align-items-center gap-1 mb-0 cursor-pointer">
                                                                    <input type="radio" name="payout-method" value="Conta Corrente" class="form-check-input" onchange="updatePayoutMethodState()">
                                                                    <span class="form-check-label fs-sm">Conta Corrente</span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <div class="mb-4">
                                                            <h6 class="fw-bold text-dark mb-2 fs-sm">Resumo da Operação</h6>
                                                            <div class="payout-card-summary">
                                                                <div class="payout-sum-row">
                                                                    <span>Valor Bruto Solicitado:</span>
                                                                    <span id="payout-summary-gross">R$ 248,96</span>
                                                                </div>
                                                                <div class="payout-sum-row">
                                                                    <span>Taxas de Repasse:</span>
                                                                    <span class="text-success fw-semibold">R$ 0,00 (Isento)</span>
                                                                </div>
                                                                <div class="payout-sum-row total">
                                                                    <span>Valor Líquido Previsto:</span>
                                                                    <span id="payout-summary-net" class="fw-bold text-success">R$ 248,96</span>
                                                                </div>
                                                                <div class="payout-sum-row mt-2" style="border-top: 1px dashed var(--border-light); padding-top: 8px;">
                                                                    <span>Prazo Estimado:</span>
                                                                    <span class="fw-semibold text-dark" id="payout-summary-period">Instantâneo (Até 10 min)</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="mb-4">
                                                            <div class="d-flex flex-column gap-2">
                                                                <label class="form-check d-flex gap-2 mb-0 cursor-pointer">
                                                                    <input type="checkbox" id="chk-payout-terms-1" class="form-check-input" style="margin-top: 2px;" onchange="validatePayoutTermsAcceptance()">
                                                                    <span class="form-check-label fs-xs text-muted">Declaro que as informações bancárias estão corretas.</span>
                                                                </label>
                                                                <label class="form-check d-flex gap-2 mb-0 cursor-pointer">
                                                                    <input type="checkbox" id="chk-payout-terms-2" class="form-check-input" style="margin-top: 2px;" onchange="validatePayoutTermsAcceptance()">
                                                                    <span class="form-check-label fs-xs text-muted">Concordo com as diretrizes e prazos de repasse.</span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <div class="text-end">
                                                            <button type="button" class="btn btn-light me-2 btn-sm fw-bold" onclick="activateFinancialSubtab('saldo')">Cancelar</button>
                                                            <button type="submit" class="btn btn-success btn-sm fw-bold" id="btn-submit-repasse-form" disabled>Solicitar Repasse ao Financeiro Disk</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Tabela do Produtor: Extrato de Repasses Concluídos e Aprovados -->
                                    <div class="card shadow-sm border mb-4">
                                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark"><i class="ph-receipt text-primary me-2"></i>Histórico &amp; Extrato de Repasses (Visão Produtor)</h6>
                                                <span class="fs-xs text-muted">Acompanhamento transparente de valores solicitados, valores líquidos repassados e comprovantes oficiais</span>
                                            </div>
                                            <button class="btn btn-sm btn-outline-secondary fw-bold d-flex align-items-center gap-1" onclick="window.refreshUnifiedPayoutsDashboard()">
                                                <i class="ph-arrows-clockwise"></i> Atualizar
                                            </button>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0 fs-sm" id="table-producer-payouts">
                                                <thead class="table-light fs-xs text-uppercase text-muted">
                                                    <tr>
                                                        <th>Nº Protocolo</th>
                                                        <th>Data Solicitação</th>
                                                        <th>Evento Vinculado</th>
                                                        <th>Valor Bruto</th>
                                                        <th class="text-success fw-bold">Valor Líquido Repassado</th>
                                                        <th>Conta / Chave Favorecida</th>
                                                        <th>Status Oficial</th>
                                                        <th>Data da Liquidação</th>
                                                        <th class="text-end pe-3">Comprovante Oficial</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="table-producer-payouts-body">
                                                    <!-- Renderizado dinamicamente via JS -->
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Elementos legados mantidos para integridade de scripts externos -->
                                    <div style="display: none;">
                                        <span id="payout-summary-blocked">R$ 0,00</span>
                                        <span id="payout-summary-pending">0</span>
                                        <table><tbody id="table-payouts-history-body"></tbody></table>
                                    </div>
                                </div>

                                <!-- ================================================================= -->
                                <!-- MODO 2: VISÃO FINANCEIRO DISK INGRESSOS (OPÇÃO A + OPÇÃO B JUNTAS) -->
                                <!-- ================================================================= -->
                                <div id="payout-financeiro-container" style="display: none;">
                                    <!-- Banner Executivo de Governança Integrada -->
                                    <div class="card shadow-sm border-0 mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
                                        <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="rounded-circle bg-primary bg-opacity-25 p-2 text-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; color: #38bdf8 !important;">
                                                    <i class="ph-shield-check fs-3"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold fs-sm d-flex align-items-center gap-2">
                                                        Central Unificada de Aprovação &amp; Liquidação de Repasses
                                                        <span class="badge bg-success text-white fs-xs">Opção A + Opção B Integradas</span>
                                                        <span class="badge bg-light text-dark border fs-xs">Maker / Checker &bull; Alçadas</span>
                                                    </div>
                                                    <div class="text-white-50 fs-xs mt-1">
                                                        Aprovações Individuais por Alçada (Opção B) &bull; Homologação em Lotes Maker/Checker &bull; Liquidação Bancária Instantânea PIX e CNAB 240 (Opção A).
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <button class="btn btn-sm btn-outline-light text-white fw-bold d-flex align-items-center gap-1" onclick="window.refreshUnifiedPayoutsDashboard()">
                                                    <i class="ph-arrows-clockwise"></i> Atualizar Fila
                                                </button>
                                                <button class="btn btn-sm btn-info text-white fw-bold d-flex align-items-center gap-1" onclick="window.openCreatePayoutBatchModal()" style="background-color: #0284c7; border-color: #0284c7;">
                                                    <i class="ph-stack"></i> Criar Lote Bancário
                                                </button>
                                                <button class="btn btn-sm btn-success fw-bold d-flex align-items-center gap-1" onclick="window.openSchedulePayoutModal()" style="background-color: #00a65a; border-color: #008d4c;">
                                                    <i class="ph-calendar-plus"></i> Novo Agendamento
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 4 Cards de Métricas do Financeiro -->
                                    <div class="row g-3 mb-4">
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #f59e0b !important;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="text-uppercase text-muted fs-xs fw-bold mb-0">Solicitações Pendentes (Opção B)</h6>
                                                    <span class="badge bg-warning-subtle text-dark fs-xs" id="fin-kpi-pending-count">0</span>
                                                </div>
                                                <h4 class="fw-bold mb-0 mt-2 text-warning" id="fin-kpi-pending-amount">R$ 0,00</h4>
                                                <span class="text-muted fs-xs mt-1">Aguardando decisão de alçada</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #0284c7 !important;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="text-uppercase text-muted fs-xs fw-bold mb-0">Aprovados Aguardando Envio</h6>
                                                    <span class="badge bg-primary-subtle text-primary fs-xs" id="fin-kpi-approved-count">0 prontos</span>
                                                </div>
                                                <h4 class="fw-bold mb-0 mt-2 text-primary" id="fin-kpi-approved-amount">R$ 0,00</h4>
                                                <span class="text-muted fs-xs mt-1">Homologados prontos p/ PIX/Lote</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #8b5cf6 !important;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="text-uppercase text-muted fs-xs fw-bold mb-0">Lotes em Aberto (Opção A)</h6>
                                                    <span class="badge bg-purple-subtle text-purple fs-xs">Maker/Checker</span>
                                                </div>
                                                <h4 class="fw-bold mb-0 mt-2 text-purple" id="fin-kpi-batches-count" style="color: #7c3aed;">0</h4>
                                                <span class="text-muted fs-xs mt-1">Lotes de repasse em validação</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 col-xl-3">
                                            <div class="card card-body border shadow-sm mb-0 bg-white" style="border-top: 3px solid #10b981 !important;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="text-uppercase text-muted fs-xs fw-bold mb-0">Total Liquidado / Repassado</h6>
                                                    <span class="badge bg-success-subtle text-success fs-xs">Banco OK</span>
                                                </div>
                                                <h4 class="fw-bold mb-0 mt-2 text-success" id="fin-kpi-settled-total">R$ 0,00</h4>
                                                <span class="text-muted fs-xs mt-1">Volume creditado aos produtores</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Navegação das Sub-abas Internas do Financeiro -->
                                    <div class="card shadow-sm border-0 mb-3">
                                        <div class="card-body p-2 d-flex flex-wrap gap-2 bg-light rounded">
                                            <button class="btn btn-sm btn-white border fw-bold text-dark active" id="btn-fin-subtab-alcadas" onclick="window.switchFinanceiroSubTab('alcadas')">
                                                <i class="ph-scales text-warning me-1"></i> Fila de Alçadas Individuais (Opção B)
                                            </button>
                                            <button class="btn btn-sm btn-white border fw-bold text-dark" id="btn-fin-subtab-lotes" onclick="window.switchFinanceiroSubTab('lotes')">
                                                <i class="ph-stack text-primary me-1"></i> Gestão de Lotes Bancários (Opção A)
                                            </button>
                                            <button class="btn btn-sm btn-white border fw-bold text-dark" id="btn-fin-subtab-auditoria" onclick="window.switchFinanceiroSubTab('auditoria')">
                                                <i class="ph-shield-check text-secondary me-1"></i> Trilha de Auditoria &amp; Compliance
                                            </button>
                                        </div>
                                    </div>

                                    <!-- SUB-PANE 1: FILA DE ALÇADAS INDIVIDUAIS (OPÇÃO B) -->
                                    <div id="fin-subpane-alcadas" class="fin-subpane">
