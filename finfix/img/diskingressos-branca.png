                                            </div>
                                            <div class="col-md-2 d-flex align-items-end">
                                                <button class="btn btn-sm btn-primary fw-bold w-100 py-1" onclick="window.runApiConsoleRequest()"><i class="ph-paper-plane-tilt me-1"></i> Executar</button>
                                            </div>
