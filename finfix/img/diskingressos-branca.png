                        <!-- ABA 2: CONSTRUTOR VISUAL DE JORNADAS (VISUAL JOURNEY BUILDER) -->
                        <div class="mkt-auto-pane" id="mkt-pane-auto-builder" style="display: none;">
                            
                            <!-- Builder Controls Toolbar -->
                            <div class="card card-body shadow-sm p-3 mb-3" style="border-radius: 8px; background: #faf5ff; border: 1px solid #e9d5ff;">
                                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-purple text-white p-2" style="background-color: #8b5cf6;"><i class="ph-flow-arrow fs-4"></i></span>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0" id="mkt-builder-flow-name">Fluxo: Recuperação de Carrinho Abandonado (30 min)</h6>
                                            <span class="fs-xxs text-muted">Gatilho: <code>checkout.abandoned</code> • Execuções: 8.420 clientes • Receita: R$ 218.420</span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <button class="btn btn-outline-purple btn-sm fw-bold border-purple text-purple" onclick="addNewFlowBlock()">
                                            <i class="ph-plus-circle me-1"></i> Adicionar Bloco
                                        </button>
                                        <button class="btn btn-warning btn-sm text-dark fw-bold" onclick="simulateJourneyExecution()">
                                            <i class="ph-play-circle me-1"></i> Simular / Testar Jornada
                                        </button>
                                        <button class="btn btn-success btn-sm fw-bold shadow-sm" onclick="activateAutomationFlow()">
                                            <i class="ph-check-circle me-1"></i> Ativar Automação
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Canvas Visual do Fluxo -->
                            <div class="card shadow-sm border p-4 mb-3" style="border-radius: 8px; background: #f8fafc; min-height: 520px;">
                                <div class="d-flex flex-column align-items-center" id="mkt-flow-canvas-container" style="max-width: 680px; margin: 0 auto; width: 100%;">
                                    
                                    <!-- Node 1: Gatilho (Trigger) -->
                                    <div class="card border shadow-sm p-3 w-100 bg-white" style="border-radius: 8px; border-left: 5px solid #ef4444 !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 fs-xxs">Gatilho (Trigger)</span>
                                            <span class="fs-xxs text-muted">Tempo Real (Webhook)</span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1"><i class="ph-shopping-cart text-danger me-1"></i> Carrinho Abandonado</h6>
                                        <span class="fs-xxs text-muted">Disparado quando o comprador inicia o checkout e não paga em 15 min.</span>
                                    </div>

                                    <!-- Connector Arrow -->
                                    <div class="text-center py-2 text-primary fs-4"><i class="ph-arrow-down"></i></div>

                                    <!-- Node 2: Espera (Delay) -->
                                    <div class="card border shadow-sm p-2.5 w-100 bg-white" style="border-radius: 8px; border-left: 5px solid #f59e0b !important;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20 fs-xxs mb-1">Espera (Delay)</span>
                                                <div class="fw-bold text-dark fs-xs"><i class="ph-clock text-warning me-1"></i> Aguardar 30 minutos</div>
                                            </div>
                                            <span class="fs-xxs text-muted">Janela de conversão orgânica</span>
                                        </div>
                                    </div>

                                    <!-- Connector Arrow -->
                                    <div class="text-center py-2 text-primary fs-4"><i class="ph-arrow-down"></i></div>

                                    <!-- Node 3: Condição (Condition SIM / NÃO) -->
                                    <div class="card border shadow-sm p-3 w-100 bg-white" style="border-radius: 8px; border-left: 5px solid #3b82f6 !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 fs-xxs">Condição (Decision)</span>
                                            <span class="fs-xxs text-muted">Validação de Pedido</span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-2"><i class="ph-question text-primary me-1"></i> Cliente finalizou a compra?</h6>
                                        <div class="row g-2 text-center fs-xs">
                                            <div class="col-6">
                                                <div class="p-2 rounded bg-success bg-opacity-10 border border-success border-opacity-25 text-success fw-bold">
                                                    ✔ SIM ➔ [Encerrar Jornada]
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-2 rounded bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger fw-bold">
                                                    ✖ NÃO ➔ [Continuar Fluxo]
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Connector Arrow -->
                                    <div class="text-center py-2 text-danger fs-4"><i class="ph-arrow-down"></i></div>

                                    <!-- Node 4: Ação 1 (WhatsApp) -->
                                    <div class="card border shadow-sm p-3 w-100 bg-white" style="border-radius: 8px; border-left: 5px solid #10b981 !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 fs-xxs">Ação (Action)</span>
                                            <span class="fs-xxs text-success fw-bold">Meta Cloud API</span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1"><i class="ph-whatsapp-logo text-success me-1"></i> Enviar WhatsApp com Link de Resgate</h6>
                                        <p class="fs-xxs text-muted mb-0">"Olá {nome}, seus ingressos estão reservados! Finalize seu pedido agora com 1 clique: {link_resgate}"</p>
                                    </div>

                                    <!-- Connector Arrow -->
                                    <div class="text-center py-2 text-primary fs-4"><i class="ph-arrow-down"></i></div>

                                    <!-- Node 5: Espera 2h -->
                                    <div class="card border shadow-sm p-2.5 w-100 bg-white" style="border-radius: 8px; border-left: 5px solid #f59e0b !important;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20 fs-xxs mb-1">Espera (Delay)</span>
                                                <div class="fw-bold text-dark fs-xs"><i class="ph-clock text-warning me-1"></i> Aguardar 2 horas</div>
                                            </div>
                                            <span class="fs-xxs text-muted">Aguardando leitura do WhatsApp</span>
                                        </div>
                                    </div>

                                    <!-- Connector Arrow -->
                                    <div class="text-center py-2 text-primary fs-4"><i class="ph-arrow-down"></i></div>

                                    <!-- Node 6: Ação 2 (E-mail com Cupom 5%) -->
                                    <div class="card border shadow-sm p-3 w-100 bg-white" style="border-radius: 8px; border-left: 5px solid #06b6d4 !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
