                        <!-- ABA 2: EDITOR VISUAL DRAG-AND-DROP (VISUAL BUILDER) -->
                        <div class="mkt-email-pane" id="mkt-pane-email-builder" style="display: none;">
                            <div class="card shadow-sm border mb-3 p-3 bg-white" style="border-radius: 8px;">
                                
                                <!-- Editor Header Toolbar -->
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 border-bottom pb-2.5 mb-3">
