            <div class="modal-header text-white py-3 bg-dark" style="display: flex; justify-content: space-between; align-items: center; width: 100%; border-bottom: 1px solid rgba(0,0,0,0.08);">
                <span class="modal-title fw-bold" style="color: #fff;"><i class="ph-plus-circle me-2"></i> Cadastrar Novo Gateway</span>
                <button class="btn-close-modal" type="button" onclick="closeModal('add-new-gateway-modal')" style="color: #fff; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
            </div>
            <form id="modal-add-new-gateway-form" onsubmit="window.addNewGatewayProvider(event)">
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="new-gw-name">Nome do Gateway / Adquirente:</label>
                        <input type="text" class="form-control form-control-sm" id="new-gw-name" placeholder="Ex: Stripe, Safe2Pay, Adyen, Asaas" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="new-gw-fee">Taxa de Transação Média (MDR %):</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" id="new-gw-fee" placeholder="Ex: 1.85" min="0.1" max="15" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="new-gw-settlement">Prazo de Liquidação Padrão:</label>
                        <select class="form-select form-select-sm fw-semibold" id="new-gw-settlement" required>
                            <option value="D+0">D+0 (Imediato)</option>
                            <option value="D+1" selected>D+1 (1 dia útil)</option>
                            <option value="D+14">D+14 (14 dias)</option>
                            <option value="D+30">D+30 (30 dias)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="new-gw-api-version">Versão da API:</label>
                        <input type="text" class="form-control form-control-sm font-monospace" id="new-gw-api-version" value="v3" required>
                    </div>
