                                        <li class="nav-item">
                                            <a class="nav-link text-muted" href="#" onclick="window.switchGatewayTab(event, 'webhooks')">
                                                <span><i class="ph-brackets-curly menu-icon"></i> Webhooks</span>
                                                <i class="ph-chevron-right chevron-icon"></i>
