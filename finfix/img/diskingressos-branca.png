                                                <th>ID</th>
                                                <th>Favorecido / Chave</th>
                                                <th>Valor</th>
                                                <th>Data Agendada</th>
                                                <th>Status</th>
                                                <th>Criado por</th>
                                                <th>Aprovado por</th>
                                                <th>EndToEnd ID</th>
                                                <th class="text-end">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="trz-tbody-pix" class="fs-xs">
                                            <!-- Renderizado dinamicamente -->
                                        </tbody>
                                    </table>
                                </div>
