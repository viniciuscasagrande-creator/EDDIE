                    <!-- VIEW: Financeiro - Solicitações de Repasse -->
                    <!-- ========================================================================= -->
                    <!-- FASE 26.17.9.4.5: PROCURE-TO-PAY (COMPRAS + FORNECEDORES + CONTRATOS)   -->
                    <!-- ========================================================================= -->
                    <section id="view-procure-to-pay" class="page-section" style="display:none;">
                        <!-- Top Action Bar -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Procure-to-Pay &amp; Gestão de Compras</h5>
                                <div class="text-muted fs-xs">Financeiro &bull; Visão Completa do Fornecedor, Cotações, Pedidos de Compra, Contratos e Alçadas de Aprovação</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center w-100 w-md-auto">
                                <div class="d-flex align-items-center gap-1">
                                    <label for="p2p-producer-select" class="fs-xs fw-bold text-muted mb-0 text-uppercase d-none d-sm-inline">Produtor:</label>
                                    <select id="p2p-producer-select" class="form-select form-select-sm fw-bold border-secondary" style="min-width: 220px;" onchange="window.changeP2PProducer(this.value)">
