            <div class="modal-header text-white py-3 bg-dark" style="display: flex; justify-content: space-between; align-items: center; width: 100%; border-bottom: 1px solid rgba(0,0,0,0.08);">
                <span class="modal-title fw-bold" style="color: #fff;"><i class="ph-handshake me-2"></i> Nova Negociação de Taxas</span>
                <button class="btn-close-modal" type="button" onclick="closeModal('new-negotiation')" style="color: #fff; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
