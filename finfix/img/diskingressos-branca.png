                    <!-- ==========================================================================
                       VIEW: Financeiro - Gestão de Saldos e Transferência entre Eventos (Fases 26.17.9.5 & 26.17.9.5.1)
                       ========================================================================== -->
                    <section id="view-financial-event-transfers" class="page-section" style="display:none;">
                        <!-- Top Action Bar -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Gestão de Saldos & Transferência entre Eventos</h5>
                                <div class="text-muted fs-xs">Financeiro &bull; Saldo consolidado, disponibilidade real e remanejamento interno de recursos</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center w-100 w-md-auto">
                                <div class="d-flex align-items-center gap-1">
                                    <label for="ft-producer-select" class="fs-xs fw-bold text-muted mb-0 text-uppercase d-none d-sm-inline">Produtor:</label>
                                    <select id="ft-producer-select" class="form-select form-select-sm fw-bold border-secondary" style="min-width: 220px;" onchange="window.changeTransferProducer(this.value)">
                                        <option value="prod-1">DiskIngressos Eventos Ltda</option>
                                        <option value="prod-2">CWB Brasil Entretenimento</option>
                                    </select>
                                </div>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" id="ft-refresh-btn" onclick="window.refreshFinancialTransfersView()" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;" title="Recarregar saldos da fonte oficial">
                                    <i class="ph-arrows-clockwise" id="ft-refresh-icon"></i> Atualizar
                                </button>
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="window.exportTransfersCsv()" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-file-csv"></i> Exportar CSV
                                </button>
                                <button class="btn btn-success fw-bold d-flex align-items-center gap-1" id="btn-open-transfer-modal" onclick="window.openBalanceTransferModal()" style="height: 36px; padding: 6px 14px; border-radius: 6px; font-size: 13px; background-color: #00a65a; border-color: #008d4c;">
                                    <i class="ph-arrows-left-right"></i> Nova Transferência
                                </button>
                            </div>
                        </div>

                        <!-- Banner de Regras Contábeis & Status de Integridade (Fase 26.17.9.5.1) -->
                        <div class="card shadow-sm mb-3 border-0" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-left: 5px solid #0284c7 !important;">
                            <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle bg-white shadow-sm p-2 text-primary d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                        <i class="ph-scales fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-sm d-flex align-items-center gap-2">
                                            Regra Contábil de Ouro — Remanejamento Interno de Recursos
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-xs">RN01 - RN13</span>
                                        </div>
                                        <div class="text-secondary fs-xs mt-1">
                                            Transferência permitida <strong>exclusivamente entre eventos do mesmo produtor</strong> utilizando apenas <strong>saldo disponível real</strong>.
                                            <strong>Não gera GMV</strong>, <strong>não gera Receita DiskIngressos</strong> e <strong>não altera o Saldo Consolidado</strong> devido ao produtor.
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div id="ft-integrity-badge" class="badge bg-success text-white px-3 py-2 fs-xs fw-semibold shadow-sm d-flex align-items-center gap-1">
                                        <i class="ph-shield-check fs-sm"></i> Integridade Verificada
                                    </div>
                                    <div id="ft-api-status-badge" class="badge bg-light text-muted border px-2 py-2 fs-xs" title="Status da conexão REST">
                                        <i class="ph-plugs-connected text-success me-1"></i> API REST
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 8 KPIs Cards Consolidados (Fase 26.17.9.5 & Fase 26.17.9.5.1) -->
                        <div class="row g-2 mb-3">
                            <!-- 1. Saldo Total -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #3b82f6 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Saldo Total</span>
                                        <i class="ph-wallet text-primary fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-kpi-total-balance">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Saldo consolidado do produtor</span>
                                </div>
                            </div>
                            <!-- 2. Saldo Disponível Real (Destaque Oficial) -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #10b981 !important; background: #f0fdf4;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-success">Saldo Disponível Real</span>
                                        <i class="ph-check-circle text-success fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-success" id="ft-kpi-available-balance">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Liquidado &minus; Comprometido &minus; Bloqueado</span>
                                </div>
                            </div>
                            <!-- 3. Saldo Comprometido -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #f59e0b !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Comprometido</span>
                                        <i class="ph-clock-countdown text-warning fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-kpi-committed-balance">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Repasses agendados e despesas</span>
                                </div>
                            </div>
                            <!-- 4. Saldo Bloqueado -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #ef4444 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Bloqueado</span>
                                        <i class="ph-lock text-danger fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-danger" id="ft-kpi-blocked-balance">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Chargebacks e contestações</span>
                                </div>
                            </div>
                            <!-- 5. Aguardando Liquidação -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #8b5cf6 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Aguardando Liquidação</span>
                                        <i class="ph-hourglass text-purple fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-kpi-pending-settlement">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Vendas a liquidar no adquirente</span>
                                </div>
                            </div>
                            <!-- 6. Repasses Programados -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #06b6d4 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Repasses Programados</span>
                                        <i class="ph-calendar-check text-info fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-kpi-scheduled-payouts">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Previsão dos próximos repasses</span>
                                </div>
                            </div>
                            <!-- 7. Em Conciliação -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #64748b !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Em Conciliação</span>
                                        <i class="ph-git-diff text-secondary fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-kpi-reconciliation">R$ 0,00</h4>
                                    <span class="fs-xs text-muted mt-1">Lotes em batimento contábil</span>
                                </div>
                            </div>
                            <!-- 8. Divergências -->
                            <div class="col-6 col-md-3 col-xl-3">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #14b8a6 !important;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fs-xs fw-bold text-uppercase text-muted">Divergências</span>
                                        <i class="ph-warning-circle text-teal fs-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-kpi-divergences">0</h4>
                                    <span class="fs-xs text-muted mt-1">Diferenças não resolvidas</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Principal com Navegação por Abas (Fases 26.17.9.5.1 a 26.17.9.5.4) -->
                        <div class="card shadow-sm">
                            <div class="card-header bg-transparent border-bottom p-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-center px-3 py-2 gap-2">
                                    <ul class="nav nav-tabs border-0 mb-0" id="ft-main-tabs" style="gap: 4px;">
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 active py-2" onclick="window.switchTransferTab('dashboard'); event.preventDefault();" id="ft-tab-link-dashboard">
                                                <i class="ph-chart-pie me-1"></i> Dashboard Executivo
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('events'); event.preventDefault();" id="ft-tab-link-events">
                                                <i class="ph-calendar me-1"></i> Saldo por Evento
                                                <span class="badge bg-light text-dark border rounded-pill ms-1" id="ft-events-count-badge">0</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('approvals'); event.preventDefault();" id="ft-tab-link-approvals">
                                                <i class="ph-check-square-offset me-1"></i> Aprovações Pendentes
                                                <span class="badge bg-warning text-dark rounded-pill ms-1" id="ft-approvals-count-badge">0</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('history'); event.preventDefault();" id="ft-tab-link-history">
                                                <i class="ph-clock-counter-clockwise me-1"></i> Histórico & Estornos
                                                <span class="badge bg-primary rounded-pill ms-1" id="ft-history-count-badge">0</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('audit'); event.preventDefault();" id="ft-tab-link-audit">
                                                <i class="ph-shield-check me-1"></i> Trilha de Auditoria & Compliance
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('forecast'); event.preventDefault();" id="ft-tab-link-forecast">
                                                <i class="ph-chart-line-up me-1"></i> Projeção de Caixa &amp; Repasses
                                                <span class="badge bg-danger text-white rounded-pill ms-1 d-none" id="ft-forecast-risk-badge">0</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('rules'); event.preventDefault();" id="ft-tab-link-rules">
                                                <i class="ph-sliders-horizontal me-1"></i> Regras de Repasse &amp; Prioridades
                                                <span class="badge rounded-pill ms-1 text-white" id="ft-rules-count-badge" style="background-color: #7c3aed;">3</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="#" class="nav-link submenu-link tab border-0 py-2" onclick="window.switchTransferTab('schedule'); event.preventDefault();" id="ft-tab-link-schedule">
                                                <i class="ph-calendar-check me-1"></i> Agenda &amp; Lotes
                                                <span class="badge rounded-pill ms-1 text-white" id="ft-schedule-count-badge" style="background-color: #0284c7;">4</span>
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="text" class="form-control form-control-sm" id="ft-events-search" placeholder="Filtrar eventos..." oninput="window.filterTransferEvents(this.value)" style="width: 180px;">
                                    </div>
                                </div>
                            </div>

                            <!-- PANE 1: Dashboard Executivo de Saldos (Fase 26.17.9.5.4) -->
                            <div class="card-body p-3" id="ft-pane-dashboard">
                                <!-- Linha 1: 6 Indicadores Operacionais & Executivos -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border bg-light p-2 mb-0 shadow-none">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs text-muted">Transferências</span>
                                                <i class="ph-arrows-left-right text-primary"></i>
                                            </div>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-op-transfers-count">0</div>
                                            <span class="fs-xs text-muted">No período</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border bg-light p-2 mb-0 shadow-none">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs text-muted">Valor Transferido</span>
                                                <i class="ph-currency-dollar text-success"></i>
                                            </div>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-op-transferred-amount">R$ 0,00</div>
                                            <span class="fs-xs text-muted">Remanejamento interno</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border bg-light p-2 mb-0 shadow-none">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs text-muted">Aprovações Pendentes</span>
                                                <i class="ph-hourglass text-warning"></i>
                                            </div>
                                            <div class="fs-5 fw-bold text-warning mt-1" id="ft-op-pending-approvals">0</div>
                                            <span class="fs-xs text-muted">Aguardando alçada</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border bg-light p-2 mb-0 shadow-none">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs text-muted">Estornos</span>
                                                <i class="ph-arrow-u-down-left text-danger"></i>
                                            </div>
                                            <div class="fs-5 fw-bold text-danger mt-1" id="ft-op-reversals-count">0</div>
                                            <span class="fs-xs text-muted">Operações reversas</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border bg-light p-2 mb-0 shadow-none">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs text-muted">Reservas Ativas</span>
                                                <i class="ph-bookmark-simple text-purple"></i>
                                            </div>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-op-active-reservations">0</div>
                                            <span class="fs-xs text-muted">Saldos caucionados</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-xl-2">
                                        <div class="card h-100 border bg-light p-2 mb-0 shadow-none">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs text-muted">Déficit em Eventos</span>
                                                <i class="ph-trend-down text-danger"></i>
                                            </div>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-op-deficit-amount">R$ 0,00</div>
                                            <span class="fs-xs text-muted">Obrigações &gt; Vendas</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Linha 2: Ratios de Saúde Financeira -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded bg-white shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fs-xs fw-bold text-muted text-uppercase">Taxa de Disponibilidade</span>
                                                <span class="fw-bold text-success" id="ft-ratio-avail-pct">0.0%</span>
                                            </div>
                                            <div class="progress" style="height: 7px;">
                                                <div id="ft-ratio-avail-bar" class="progress-bar bg-success" role="progressbar" style="width: 0%;"></div>
                                            </div>
                                            <div class="fs-xs text-muted mt-2">Percentual do saldo base pronto para saque ou transferência</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded bg-white shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fs-xs fw-bold text-muted text-uppercase">Taxa de Comprometimento</span>
                                                <span class="fw-bold text-warning" id="ft-ratio-comm-pct">0.0%</span>
                                            </div>
                                            <div class="progress" style="height: 7px;">
                                                <div id="ft-ratio-comm-bar" class="progress-bar bg-warning" role="progressbar" style="width: 0%;"></div>
                                            </div>
                                            <div class="fs-xs text-muted mt-2">Reservado para repasses agendados, antecipações e despesas</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded bg-white shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fs-xs fw-bold text-muted text-uppercase">Taxa de Bloqueio</span>
                                                <span class="fw-bold text-danger" id="ft-ratio-block-pct">0.0%</span>
                                            </div>
                                            <div class="progress" style="height: 7px;">
                                                <div id="ft-ratio-block-bar" class="progress-bar bg-danger" role="progressbar" style="width: 0%;"></div>
                                            </div>
                                            <div class="fs-xs text-muted mt-2">Chargebacks, contestações e retenções cautelares</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Linha 3: Gráficos & Composição Visual -->
                                <div class="row g-3 mb-3">
                                    <!-- Composição de Saldos -->
                                    <div class="col-lg-6">
                                        <div class="card h-100 border shadow-none mb-0">
                                            <div class="card-header bg-light border-bottom py-2">
                                                <h6 class="fw-bold mb-0 fs-xs text-uppercase text-dark"><i class="ph-chart-pie me-1 text-primary"></i> Composição dos Recursos do Produtor</h6>
                                            </div>
                                            <div class="card-body p-3" id="ft-dash-composition-container">
                                                <!-- Barra empilhada visual -->
                                                <div class="progress mb-3" style="height: 22px; border-radius: 6px;">
                                                    <div id="bar-comp-avail" class="progress-bar bg-success fw-bold fs-xs" style="width: 60%;" title="Disponível">Disponível</div>
                                                    <div id="bar-comp-comm" class="progress-bar bg-warning text-dark fw-bold fs-xs" style="width: 25%;" title="Comprometido">Comprometido</div>
                                                    <div id="bar-comp-block" class="progress-bar bg-danger fw-bold fs-xs" style="width: 15%;" title="Bloqueado">Bloqueado</div>
                                                </div>
                                                <div class="row g-2 text-center fs-xs">
                                                    <div class="col-3">
                                                        <div class="p-2 border rounded bg-light">
                                                            <div class="text-success fw-bold" id="comp-label-avail">R$ 0,00</div>
                                                            <span class="text-muted">Disponível</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-3">
                                                        <div class="p-2 border rounded bg-light">
                                                            <div class="text-warning fw-bold" id="comp-label-comm">R$ 0,00</div>
                                                            <span class="text-muted">Comprometido</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-3">
                                                        <div class="p-2 border rounded bg-light">
                                                            <div class="text-danger fw-bold" id="comp-label-block">R$ 0,00</div>
                                                            <span class="text-muted">Bloqueado</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-3">
                                                        <div class="p-2 border rounded bg-light">
                                                            <div class="text-purple fw-bold" id="comp-label-pend">R$ 0,00</div>
                                                            <span class="text-muted">Aguardando</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Eventos com Maior Saldo e Disponibilidade -->
                                    <div class="col-lg-6">
                                        <div class="card h-100 border shadow-none mb-0">
                                            <div class="card-header bg-light border-bottom py-2 d-flex justify-content-between align-items-center">
                                                <h6 class="fw-bold mb-0 fs-xs text-uppercase text-dark"><i class="ph-trend-up me-1 text-success"></i> Maiores Saldos Disponíveis por Evento</h6>
                                                <a href="#" class="fs-xs text-primary" onclick="window.switchTransferTab('events'); event.preventDefault();">Ver todos</a>
                                            </div>
                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle mb-0">
                                                        <tbody id="ft-dash-top-events-tbody" class="fs-xs">
                                                            <!-- Preenchido via JS -->
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Linha 4: Alertas Executivos Inteligentes -->
                                <div class="card border shadow-none mb-0">
                                    <div class="card-header bg-light border-bottom py-2 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0 fs-xs text-uppercase text-dark"><i class="ph-bell-ringing me-1 text-warning"></i> Alertas Executivos & Monitoramento de Riscos</h6>
                                        <span class="badge bg-secondary fs-xs" id="ft-dash-alerts-count">0 alertas</span>
                                    </div>
                                    <div class="card-body p-3" id="ft-dash-alerts-container">
                                        <!-- Alertas dinâmicos -->
                                    </div>
                                </div>
                            </div>

                            <!-- PANE 2: Saldo por Evento (Fase 26.17.9.5.1) -->
                            <div class="card-body p-0" id="ft-pane-events" style="display: none;">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" id="ft-events-table">
                                        <thead>
                                            <tr class="table-light fs-xs text-uppercase text-muted">
                                                <th style="width: 28%;">Evento</th>
                                                <th style="width: 12%;" class="text-end">Transacionado</th>
                                                <th style="width: 12%;" class="text-end">Liquidado</th>
                                                <th style="width: 14%;" class="text-end text-success fw-bold">Disponível Real</th>
                                                <th style="width: 10%;" class="text-end text-warning">Comprometido</th>
                                                <th style="width: 10%;" class="text-end text-danger">Bloqueado</th>
                                                <th style="width: 7%;" class="text-center">Integridade</th>
                                                <th style="width: 7%;" class="text-end pe-3">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="ft-events-tbody" class="fs-sm">
                                            <!-- Preenchido via JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- PANE 3: Aprovações Pendentes (Fase 26.17.9.5.2) -->
                            <div class="card-body p-0" id="ft-pane-approvals" style="display: none;">
                                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">Central de Alçadas & Aprovações</h6>
                                        <div class="text-muted fs-xs">Transferências com reserva cautelar aguardando aprovação formal</div>
                                    </div>
                                    <span class="badge bg-warning text-dark px-3 py-1 fs-xs fw-semibold">Segregação de Funções Ativa</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="table-light fs-xs text-uppercase text-muted">
                                                <th style="width: 14%;">Código</th>
                                                <th style="width: 13%;">Data Solicitação</th>
                                                <th style="width: 20%;">Evento Origem (Caucionado)</th>
                                                <th style="width: 20%;">Evento Destino</th>
                                                <th style="width: 13%;" class="text-end">Valor</th>
                                                <th style="width: 10%;">Solicitante</th>
                                                <th style="width: 10%;" class="text-end pe-3">Decisão</th>
                                            </tr>
                                        </thead>
                                        <tbody id="ft-approvals-tbody" class="fs-sm">
                                            <!-- Preenchido via JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- PANE 4: Histórico de Transferências & Estornos (Fase 26.17.9.5.3) -->
                            <div class="card-body p-0" id="ft-pane-history" style="display: none;">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" id="ft-history-table">
                                        <thead>
                                            <tr class="table-light fs-xs text-uppercase text-muted">
                                                <th style="width: 14%;">Código</th>
                                                <th style="width: 13%;">Data/Hora</th>
                                                <th style="width: 18%;">Evento Origem</th>
                                                <th style="width: 18%;">Evento Destino</th>
                                                <th style="width: 12%;" class="text-end">Valor Transferido</th>
                                                <th style="width: 11%;" class="text-center">Status</th>
                                                <th style="width: 14%;" class="text-end pe-3">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="ft-history-tbody" class="fs-sm">
                                            <!-- Preenchido via JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- PANE 5: Logs de Auditoria & Compliance -->
                            <div class="card-body p-3" id="ft-pane-audit" style="display: none;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0 text-dark">Registro Imutável de Auditoria Financeira</h6>
                                    <span class="badge bg-secondary fs-xs">Trilha Append-Only / CorrelationId</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped align-middle mb-0">
                                        <thead>
                                            <tr class="table-light fs-xs text-uppercase text-muted">
                                                <th style="width: 16%;">Timestamp</th>
                                                <th style="width: 14%;">Transferência</th>
                                                <th style="width: 14%;">Ator / Usuário</th>
                                                <th style="width: 16%;">Ação</th>
                                                <th style="width: 40%;">Detalhes e Parâmetros</th>
                                            </tr>
                                        </thead>
                                        <tbody id="ft-audit-tbody" class="fs-xs font-monospace">
                                            <!-- Preenchido via JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- PANE 6: Projeção de Caixa e Repasses por Evento (Fase 26.17.9.5.5) -->
                            <div class="card-body p-3" id="ft-pane-forecast" style="display: none;">
                                <!-- Top Bar de Controles do Forecast -->
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 p-3 bg-light rounded-3 border mb-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="fw-bold mb-0 text-dark">Projeção Preditiva de Fluxo de Caixa e Repasses</h6>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-xs">Fase 26.17.9.5.5</span>
                                        </div>
                                        <div class="text-muted fs-xs mt-1">
                                            Modelo canônico: <strong>Saldo Projetado = Saldo Disponível + Entradas Previstas &minus; Saídas Previstas</strong>. Identifica riscos e recomenda cobertura sem movimentação automática.
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <label class="fs-xs fw-bold text-muted text-uppercase mb-0">Horizonte:</label>
                                            <select class="form-select form-select-sm" id="ft-fc-horizon-select" onchange="window.switchForecastHorizon(this.value)" style="width: 120px; font-size: 12px;">
                                                <option value="7">7 dias</option>
                                                <option value="15">15 dias</option>
                                                <option value="30" selected>30 dias</option>
                                                <option value="60">60 dias</option>
                                                <option value="90">90 dias</option>
                                            </select>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <label class="fs-xs fw-bold text-muted text-uppercase mb-0">Visualização:</label>
                                            <select class="form-select form-select-sm" id="ft-fc-event-select" onchange="window.switchForecastEvent(this.value)" style="width: 220px; font-size: 12px;">
                                                <option value="consolidado" selected>Consolidado (Todos)</option>
                                                <!-- Preenchido dinamicamente -->
                                            </select>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" onclick="window.refreshForecastData()" title="Recalcular Projeção">
                                            <i class="ph-arrows-clockwise" id="ft-fc-refresh-icon"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- 8 KPIs Executivos da Projeção -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-3 shadow-none" style="border-top: 3px solid #10b981 !important;">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs fw-bold text-uppercase text-muted">Saldo Real Atual</span>
                                                <i class="ph-wallet text-success fs-5"></i>
                                            </div>
                                            <h4 class="fw-bold mb-0 mt-2 text-dark" id="ft-fc-kpi-current-available">R$ 0,00</h4>
                                            <span class="fs-xs text-muted mt-1">Disponível real (t₀)</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-3 shadow-none" style="border-top: 3px solid #0284c7 !important;">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs fw-bold text-uppercase text-muted">Entradas Previstas</span>
                                                <i class="ph-trend-up text-primary fs-5"></i>
                                            </div>
                                            <h4 class="fw-bold mb-0 mt-2 text-primary" id="ft-fc-kpi-expected-inflows">R$ 0,00</h4>
                                            <span class="fs-xs text-muted mt-1">Liquidações e entradas</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-3 shadow-none" style="border-top: 3px solid #f59e0b !important;">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs fw-bold text-uppercase text-muted">Saídas Previstas</span>
                                                <i class="ph-trend-down text-warning fs-5"></i>
                                            </div>
                                            <h4 class="fw-bold mb-0 mt-2 text-danger" id="ft-fc-kpi-expected-outflows">R$ 0,00</h4>
                                            <span class="fs-xs text-muted mt-1">Repasses e despesas</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-3 shadow-none" style="border-top: 3px solid #6366f1 !important; background: #faf5ff;">
                                            <div class="d-flex justify-content-between">
                                                <span class="fs-xs fw-bold text-uppercase text-indigo">Saldo Projetado</span>
                                                <i class="ph-chart-line-up text-indigo fs-5"></i>
                                            </div>
                                            <h4 class="fw-bold mb-0 mt-2 text-indigo" id="ft-fc-kpi-projected-balance">R$ 0,00</h4>
                                            <span class="fs-xs text-muted mt-1">Posição final no horizonte</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Menor Saldo Projetado</span>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-fc-kpi-minimum-balance">R$ 0,00</div>
                                            <span class="fs-xs text-muted" id="ft-fc-kpi-critical-date-label">Ponto de maior exposição</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Classificação de Risco</span>
                                            <div class="mt-1" id="ft-fc-kpi-risk-container">
                                                <span class="badge bg-success text-white px-2 py-1 fs-xs fw-semibold" id="ft-fc-kpi-risk-badge">NORMAL</span>
                                            </div>
                                            <span class="fs-xs text-muted" id="ft-fc-kpi-risk-sublabel">Folga adequada</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Eventos com Risco</span>
                                            <div class="fs-5 fw-bold text-dark mt-1" id="ft-fc-kpi-events-at-risk">0 / 0</div>
                                            <span class="fs-xs text-muted">Monitoramento ativo</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card h-100 border p-2 mb-0 shadow-none bg-light">
                                            <span class="fs-xs text-muted">Necessidade de Cobertura</span>
                                            <div class="fs-5 fw-bold text-danger mt-1" id="ft-fc-kpi-required-coverage">R$ 0,00</div>
                                            <span class="fs-xs text-muted">Para neutralizar déficit</span>
                                        </div>
                                    </div>
