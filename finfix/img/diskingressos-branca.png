                                <button class="btn btn-sm btn-white border fw-bold text-dark active" id="p2p-tab-btn-approvals" onclick="window.switchP2PTab('approvals')">
                                    <i class="ph-check-circle text-warning me-1"></i> Central de Solicitações
                                </button>
                                <button class="btn btn-sm btn-white border fw-bold text-dark" id="p2p-tab-btn-suppliers" onclick="window.switchP2PTab('suppliers')">
