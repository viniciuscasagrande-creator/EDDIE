                                    <label class="form-label mb-0 fs-xxs text-muted text-uppercase fw-bold">Canal:</label>
                                    <select class="form-select form-select-sm" id="mkt-filter-channel" onchange="setMarketingFilter('channel', this.value)">
                                        <option value="all">Todos os Canais</option>
                                        <option value="whatsapp">WhatsApp Marketing</option>
                                        <option value="meta">Meta Ads (CAPI)</option>
                                        <option value="google">Google Ads</option>
                                        <option value="email">E-mail Marketing</option>
                                        <option value="sms">SMS</option>
                                        <option value="organic">Orgânico / Direto</option>
