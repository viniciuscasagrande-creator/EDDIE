                                <div class="dropdown">
                                    <button class="btn btn-outline-light border text-dark fw-bold d-flex align-items-center gap-1" id="layout-config-btn" data-bs-toggle="dropdown" style="border-radius: 6px; padding: 6px 12px; height: 36px; font-size: 13px;">
                                        <i class="ph-sliders"></i> Layout
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end p-3 shadow-lg" style="width: 220px; border-radius: 8px;">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-2">Visualização</label>
                                            <div class="btn-group w-100" role="group">
                                                <button type="button" class="btn btn-outline-primary btn-sm active" id="btn-view-grid"><i class="ph-squares-four me-1"></i> Grid</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" id="btn-view-list"><i class="ph-list me-1"></i> Lista</button>
                                            </div>
