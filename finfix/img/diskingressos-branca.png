                                        <input type="text" id="cortesia-search-input" class="form-control form-control-sm border-secondary" placeholder="Buscar no histórico..." style="width: 180px; font-size: 11px;" title="Buscar cortesias">
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                            <table class="table table-hover align-middle mb-0" style="font-size: 12px;">
