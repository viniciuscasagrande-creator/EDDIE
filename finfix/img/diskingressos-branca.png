                                    <div class="col-lg-6">
                                        <div class="card border shadow-sm mb-0">
                                            <div class="card-header bg-light py-2">
                                                <h6 class="fw-bold mb-0"><i class="ph-trend-up text-success me-2"></i> Solicitar Antecipação de Receitas</h6>
                                            </div>
                                            <div class="card-body">
                                                <p class="text-muted fs-xs">Simule e antecipe o recebimento das receitas de vendas dos seus eventos futuros (ainda não encerrados). Taxa administrativa padrão: 3,5%.</p>
                                                <form onsubmit="event.preventDefault(); alert('Antecipação de R$ ' + document.getElementById('anticipate-gross-input-page').value + ' efetuada com sucesso!'); activateFinancialSubtab('saldo');">
                                                    <div class="form-group mb-3">
                                                        <label class="form-label fw-semibold fs-xs" for="anticipate-event-select">Selecione o Evento Elegível</label>
                                                        <select class="form-select" id="anticipate-event-select" title="Selecione o evento elegível" aria-label="Selecione o evento elegível">
                                                            <option value="festival-x" data-value="1850">Festival X (Data: 12/08/2026) - Disponível: R$ 1.850,00</option>
                                                        </select>
                                                    </div>
                                                    <div class="form-group mb-3">
                                                        <label class="form-label fw-semibold fs-xs" for="anticipate-gross-input-page">Valor Bruto a Antecipar</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text" style="padding: 0 10px;">R$</span>
                                                            <input type="number" id="anticipate-gross-input-page" class="form-control" step="0.01" min="100" max="1850" value="1000" oninput="calculateAnticipationSimPage()">
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <button type="submit" class="btn btn-success btn-sm fw-bold">Confirmar e Solicitar</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="card border shadow-sm mb-0">
                                            <div class="card-header bg-light py-2">
                                                <h6 class="fw-bold mb-0"><i class="ph-calculator text-primary me-2"></i> Simulação de Antecipação</h6>
                                            </div>
                                            <div class="card-body">
                                                <div class="payout-card-summary">
                                                    <div class="payout-sum-row">
                                                        <span>Valor Bruto Simulado:</span>
                                                        <strong id="sim-page-gross">R$ 1.000,00</strong>
                                                    </div>
                                                    <div class="payout-sum-row text-danger">
