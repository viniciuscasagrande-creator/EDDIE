                                            <strong class="text-dark fs-xs">R$ 800,00 (10%)</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ETAPA 7: AGENDAMENTO & FREQUÊNCIA -->
                            <div class="mkt-wizard-pane" id="mkt-pane-step-7" style="display: none;">
