                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 bg-dark text-white p-3" style="border-radius: 8px;">
                                    <div class="fs-xxs text-uppercase fw-bold opacity-75 text-warning">EBITDA</div>
                                    <h3 class="fw-bold mb-0 mt-1">R$ 1.950.000</h3>
