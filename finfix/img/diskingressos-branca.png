                            <!-- FASE 26.17.8.8 / 26.17.9.1: Inteligência Contábil integrada -->
                            <div class="accounting-pane" id="accpane-inteligencia-contabil" style="display: none;">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1"><i class="ph-brain text-primary me-2"></i>Disk Intelligence Contábil</h5>
                                        <p class="text-muted small mb-0">Anomalias, riscos e recomendações calculadas a partir dos módulos contábeis integrados.</p>
                                    </div>
                                </div>
                                <div id="acc-intelligence-enterprise-root"></div>
                            </div>

                            <div class="accounting-pane" id="accpane-simulador" style="display: none;">
                                <div class="card shadow-sm border mb-3" style="border-radius: 12px; border-left: 4px solid #f38d4f;">
                                    <div class="card-header bg-transparent py-2.5 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0 text-dark"><i class="ph-cpu text-warning me-1"></i> Simulador Contábil de Ciclo de Venda Completo (Yii & Gateway)</h6>
                                        <span class="badge bg-light text-primary font-monospace fs-xxs">Demonstrador Integrado</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <p class="text-muted fs-xs mb-3">Simule uma venda de ingresso e veja como os valores fluem em tempo real do faturamento até o Balanço Patrimonial e DRE.</p>
                                        
                                        <!-- Simulation form inputs -->
                                        <div class="row g-2 mb-3 bg-light p-2.5 rounded">
                                            <div class="col-md-2.5 col-sm-6">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Preço do Ingresso:</label>
                                                <input type="number" class="form-control form-control-sm font-monospace fw-bold" id="sim-ticket-price" value="100.00" step="10">
                                            </div>
                                            <div class="col-md-2.5 col-sm-6">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Taxa Conveniência:</label>
                                                <input type="number" class="form-control form-control-sm font-monospace fw-bold" id="sim-ticket-tax" value="10.00" step="2">
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Taxa Gateway (Meio):</label>
                                                <select class="form-select form-select-sm font-monospace" id="sim-gateway-type">
                                                    <option value="cc" selected>Crédito (2.5% + R$ 0.50)</option>
                                                    <option value="pix">PIX API (0.99% fixo)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2 col-sm-6">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Comissão Produtor:</label>
                                                <select class="form-select form-select-sm" id="sim-commission-pct">
                                                    <option value="10" selected>10%</option>
                                                    <option value="15">15%</option>
                                                    <option value="5">5%</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2 col-sm-12 d-flex align-items-end">
                                                <button class="btn btn-sm btn-primary fw-bold w-100 py-1" onclick="window.runAccountingSimulation()"><i class="ph-play me-1"></i> Simular</button>
                                            </div>
                                        </div>

                                        <!-- Visual flow diagram map -->
                                        <div class="row g-2 mb-3 text-center fs-xxs" style="font-size: 10px;">
                                            <div class="col">
                                                <div class="border rounded p-1 bg-white shadow-xs" id="step-sim-venda">
                                                    <strong class="d-block text-dark">1. Venda</strong>
                                                    <span id="sim-flow-val-venda">-</span>
                                                </div>
                                            </div>
                                            <div class="col-auto align-self-center text-muted"><i class="ph-caret-right-bold"></i></div>
                                            <div class="col">
                                                <div class="border rounded p-1 bg-white shadow-xs" id="step-sim-gateway">
                                                    <strong class="d-block text-dark">2. Gateway</strong>
                                                    <span id="sim-flow-val-gateway">-</span>
                                                </div>
                                            </div>
                                            <div class="col-auto align-self-center text-muted"><i class="ph-caret-right-bold"></i></div>
                                            <div class="col">
                                                <div class="border rounded p-1 bg-white shadow-xs" id="step-sim-financeiro">
                                                    <strong class="d-block text-dark">3. Financeiro</strong>
                                                    <span id="sim-flow-val-financeiro">-</span>
                                                </div>
                                            </div>
                                            <div class="col-auto align-self-center text-muted"><i class="ph-caret-right-bold"></i></div>
                                            <div class="col">
                                                <div class="border rounded p-1 bg-white shadow-xs" id="step-sim-contabil">
                                                    <strong class="d-block text-dark">4. Contabilidade</strong>
                                                    <span id="sim-flow-val-contabil">-</span>
                                                </div>
                                            </div>
                                            <div class="col-auto align-self-center text-muted"><i class="ph-caret-right-bold"></i></div>
                                            <div class="col">
                                                <div class="border rounded p-1 bg-white shadow-xs" id="step-sim-conciliacao">
                                                    <strong class="d-block text-dark">5. Conciliação</strong>
                                                    <span id="sim-flow-val-conciliacao">-</span>
                                                </div>
                                            </div>
                                            <div class="col-auto align-self-center text-muted"><i class="ph-caret-right-bold"></i></div>
                                            <div class="col">
                                                <div class="border rounded p-1 bg-white shadow-xs" id="step-sim-repasse">
                                                    <strong class="d-block text-dark">6. Repasse</strong>
                                                    <span id="sim-flow-val-repasse">-</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Step detail outputs -->
                                        <div id="sim-results-container" style="display: none;">
                                            <div class="row g-2 font-monospace" style="font-size: 11px;">
                                                <div class="col-md-6">
                                                    <div class="border rounded p-2.5 bg-light text-start h-100">
                                                        <strong class="text-primary d-block border-bottom pb-1 mb-1">Apropriação Contábil da Venda</strong>
                                                        <div class="d-flex justify-content-between"><span>Receita de Ingressos (Yii):</span><span class="text-success" id="sim-res-rec-ingressos">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between"><span>Taxa de Conveniência (Markup):</span><span class="text-success" id="sim-res-rec-taxas">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between"><span>Custo de Gateway (Processador):</span><span class="text-danger" id="sim-res-c-gateway">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between"><span>Comissão Cobrada do Produtor:</span><span class="text-success" id="sim-res-comissao">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between"><span>Provisão Imposto (DAS - 6.5% s/ Markup):</span><span class="text-danger" id="sim-res-imposto">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between fw-bold border-top pt-1 mt-1 text-dark"><span>Contas a Receber (Bruto):</span><span id="sim-res-receber">R$ 0,00</span></div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="border rounded p-2.5 bg-light text-start h-100">
                                                        <strong class="text-success d-block border-bottom pb-1 mb-1">Liquidação, Razão & DRE</strong>
                                                        <div class="d-flex justify-content-between"><span>Líquido Recebido no Banco (Itaú):</span><span class="text-success" id="sim-res-liq-banco">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between"><span>Provisão Repasse ao Produtor:</span><span class="text-warning" id="sim-res-prov-repasse">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between"><span>Resultado Líquido s/ Venda (DRE):</span><span class="text-success fw-bold" id="sim-res-dre-liq">R$ 0,00</span></div>
                                                        <div class="d-flex justify-content-between border-top pt-1 mt-1 text-muted fs-xxs"><span>Partidas Dobradas Diário:</span><span>D: Bancos / C: Rec. Recebidas</span></div>
                                                        <div class="d-flex justify-content-between text-muted fs-xxs"><span>Partidas Dobradas Payout:</span><span>D: Produtores / C: Bancos</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="alert alert-success py-1 px-2 mt-2 mb-0 fs-xxs text-start">
                                                <i class="ph-check-circle me-1"></i> <strong>Sucesso:</strong> Lançamentos adicionados com sucesso ao Livro Diário, Livro Razão e Conciliação do painel.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                                <!-- TAB PANE: Plano de Contas -->
                                <div class="accounting-pane" id="accpane-plano-contas" style="display: none;">
                                    <div class="card shadow-sm border p-3 mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="fw-bold text-dark mb-0"><i class="ph-list-bullets text-primary me-1"></i> Plano de Contas Configurável</h6>
                                            <button class="btn btn-xs btn-primary fw-bold" onclick="window.showAddAccountModal()"><i class="ph-plus me-1"></i> Nova Conta Contábil</button>
                                        </div>
                                        <p class="text-muted fs-xs">Estrutura de contas organizadas para o controle de ativos, passivos, receitas e despesas do DiskIngressos.</p>
                                        
                                        <!-- Interactive Tree View of accounts -->
                                        <div class="d-flex flex-column gap-2" id="acc-plano-contas-tree">
                                            <!-- Managed dynamically via JS state -->
                                        </div>
                                    </div>
                                </div>

                                <!-- TAB PANE: Livro Diário -->
                                <div class="accounting-pane" id="accpane-diario" style="display: none;">
                                    <div class="card shadow-sm border">
                                        <div class="card-header bg-transparent py-2 d-flex justify-content-between align-items-center">
                                            <h6 class="fw-bold mb-0 text-dark"><i class="ph-notebook text-primary me-1"></i> Livro Diário Contábil</h6>
                                            <span class="fs-xxs text-muted font-monospace">Lançamentos automáticos parametrizados</span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0" style="font-size: 12.5px;">
                                                <thead>
                                                    <tr class="table-light">
                                                        <th>Data</th>
                                                        <th>Histórico / Operação</th>
                                                        <th>Débito (+)</th>
                                                        <th>Crédito (-)</th>
                                                        <th class="text-end">Valor (R$)</th>
                                                    </tr>
