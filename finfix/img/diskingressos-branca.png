                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="neg-sector">Setor / Área (areaId):</label>
                        <input type="text" class="form-control form-control-sm fw-semibold" id="neg-sector" placeholder="Ex: Pista Premium, Camarote, VIP" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="neg-channel">Canal / Forma de Venda (formOfSaleId):</label>
                        <select class="form-select form-select-sm fw-semibold" id="neg-channel" required>
                            <option value="Site DiskIngressos" selected>Site DiskIngressos (Online)</option>
                            <option value="Bilheteria Física">Bilheteria Física / PDV</option>
                            <option value="Televendas">Televendas / Call Center</option>
                            <option value="Cortesias / Staff">Cortesias (Emissão Interna)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="neg-tax">Taxa de Conveniência (Tax):</label>
                            <input type="text" class="form-control form-control-sm fw-semibold" id="neg-tax" placeholder="Ex: 10% ou R$ 5,00" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="neg-comission">Comissão (Comission):</label>
                            <input type="text" class="form-control form-control-sm fw-semibold" id="neg-comission" placeholder="Ex: 8% ou R$ 2,00" required>
                        </div>
                    </div>
