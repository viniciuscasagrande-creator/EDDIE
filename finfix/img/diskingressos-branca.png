                                            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark"><i class="ph-scales text-warning me-2"></i>Aprovações Individuais por Alçada &bull; Governança SoD</h6>
                                                    <span class="fs-xs text-muted">Aprove por alçada direta (Automática, Controladoria N1 ou Diretoria N2), liquide via PIX imediato ou agrupe em lote</span>
                                                </div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0 fs-sm" id="table-financeiro-alcadas">
                                                    <thead class="table-light fs-xs text-uppercase text-muted">
