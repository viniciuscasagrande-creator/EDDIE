                            <div class="d-flex align-items-center gap-3">
                                <button class="btn btn-light btn-sm border" onclick="changeAgendaYear(-1)" title="Ano anterior" aria-label="Ano anterior"><i class="ph-caret-left"></i></button>
                                <span class="fs-sm text-muted cursor-pointer fw-medium" onclick="selectAgendaYear(2024)" id="year-label-2024">2024</span>
