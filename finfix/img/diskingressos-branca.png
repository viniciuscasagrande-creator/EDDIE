                                                    <!-- Filled dynamically -->
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                                                <!-- TAB PANE: Lançamentos / Rastreabilidade 360º (Fase 26.17.8.3) -->
                                <div class="accounting-pane" id="accpane-lancamentos" style="display: none;">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3 pb-2 border-bottom">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace fs-xxs">FASE 26.17.8.3</span>
                                                <h6 class="fw-bold mb-0 text-dark">Rastreabilidade Financeiro &rarr; Cont&aacute;bil (Vis&atilde;o 360&ordm;)</h6>
                                            </div>
                                            <p class="text-muted fs-xs mb-0">
                                                Auditoria completa: Pedido &rarr; Pagamento &rarr; Gateway &rarr; Liquida&ccedil;&atilde;o &rarr; Split &rarr; Repasse &rarr; Receita Disk &rarr; Lan&ccedil;amento Cont&aacute;bil &rarr; Auditoria
                                            </p>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-xs btn-outline-secondary fw-semibold" onclick="window.exportTraceabilityEvidence()">
                                                <i class="ph-download-simple me-1"></i> Exportar Evid&ecirc;ncias
                                            </button>
                                            <button class="btn btn-xs btn-primary fw-bold text-white" onclick="window.openTraceabilityAuditModal()">
                                                <i class="ph-shield-check me-1"></i> Trilha de Auditoria
                                            </button>
                                            <button class="btn btn-xs btn-outline-primary fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-manual-entry" aria-expanded="false">
                                                <i class="ph-pencil-simple-line me-1"></i> Lan&ccedil;amento Manual
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Collapsible Manual Entry Form (Preservando 100% da funcionalidade anterior) -->
                                    <div class="collapse mb-3" id="collapse-manual-entry">
                                        <div class="card shadow-sm border p-3 bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0 fs-xs"><i class="ph-pencil text-primary me-1"></i> Lan&ccedil;amento Cont&aacute;bil Manual Simples</h6>
                                                <span class="text-muted fs-xxs">Partida dobrada avulsa</span>
                                            </div>
                                            <form id="acc-manual-entry-form" onsubmit="window.saveManualAccountingEntry(event)">
                                                <div class="row g-2 mb-2">
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Data:</label>
                                                        <input type="date" id="acc-man-date" class="form-control form-control-sm" required>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">D&eacute;bito (+):</label>
                                                        <select id="acc-man-debit" class="form-select form-select-sm" required>
                                                            <option value="1.1.02.01 - Valores a Receber Gateway">1.1.02.01 - Valores a Receber Gateway</option>
                                                            <option value="1.1.01.02 - Bancos Conta Movimento">1.1.01.02 - Bancos Conta Movimento</option>
                                                            <option value="4.1.01.01 - Despesa MDR Adquir&ecirc;ncia">4.1.01.01 - Despesa MDR Adquir&ecirc;ncia</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Cr&eacute;dito (-):</label>
                                                        <select id="acc-man-credit" class="form-select form-select-sm" required>
                                                            <option value="2.1.03.01 - Recursos de Terceiros (Produtores)">2.1.03.01 - Recursos de Terceiros (Produtores)</option>
                                                            <option value="3.1.01.01 - Receita Taxa Conveni&ecirc;ncia">3.1.01.01 - Receita Taxa Conveni&ecirc;ncia</option>
                                                            <option value="1.1.02.01 - Valores a Receber Gateway">1.1.02.01 - Valores a Receber Gateway</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Valor (R$):</label>
                                                        <input type="number" id="acc-man-value" class="form-control form-control-sm font-monospace" placeholder="0,00" step="0.01" required>
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-2">
                                                    <div class="col-md-4">
                                                        <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Centro de Custo:</label>
                                                        <select id="acc-man-cost" class="form-select form-select-sm">
                                                            <option value="CC-201 Plataforma Digital Disk" selected>CC-201 Plataforma Digital Disk</option>
                                                            <option value="CC-101 Shows e Festivais">CC-101 Shows e Festivais</option>
                                                            <option value="CC-001 Tesouraria Central">CC-001 Tesouraria Central</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Hist&oacute;rico Cont&aacute;bil:</label>
                                                        <input type="text" id="acc-man-desc" class="form-control form-control-sm" placeholder="Ex: Ajuste de tarifa de adquirente por liquida&ccedil;&atilde;o avulsa" required>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-xs btn-light" data-bs-toggle="collapse" data-bs-target="#collapse-manual-entry">Cancelar</button>
                                                    <button type="submit" class="btn btn-xs btn-primary fw-bold text-white"><i class="ph-floppy-disk me-1"></i> Gravar Lan&ccedil;amento</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Search & Quick Picker Bar -->
                                    <div class="card shadow-sm border p-3 mb-3 bg-white">
                                        <div class="row g-2 align-items-center">
                                            <div class="col-12 col-md-7">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="ph-magnifying-glass"></i></span>
                                                    <input type="text" class="form-control border-start-0" id="acc-trace-search-input" placeholder="Buscar por Pedido (#123456), Transa&ccedil;&atilde;o (TRX-928183), NSU, TID, Evento, Produtor..." onkeydown="if(event.key==='Enter') window.searchTraceabilityOrder()">
                                                    <button class="btn btn-primary fw-bold text-white px-3" type="button" onclick="window.searchTraceabilityOrder()">
                                                        Rastrear 360&ordm;
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-5">
                                                <div class="d-flex align-items-center gap-1 flex-wrap justify-content-md-end">
                                                    <span class="fs-xxs text-muted fw-bold text-uppercase me-1">Exemplos r&aacute;pidos:</span>
                                                    <button class="btn btn-xxs btn-outline-secondary fw-semibold" onclick="window.loadTraceabilityOrder('#123456')">#123456 (Festival Ver&atilde;o)</button>
                                                    <button class="btn btn-xxs btn-outline-secondary fw-semibold" onclick="window.loadTraceabilityOrder('#123488')">#123488 (Stand-up)</button>
                                                    <button class="btn btn-xxs btn-outline-secondary fw-semibold" onclick="window.loadTraceabilityOrder('#123512')">#123512 (Arena Rock)</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Container populated dynamically by renderTraceability() -->
                                    <div id="traceability-content-container">
                                        <!-- Dynamic order trace rendered here -->
                                    </div>
                                </div>

                                <!-- TAB PANE: Centro de Custos -->
                                <div class="accounting-pane" id="accpane-custos" style="display: none;">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="card shadow-sm border p-3">
                                                <h6 class="fw-bold text-dark mb-3"><i class="ph-chart-pie text-primary me-1"></i> Centro de Custos e Rateios</h6>
                                                <p class="text-muted fs-xs">Alocação de custos e receitas do DiskIngressos por departamento organizacional.</p>
                                                <div class="d-flex flex-column gap-2" id="acc-custos-departamentos-list">
                                                    <!-- Filled dynamically -->
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <!-- Event specific rateios (Advanced Mode) -->
                                            <div class="card shadow-sm border p-3 h-100 d-flex flex-column justify-content-between" style="border-radius: 12px;">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-2"><i class="ph-handshake text-success me-1"></i> Regra de Rateio por Evento</h6>
                                                    <p class="text-muted fs-xs">Distribua os custos de infraestrutura operacional (Cloud, SMS, Gateway) diretamente na cota de arrecadação do produtor.</p>
                                                    <div class="form-group mb-2">
                                                        <label class="form-label fs-xxs fw-bold text-muted mb-1">Evento de Destino:</label>
                                                        <select class="form-select form-select-sm" id="acc-rateio-event-select">
                                                            <!-- Filled dynamically -->
                                                        </select>
                                                    </div>
                                                    <div class="form-group mb-2">
                                                        <label class="form-label fs-xxs fw-bold text-muted mb-1">Percentual de Alocação (%):</label>
                                                        <input type="number" id="acc-rateio-percentage-input" class="form-control form-control-sm fw-bold font-monospace" min="1" max="100" value="10">
                                                    </div>
                                                </div>
                                                <button class="btn btn-sm btn-outline-success fw-bold w-100 mt-3" onclick="window.applyRateioRule()"><i class="ph-check me-1"></i> Aplicar Rateio no Evento</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- TAB PANE: Centro de Conciliação Contábil & Operacional (Fase 26.17.8.2) -->
                                <div class="accounting-pane" id="accpane-conciliacao" style="display: none;">

                                    <!-- 1. CABEÇALHO EXECUTIVO DO CENTRO DE CONCILIAÇÃO -->
                                    <div class="card card-body p-3 shadow-sm border mb-3 bg-white" style="border-radius: 10px; border-left: 4px solid #10b981;">
                                        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 fs-xxs font-monospace">FASE 26.17.8.2</span>
                                                    <span class="fs-xxs text-muted uppercase tracking-wider fw-bold">Contabilidade Enterprise PDT DiskIngressos</span>
                                                </div>
                                                <h5 class="fw-bold text-dark mb-0">Centro de Conciliação Contábil &amp; Operacional</h5>
                                                <span class="fs-xs text-muted">
                                                    Rastreamento contínuo: <strong>Pedido → Gateway → Banco → Split → Repasse → Contabilidade</strong>
                                                </span>
                                            </div>

                                            <!-- Ações Rápidas no Cabeçalho -->
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <button type="button" class="btn btn-outline-secondary btn-xs fw-semibold" onclick="window.openModal('importar-extrato-conciliacao')">
                                                    <i class="ph-upload-simple me-1 text-primary"></i> Importar Extrato (OFX/CSV)
                                                </button>
                                                <button type="button" class="btn btn-outline-primary btn-xs fw-semibold" onclick="window.exportReconciliationCsv()">
                                                    <i class="ph-file-arrow-down me-1"></i> Exportar Dados
                                                </button>
                                                <button type="button" class="btn btn-success btn-xs fw-bold text-white shadow-xs" onclick="window.runAutoReconciliation()">
                                                    <i class="ph-arrows-clockwise me-1"></i> Executar Conciliação em Lote
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Pipeline Visual de Fluxo -->
                                        <div class="reconciliation-pipeline mt-3 pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2 fs-xxs">
                                            <div class="pipeline-step active d-flex align-items-center gap-1.5">
                                                <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">1</span>
                                                <span class="fw-bold text-dark">Pedido Aprovado</span>
                                                <i class="ph-check-circle text-success fs-6"></i>
                                            </div>
                                            <i class="ph-caret-right text-muted opacity-40"></i>
                                            <div class="pipeline-step active d-flex align-items-center gap-1.5">
                                                <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">2</span>
                                                <span class="fw-bold text-dark">Gateway Processado</span>
                                                <i class="ph-check-circle text-success fs-6"></i>
                                            </div>
                                            <i class="ph-caret-right text-muted opacity-40"></i>
                                            <div class="pipeline-step active d-flex align-items-center gap-1.5">
                                                <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">3</span>
                                                <span class="fw-bold text-dark">Liquidação Bancária</span>
                                                <i class="ph-check-circle text-success fs-6"></i>
                                            </div>
                                            <i class="ph-caret-right text-muted opacity-40"></i>
                                            <div class="pipeline-step active d-flex align-items-center gap-1.5">
                                                <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">4</span>
                                                <span class="fw-bold text-dark">Split Calculado</span>
                                                <i class="ph-check-circle text-success fs-6"></i>
                                            </div>
                                            <i class="ph-caret-right text-muted opacity-40"></i>
                                            <div class="pipeline-step active d-flex align-items-center gap-1.5">
                                                <span class="badge bg-primary text-white rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">5</span>
                                                <span class="fw-bold text-dark">Repasse Produtor</span>
                                                <i class="ph-check-circle text-success fs-6"></i>
                                            </div>
                                            <i class="ph-caret-right text-muted opacity-40"></i>
                                            <div class="pipeline-step active d-flex align-items-center gap-1.5">
                                                <span class="badge bg-success text-white rounded-circle p-1" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px;">6</span>
                                                <span class="fw-bold text-dark">Contabilidade Conciliada</span>
                                                <i class="ph-shield-check text-success fs-6"></i>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. GRID DE 8 KPIS DE INTEGRIDADE DA CONCILIAÇÃO -->
                                    <div class="row g-2 mb-3">
                                        <!-- KPI 1: Processado -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Processado</span>
                                                <h5 class="fw-bold mb-0 text-dark font-monospace" id="rec-kpi-processed">R$ 1.842.500,00</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-calendar-check text-primary"></i> Período corrente</span>
                                            </div>
                                        </div>
                                        <!-- KPI 2: Conciliado -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Conciliado</span>
                                                <h5 class="fw-bold mb-0 text-success font-monospace" id="rec-kpi-reconciled">R$ 1.779.200,00</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-check-circle text-success"></i> 98,73% de aderência</span>
                                            </div>
                                        </div>
                                        <!-- KPI 3: Pendente -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Pendente</span>
                                                <h5 class="fw-bold mb-0 text-warning font-monospace" id="rec-kpi-pending">R$ 29.100,00</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-hourglass text-warning"></i> Aguardando liquidação D+1/3</span>
                                            </div>
                                        </div>
                                        <!-- KPI 4: Divergente -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Divergente</span>
                                                <h5 class="fw-bold mb-0 text-danger font-monospace" id="rec-kpi-divergent">R$ 34.200,00</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-warning-circle text-danger"></i> 27 pedidos em fila</span>
                                            </div>
                                        </div>
                                        <!-- KPI 5: Valor Divergente -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Valor Divergente</span>
                                                <h5 class="fw-bold mb-0 text-danger font-monospace" id="rec-kpi-divergent-amount">R$ 34.210,00</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-scales text-danger"></i> Impacto a regularizar</span>
                                            </div>
                                        </div>
                                        <!-- KPI 6: Chargebacks -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Chargebacks</span>
                                                <h5 class="fw-bold mb-0 text-danger font-monospace" id="rec-kpi-chargebacks">7</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-shield-warning text-danger"></i> Contestação de adquirente</span>
                                            </div>
                                        </div>
                                        <!-- KPI 7: Estornos -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Estornos</span>
                                                <h5 class="fw-bold mb-0 text-secondary font-monospace" id="rec-kpi-refunds">18</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-arrow-u-down-left text-secondary"></i> Cancelamentos CDC</span>
                                            </div>
                                        </div>
                                        <!-- KPI 8: Duplicidades -->
                                        <div class="col-6 col-md-3">
                                            <div class="card card-body p-3 shadow-sm border text-start bg-white h-100" style="border-radius: 8px;">
                                                <span class="fs-xxs fw-bold text-muted text-uppercase mb-1">Duplicidades</span>
                                                <h5 class="fw-bold mb-0 text-secondary font-monospace" id="rec-kpi-duplicates">4</h5>
                                                <span class="fs-xxs text-muted mt-1"><i class="ph-copy text-secondary"></i> TID duplicado no lote</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 3. PAINEL DE CONTROLE CENTRAL (ÍNDICE & EXCEÇÕES + FILA OPERACIONAL) -->
                                    <div class="row g-3">
                                        <!-- COLUNA LATERAL ESQUERDA: ÍNDICE GERAL & SUB-MÉTRICAS -->
                                        <div class="col-xl-4 col-lg-5">
                                            <!-- Card Índice Geral -->
                                            <div class="card p-3 shadow-sm border mb-3 bg-white" style="border-radius: 10px;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fs-xxs fw-bold text-muted text-uppercase">Índice Geral de Batimento</span>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 fs-xxs">Automático</span>
                                                </div>
                                                <h2 class="fw-bold text-dark font-monospace mb-1" id="rec-gauge-rate">98,73%</h2>
                                                <div class="progress mb-2" style="height: 8px; border-radius: 4px; background-color: #f1f5f9;">
                                                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="rec-gauge-bar" role="progressbar" style="width: 98.73%"></div>
                                                </div>
                                                <p class="fs-xxs text-muted mb-3">
                                                    Conformidade calculada entre pedidos no banco de dados, liquidações bancárias e relatórios de adquirentes.
                                                </p>

                                                <!-- Breakdown de Divergências Críticas -->
                                                <div class="d-flex flex-column gap-2 pt-2 border-top">
                                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light fs-xs">
                                                        <span class="text-muted"><i class="ph-magnifying-glass me-1.5 text-danger"></i> Não Localizadas</span>
                                                        <strong class="font-monospace text-danger" id="rec-metric-notfound">9</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light fs-xs">
                                                        <span class="text-muted"><i class="ph-percent me-1.5 text-warning"></i> Diferenças de Taxas</span>
                                                        <strong class="font-monospace text-warning" id="rec-metric-feegap">12</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light fs-xs">
                                                        <span class="text-muted"><i class="ph-paper-plane-tilt me-1.5 text-danger"></i> Repasses Divergentes</span>
                                                        <strong class="font-monospace text-danger" id="rec-metric-payoutgap">6</strong>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Card Rápido de Importação de Extrato (Recurso Preservado e Aprimorado) -->
                                            <div class="card p-3 shadow-sm border bg-white" style="border-radius: 10px;">
                                                <h6 class="fw-bold text-dark mb-2"><i class="ph-bank text-primary me-1.5"></i> Extratos &amp; Adquirentes</h6>
                                                <p class="text-muted fs-xs mb-2">Importe arquivos OFX ou relatórios de liquidação para batimento automático.</p>
                                                <div class="mb-2">
                                                    <label class="form-label fs-xxs fw-bold text-muted mb-0.5">Adquirente / Banco:</label>
                                                    <select class="form-select form-select-xs fw-semibold" id="rec-import-banco-select">
                                                        <option value="itau" selected>Banco Itaú (C/C 89210-4)</option>
                                                        <option value="inter">Banco Inter (Conta Digital / Pix)</option>
                                                        <option value="stripe">Stripe Adquirente (MDR 2.5%)</option>
                                                        <option value="stone">Stone Pagamentos (MDR 2.3%)</option>
                                                        <option value="pagarme">Pagar.me / Mundipagg</option>
                                                    </select>
                                                </div>
                                                <button type="button" class="btn btn-xs btn-outline-primary fw-bold w-100 mb-2" onclick="window.openModal('importar-extrato-conciliacao')">
                                                    <i class="ph-file-plus me-1"></i> Carregar Arquivo OFX / CSV
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-secondary fw-semibold w-100" onclick="window.viewReconciliationAuditLog()">
                                                    <i class="ph-shield-check me-1 text-primary"></i> Ver Trilha de Auditoria Geral
                                                </button>
                                            </div>
                                        </div>

                                        <!-- COLUNA PRINCIPAL DIREITA: FILTROS, BUSCA & FILA DE DIVERGÊNCIAS -->
                                        <div class="col-xl-8 col-lg-7">
                                            <div class="card shadow-sm border bg-white" style="border-radius: 10px; overflow: hidden;">
                                                <!-- Filtros de Status (Pills) -->
                                                <div class="p-3 border-bottom bg-light bg-opacity-40">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                                        <div class="btn-group btn-group-xs flex-wrap" role="group" id="rec-status-filter-group">
                                                            <button type="button" class="btn btn-xs btn-primary fw-bold active" data-status="TODOS" onclick="window.setReconciliationStatusFilter('TODOS')">Todos</button>
                                                            <button type="button" class="btn btn-xs btn-outline-secondary fw-semibold" data-status="DIVERGENTE" onclick="window.setReconciliationStatusFilter('DIVERGENTE')">Divergentes</button>
                                                            <button type="button" class="btn btn-xs btn-outline-secondary fw-semibold" data-status="PENDENTE" onclick="window.setReconciliationStatusFilter('PENDENTE')">Pendentes</button>
