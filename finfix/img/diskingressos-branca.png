                                            <div class="list-group list-group-flush fs-xs">
                                                <div class="list-group-item px-0 py-1.5 d-flex justify-content-between bg-transparent">
                                                    <span class="text-muted">Campanha:</span>
                                                    <strong class="text-dark" id="wiz-rev-title">Virada de Lote Festival Summer</strong>
                                                </div>
                                                <div class="list-group-item px-0 py-1.5 d-flex justify-content-between bg-transparent">
