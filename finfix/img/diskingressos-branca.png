                    <!-- ============================================================================ -->
                    <!-- IMPLANTAÇÃO 5 — POSIÇÃO FINANCEIRA GERAL (VISÃO MASTER DISK INTERNO)        -->
                    <!-- ============================================================================ -->
                    <section id="view-financial-posicao-geral" class="page-section" style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                    <i class="ph-chart-line-up text-primary"></i> <span>Posição Financeira Geral</span>
                                </h5>
                                <div class="text-muted fs-xs">
                                    Visão Executiva Consolidada &bull; Múltiplos Produtores, Eventos e Canais de Venda &bull; Separação Estrita de Receitas
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="btn-refresh-posicao">
                                    <i class="ph-arrows-clockwise"></i> <span>Atualizar</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" id="btn-export-posicao">
                                    <i class="ph-download-simple"></i> <span>Exportar Relatório</span>
                                </button>
