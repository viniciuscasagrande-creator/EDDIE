                                        <svg viewBox="0 0 400 200" style="width: 100%; height: 100%; display: block; background: #cbd5e1;">
                                            <path d="M 30,50 Q 80,10 150,40 T 280,30 T 380,80 Q 320,150 240,120 T 110,160 Z" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
