                                    <select class="form-select form-select-sm" id="mkt-filter-producer" onchange="setMarketingFilter('producerId', this.value)">
                                        <option value="all">Todos os Produtores</option>
                                        <option value="p1">Opus Entretenimento</option>
                                        <option value="p2">Live Nation Brasil</option>
                                        <option value="p3">Disk Produções</option>
                                    </select>
                                </div>
