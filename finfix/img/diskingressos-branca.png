                                                <span>4º Teatro Fernanda Montenegro</span>
                                                <span class="fw-bold font-monospace">R$ 24.960</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: 53%;"></div>
