                    <!-- VIEW: Componente ScrollSpy (Demonstração & Laboratório Oficial Limitless/Bootstrap 5) -->
                    <section id="view-components-scrollspy" class="page-section" style="display: none;">
                        <!-- Cabeçalho Informativo & Ações Rápidas -->
                        <div class="card card-body shadow-sm mb-3" style="border-radius: 8px;">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h4 class="fw-bold mb-0 text-dark"><i class="ph-selection text-primary me-2"></i>Componente ScrollSpy</h4>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-2 py-0.5 fs-xxs">Bootstrap 5 + Limitless</span>
                                    </div>
                                    <p class="text-muted fs-sm mb-0 mt-1">Atualização automática e contextual de componentes de navegação (.nav, .list-group) sincronizados com a rolagem do usuário.</p>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" id="btn-scrollspy-refresh" title="Atualiza o cálculo de posições e nós do DOM">
                                        <i class="ph-arrows-clockwise me-1"></i> Executar refresh()
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger fw-semibold" id="btn-scrollspy-dispose" title="Destrói as instâncias ativas do ScrollSpy">
                                        <i class="ph-trash me-1"></i> Executar dispose()
                                    </button>
                                    <button type="button" class="btn btn-sm btn-success fw-semibold text-white" id="btn-scrollspy-reinit" title="Recria ou recupera a instância via getOrCreateInstance()">
                                        <i class="ph-play me-1"></i> getOrCreateInstance()
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Card de Requisitos e Funcionamento -->
                        <div class="card shadow-sm mb-3 border-0 bg-light" style="border-radius: 8px;">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-dark fs-xs mb-2"><i class="ph-info text-primary me-1"></i> Requisitos Oficiais de Funcionamento:</h6>
                                <div class="row g-2 fs-xs text-muted">
                                    <div class="col-md-3">
                                        <div class="p-2 bg-white rounded border h-100">
                                            <strong class="text-dark d-block mb-1">1. Alvo do Scrollspy</strong>
                                            Usado sobre componentes de navegação (<code>.nav</code>, <code>.nav-pills</code>) ou <code>.list-group</code>.
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-2 bg-white rounded border h-100">
                                            <strong class="text-dark d-block mb-1">2. Posição Relativa</strong>
                                            Requer <code>position: relative;</code> no elemento espionado (ex: <code>.content-wrapper</code> ou container customizado).
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-2 bg-white rounded border h-100">
                                            <strong class="text-dark d-block mb-1">3. Altura & Rolagem</strong>
                                            Em containers internos (não-body), requer <code>height</code> fixo e <code>overflow-y: scroll;</code> (ou <code>auto</code>).
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-2 bg-white rounded border h-100">
                                            <strong class="text-dark d-block mb-1">4. Âncoras com IDs</strong>
                                            Links <code>&lt;a href="#id"&gt;</code> obrigatórios apontando exatamente para o <code>id</code> do título na área de rolagem.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- EXEMPLO 1: BARRA DE NAVEGAÇÃO (NAVBAR) -->
                        <div class="card shadow-sm mb-4" style="border-radius: 8px;">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold text-dark mb-0"><i class="ph-browser me-2 text-primary"></i>1. Exemplo na Barra de Navegação</h6>
                                    <span class="text-muted fs-xs">Role a área abaixo para ver o destaque automático das abas e itens do menu suspenso.</span>
                                </div>
                                <span id="badge-active-navbar" class="badge bg-secondary px-2 py-1 fs-xxs">Ativo: Primeiro</span>
                            </div>
                            <div class="card-body p-3">
                                <!-- Navbar superior com pills e dropdown -->
                                <nav id="navbar-scrollspy-demo" class="navbar navbar-expand-lg bg-light px-3 mb-2 rounded border">
                                    <a class="navbar-brand fw-bold text-dark fs-sm" href="javascript:void(0)">Barra de navegação</a>
                                    <ul class="nav nav-pills ms-auto">
                                        <li class="nav-item">
                                            <a class="nav-link active" href="#scrollspyHeading1">Primeiro</a>
