                                    <li class="nav-item"><a href="#" class="nav-link fw-bold py-1 px-3" onclick="filterCampaignsByStatus('paused', event)">Pausadas <span class="badge bg-warning text-dark ms-1">1</span></a></li>
                                    <li class="nav-item"><a href="#" class="nav-link fw-bold py-1 px-3" onclick="filterCampaignsByStatus('completed', event)">Finalizadas <span class="badge bg-secondary ms-1">12</span></a></li>
                                    <li class="nav-item"><a href="#" class="nav-link fw-bold py-1 px-3" onclick="filterCampaignsByStatus('draft', event)">Rascunhos <span class="badge bg-light text-dark border ms-1">3</span></a></li>
                                </ul>

                                <!-- Search & Channel Filter -->
                                <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-lg-auto">
                                    <div class="input-group input-group-sm flex-grow-1" style="min-width: 160px; max-width: 220px;">
                                        <span class="input-group-text bg-light border-end-0"><i class="ph-magnifying-glass"></i></span>
                                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar campanha..." id="mkt-campaign-search-input" oninput="filterCampaignsTable()">
                                    </div>
                                    <select class="form-select form-select-sm flex-grow-1" style="min-width: 130px; max-width: 160px;" id="mkt-campaign-channel-filter" onchange="filterCampaignsTable()">
                                        <option value="all">Todos Canais</option>
                                        <option value="whatsapp">WhatsApp</option>
                                        <option value="meta">Meta Ads</option>
                                        <option value="google">Google Ads</option>
                                        <option value="email">E-mail</option>
                                        <option value="sms">SMS</option>
                                        <option value="push">Push</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Tabela Principal de Campanhas -->
                        <div class="card shadow-sm border" style="border-radius: 8px;">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Campanha / Objetivo</th>
                                            <th>Evento Vinculado</th>
                                            <th>Canais</th>
                                            <th>Público</th>
                                            <th>Investimento</th>
                                            <th>Receita</th>
                                            <th>ROAS</th>
                                            <th>Score</th>
                                            <th>Status</th>
                                            <th class="text-end">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mkt-campaigns-main-table-body">
                                        <!-- Rendered dynamically by JS Engine -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </section>

                    <!-- ==========================================================================
                       2.1. WIZARD DE CRIAÇÃO DE CAMPANHA MULTICANAL (marketing-campaign-create)
                       ========================================================================== -->
                    <section id="view-marketing-campaign-create" class="page-section"  style="display:none;">
                        
                        <!-- Header do Criador de Campanhas -->
                        <div class="card card-body shadow-sm mb-3" style="border-radius: 8px; background: #ffffff; border-left: 5px solid #8b5cf6;">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h4 class="fw-bold mb-0 text-dark">Criar Campanha Multicanal</h4>
                                        <span class="badge bg-purple bg-opacity-10 text-purple border border-purple border-opacity-20 fs-xxs">Passo a Passo Guiado</span>
                                    </div>
                                    <p class="text-muted fs-xs mb-0">Configure público, canais, orçamento, conteúdo e agendamento de ponta a ponta.</p>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary btn-sm fw-bold" onclick="navigateTo('marketing-campaigns')">
                                        <i class="ph-arrow-left me-1"></i> Voltar p/ Campanhas
                                    </button>
                                    <button class="btn btn-light border btn-sm fw-bold" onclick="saveCampaignAsDraft()">
                                        <i class="ph-floppy-disk me-1"></i> Salvar Rascunho
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Step Progress Indicator -->
                        <div class="card card-body shadow-sm py-3 px-4 mb-3" style="border-radius: 8px;">
                            <div class="d-flex justify-content-between align-items-center position-relative flex-wrap gap-2" id="mkt-wizard-stepper">
                                <div class="text-center mkt-step-item active" id="step-nav-1" onclick="goToWizardStep(1)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-primary text-white fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">1</div>
                                    <span class="fs-xxs fw-bold text-dark d-block">Objetivo</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-2" onclick="goToWizardStep(2)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">2</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Evento</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-3" onclick="goToWizardStep(3)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">3</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Público</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-4" onclick="goToWizardStep(4)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">4</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Canais</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-5" onclick="goToWizardStep(5)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">5</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Conteúdo &amp; IA</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-6" onclick="goToWizardStep(6)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">6</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Orçamento</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-7" onclick="goToWizardStep(7)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">7</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Agendamento</span>
                                </div>
                                <div class="text-center mkt-step-item" id="step-nav-8" onclick="goToWizardStep(8)" style="cursor: pointer;">
                                    <div class="mkt-step-circle mb-1 mx-auto bg-light border text-muted fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 13px;">8</div>
                                    <span class="fs-xxs fw-semibold text-muted d-block">Revisão</span>
                                </div>
                            </div>
                        </div>

                        <!-- Wizard Form Container -->
                        <div class="card shadow-sm border p-4 mb-3" style="border-radius: 8px;">
                            
                            <!-- ETAPA 1: OBJETIVO DA CAMPANHA -->
                            <div class="mkt-wizard-pane" id="mkt-pane-step-1">
                                <h5 class="fw-bold text-dark mb-1">1. Qual é o objetivo principal da campanha?</h5>
                                <p class="text-muted fs-xs mb-4">Escolha um dos objetivos recomendados abaixo para que o sistema pré-configure canais e públicos ideais.</p>
                                
                                <div class="row g-3" id="mkt-objectives-grid">
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card p-3 border h-100 mkt-obj-card active" style="cursor: pointer; border-radius: 8px;" onclick="selectCampaignObjective('sell_tickets', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-3">🎟️</span>
                                                <span class="badge bg-primary">Venda Direta</span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Vender Ingressos</h6>
                                            <p class="text-muted fs-xxs mb-0">Foco em tráfego qualificado e conversão imediata de ingressos.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card p-3 border h-100 mkt-obj-card" style="cursor: pointer; border-radius: 8px;" onclick="selectCampaignObjective('batch_change', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-3">⚡</span>
                                                <span class="badge bg-warning text-dark">Urgência</span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Virada de Lote</h6>
                                            <p class="text-muted fs-xxs mb-0">Avisa os interessados antes do aumento programado de preço.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card p-3 border h-100 mkt-obj-card" style="cursor: pointer; border-radius: 8px;" onclick="selectCampaignObjective('last_tickets', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-3">🔥</span>
                                                <span class="badge bg-danger">Escassez</span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Últimos Ingressos</h6>
                                            <p class="text-muted fs-xxs mb-0">Gatilho de escassez extrema disparado para esgotar o evento.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card p-3 border h-100 mkt-obj-card" style="cursor: pointer; border-radius: 8px;" onclick="selectCampaignObjective('abandoned_cart', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-3">🛒</span>
                                                <span class="badge bg-success">Resgate</span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Recuperar Carrinhos</h6>
                                            <p class="text-muted fs-xxs mb-0">Resgate automatizado de clientes que não finalizaram o pagamento.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card p-3 border h-100 mkt-obj-card" style="cursor: pointer; border-radius: 8px;" onclick="selectCampaignObjective('reactivate_customers', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-3">🔁</span>
                                                <span class="badge bg-purple" style="background-color: #8b5cf6; color: white;">Reativação</span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Reativar Clientes (+90 dias)</h6>
                                            <p class="text-muted fs-xxs mb-0">Reengaje compradores antigos com novidades e ofertas exclusivas.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card p-3 border h-100 mkt-obj-card" style="cursor: pointer; border-radius: 8px;" onclick="selectCampaignObjective('vip_clients', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fs-3">💎</span>
                                                <span class="badge bg-info">Fidelidade</span>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Clientes VIP &amp; Early Bird</h6>
                                            <p class="text-muted fs-xxs mb-0">Acesso antecipado exclusivo para os compradores mais fiéis.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ETAPA 2: EVENTO -->
                            <div class="mkt-wizard-pane" id="mkt-pane-step-2" style="display: none;">
                                <h5 class="fw-bold text-dark mb-1">2. Selecione o Evento da Campanha</h5>
                                <p class="text-muted fs-xs mb-4">Escolha um evento específico, múltiplos eventos ou todos os eventos ativos.</p>
                                
                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label fs-xs fw-bold text-muted">Pesquisar Evento:</label>
                                        <input type="text" class="form-control" id="wiz-event-search" placeholder="Ex: Festival Summer, Rock Curitiba..." oninput="filterWizardEvents()">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fs-xs fw-bold text-muted">Modo de Seleção:</label>
                                        <select class="form-select" id="wiz-event-scope" onchange="toggleEventScopeSelection(this.value)">
                                            <option value="single">1 Evento Específico</option>
                                            <option value="multiple">Múltiplos Eventos</option>
                                            <option value="all">Todos os Eventos do Produtor</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-3" id="wiz-events-cards-grid">
                                    <!-- Event Card 1 -->
                                    <div class="col-md-6">
                                        <div class="card p-3 border shadow-2xs wiz-event-card active" style="cursor: pointer; border-radius: 8px; border-left: 4px solid #10b981 !important;" onclick="selectWizardEvent(1, this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0">Festival Summer 2026</h6>
                                                <span class="badge bg-success">Em Venda</span>
                                            </div>
                                            <div class="fs-xs text-muted mb-2"><i class="ph-calendar me-1"></i> 20/09/2026 • Arena Premium</div>
                                            <div class="d-flex justify-content-between fs-xs fw-semibold mb-1">
                                                <span>Ocupação da Capacidade:</span>
                                                <span class="text-success">8.420 / 12.000 (70,1%)</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-success" style="width: 70.1%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Event Card 2 -->
                                    <div class="col-md-6">
                                        <div class="card p-3 border shadow-2xs wiz-event-card" style="cursor: pointer; border-radius: 8px;" onclick="selectWizardEvent(2, this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold text-dark mb-0">Show de Rock Curitiba</h6>
                                                <span class="badge bg-primary">Em Venda</span>
                                            </div>
                                            <div class="fs-xs text-muted mb-2"><i class="ph-calendar me-1"></i> 15/10/2026 • Pedreira Paulo Leminski</div>
                                            <div class="d-flex justify-content-between fs-xs fw-semibold mb-1">
                                                <span>Ocupação:</span>
                                                <span class="text-primary">14.200 / 20.000 (71,0%)</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-primary" style="width: 71%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ETAPA 3: PÚBLICO & SEGMENTAÇÃO AVANÇADA -->
                            <div class="mkt-wizard-pane" id="mkt-pane-step-3" style="display: none;">
                                <h5 class="fw-bold text-dark mb-1">3. Definição e Segmentação de Público</h5>
                                <p class="text-muted fs-xs mb-4">Selecione uma audiência pré-existente ou crie uma segmentação combinando múltiplos critérios.</p>
                                
                                <div class="row g-3 mb-3">
                                    <div class="col-md-7">
                                        <label class="form-label fs-xs fw-bold text-muted">Tipo de Audiência:</label>
                                        <select class="form-select" id="wiz-audience-type" onchange="updateEstimatedAudience()">
                                            <option value="all">Todos os Clientes da Base (84.500 contatos)</option>
                                            <option value="virada_lote" selected>Clientes Interessados / Visualizaram Evento (32.480 contatos)</option>
                                            <option value="cart_24h">Carrinhos Abandonados nas últimas 24h (1.428 contatos)</option>
                                            <option value="vip">Compradores VIP (Ticket &gt; R$ 200) (3.450 contatos)</option>
                                            <option value="inactive">Clientes Inativos (+90 dias) (12.480 contatos)</option>
                                            <option value="custom">Segmentação Personalizada...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="p-3 bg-light rounded border text-center">
                                            <span class="fs-xxs text-muted text-uppercase fw-bold d-block">Público Estimado</span>
                                            <h3 class="fw-bold text-primary mb-0" id="wiz-estimated-audience-count">32.480 pessoas</h3>
                                            <span class="fs-xxs text-success"><i class="ph-check-circle me-1"></i> Base 100% qualificada</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Filtros Combináveis -->
                                <div class="card p-3 bg-light border mb-3" style="border-radius: 8px;">
                                    <h6 class="fw-bold text-dark fs-xs mb-2"><i class="ph-funnel text-primary me-1"></i> Filtros Combináveis de Segmentação:</h6>
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label fs-xxs text-muted mb-0">Estado / UF:</label>
                                            <select class="form-select form-select-sm" onchange="updateEstimatedAudience()">
                                                <option value="all">Todos os Estados</option>
                                                <option value="PR" selected>Paraná (PR)</option>
                                                <option value="SP">São Paulo (SP)</option>
                                                <option value="SC">Santa Catarina (SC)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fs-xxs text-muted mb-0">Ticket Médio:</label>
                                            <select class="form-select form-select-sm" onchange="updateEstimatedAudience()">
                                                <option value="all">Qualquer Valor</option>
                                                <option value="high">&gt; R$ 150,00</option>
                                                <option value="low">&lt; R$ 100,00</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fs-xxs text-muted mb-0">Qtd de Compras:</label>
                                            <select class="form-select form-select-sm" onchange="updateEstimatedAudience()">
                                                <option value="all">Qualquer Frequência</option>
                                                <option value="recurrent">Recorrentes (2+ eventos)</option>
                                                <option value="first">Primeira Compra</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <button class="btn btn-sm btn-outline-primary w-100 fw-bold" onclick="alert('Público salvo com sucesso no CRM!')"><i class="ph-floppy-disk me-1"></i> Salvar Público</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ETAPA 4: CANAIS MULTICANAL -->
                            <div class="mkt-wizard-pane" id="mkt-pane-step-4" style="display: none;">
                                <h5 class="fw-bold text-dark mb-1">4. Seleção de Canais de Disparo e Mídia</h5>
                                <p class="text-muted fs-xs mb-4">Selecione um ou mais canais para veicular a campanha simultaneamente.</p>
                                
                                <div class="row g-3 mb-3">
                                    <!-- Channel Card 1: WhatsApp -->
                                    <div class="col-md-4">
                                        <div class="card p-3 border shadow-2xs h-100 mkt-channel-card active" style="cursor: pointer; border-radius: 8px;" onclick="toggleWizardChannel('whatsapp', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <i class="ph-whatsapp-logo text-success fs-2"></i>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wiz-chk-whatsapp" checked>
                                                </div>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-0">WhatsApp Marketing</h6>
                                            <span class="fs-xxs text-success fw-bold">Taxa de Abertura: 89%</span>
                                            <p class="text-muted fs-xxs mt-1 mb-0">Mensagens oficiais Meta Cloud API sem risco de banimento.</p>
                                        </div>
                                    </div>
                                    <!-- Channel Card 2: Meta Ads -->
                                    <div class="col-md-4">
                                        <div class="card p-3 border shadow-2xs h-100 mkt-channel-card active" style="cursor: pointer; border-radius: 8px;" onclick="toggleWizardChannel('meta', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <i class="ph-meta-logo text-primary fs-2"></i>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wiz-chk-meta" checked>
                                                </div>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-0">Meta Ads (CAPI)</h6>
                                            <span class="fs-xxs text-primary fw-bold">Instagram &amp; Facebook Feed</span>
                                            <p class="text-muted fs-xxs mt-1 mb-0">Rastreamento de conversão por pixel e API de servidor.</p>
                                        </div>
                                    </div>
                                    <!-- Channel Card 3: E-mail -->
                                    <div class="col-md-4">
                                        <div class="card p-3 border shadow-2xs h-100 mkt-channel-card active" style="cursor: pointer; border-radius: 8px;" onclick="toggleWizardChannel('email', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <i class="ph-envelope-simple text-info fs-2"></i>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wiz-chk-email" checked>
                                                </div>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-0">E-mail Marketing</h6>
                                            <span class="fs-xxs text-info fw-bold">Baixo custo por disparo</span>
                                            <p class="text-muted fs-xxs mt-1 mb-0">Newsletters responsivas e disparos em massa.</p>
                                        </div>
                                    </div>
                                    <!-- Channel Card 4: Google Ads -->
                                    <div class="col-md-4">
                                        <div class="card p-3 border shadow-2xs h-100 mkt-channel-card" style="cursor: pointer; border-radius: 8px;" onclick="toggleWizardChannel('google', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <i class="ph-google-logo text-danger fs-2"></i>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wiz-chk-google">
                                                </div>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-0">Google Ads</h6>
                                            <span class="fs-xxs text-danger fw-bold">Search &amp; Performance Max</span>
                                            <p class="text-muted fs-xxs mt-1 mb-0">Anúncios no topo das buscas do Google.</p>
                                        </div>
                                    </div>
                                    <!-- Channel Card 5: Push Notification -->
                                    <div class="col-md-4">
                                        <div class="card p-3 border shadow-2xs h-100 mkt-channel-card active" style="cursor: pointer; border-radius: 8px;" onclick="toggleWizardChannel('push', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <i class="ph-bell-ringing text-warning fs-2"></i>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wiz-chk-push" checked>
                                                </div>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-0">Push Notification App</h6>
                                            <span class="fs-xxs text-warning fw-bold">Notificação Direta</span>
                                            <p class="text-muted fs-xxs mt-1 mb-0">Entrega direta nos smartphones com app DiskIngressos.</p>
                                        </div>
                                    </div>
                                    <!-- Channel Card 6: SMS -->
                                    <div class="col-md-4">
                                        <div class="card p-3 border shadow-2xs h-100 mkt-channel-card" style="cursor: pointer; border-radius: 8px;" onclick="toggleWizardChannel('sms', this)">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <i class="ph-chat-circle-dots text-orange fs-2"></i>
                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" id="wiz-chk-sms">
                                                </div>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-0">SMS Marketing</h6>
                                            <span class="fs-xxs text-dark fw-bold">Entrega instantânea</span>
                                            <p class="text-muted fs-xxs mt-1 mb-0">Links curtos rastreados via shortcode direto.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ETAPA 5: CONTEÚDO & IA COPILOT -->
                            <div class="mkt-wizard-pane" id="mkt-pane-step-5" style="display: none;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">5. Criação de Conteúdo &amp; IA Copilot</h5>
                                        <span class="text-muted fs-xs">Defina a mensagem-base e deixe a IA adaptar o texto para cada canal.</span>
                                    </div>
                                    <button class="btn btn-outline-purple btn-sm fw-bold d-flex align-items-center gap-1 border-purple text-purple" onclick="generateCampaignContentWithAI()">
                                        <i class="ph-sparkle"></i> Gerar com IA
                                    </button>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-7">
                                        <div class="mb-3">
                                            <label class="form-label fs-xs fw-bold text-muted">Título da Campanha:</label>
                                            <input type="text" class="form-control" id="wiz-content-title" value="Virada de Lote — Festival Summer 2026">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fs-xs fw-bold text-muted">Mensagem Principal (Base):</label>
                                            <textarea class="form-control" rows="4" id="wiz-content-body">🔥 Últimos ingressos antes da virada de lote! O Festival Summer 2026 está com mais de 70% dos ingressos vendidos. Garanta o seu lugar com preço de 1º lote antes que aumente.</textarea>
                                        </div>
