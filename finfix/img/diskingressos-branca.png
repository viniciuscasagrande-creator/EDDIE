                            <span class="fs-xs text-muted">Segmentação de Canais de Entrada</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="card shadow-sm border h-100">
                                    <div class="card-header bg-transparent border-bottom py-2">
                                        <h6 class="fw-bold mb-0 text-dark">Arrecadação por Canal</h6>
                                    </div>
                                    <div class="card-body p-0">
