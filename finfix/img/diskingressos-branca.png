                    <!-- SEÇÃO: TESOURARIA OPERACIONAL & BANCOS (Fase 26.17.9.4.6) -->
                    <section id="view-treasury" class="page-section" style="display:none;">
                        <!-- Top Action Bar -->
                        <div class="card card-body shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 py-2 mb-3" style="border-radius: 6px;">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Tesouraria Operacional &amp; Bancos</h5>
                                <div class="text-muted fs-xs">Financeiro &bull; Gestão de contas bancárias reais, pagamentos PIX instantâneos, remessas CNAB 240/400 e conciliação bancária</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center w-100 w-md-auto">
                                <button class="btn btn-outline-light text-dark border fw-bold d-flex align-items-center gap-1" onclick="window.refreshTreasuryData()" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-arrows-clockwise"></i> Atualizar
                                </button>
                                <button class="btn btn-outline-primary fw-bold d-flex align-items-center gap-1" onclick="window.openNewBankAccountModal()" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px;">
                                    <i class="ph-bank"></i> Nova Conta Bancária
                                </button>
                                <button class="btn btn-info text-white fw-bold d-flex align-items-center gap-1" onclick="window.openCreateTreasuryBatchModal()" style="height: 36px; padding: 6px 12px; border-radius: 6px; font-size: 13px; background-color: #0284c7; border-color: #0284c7;">
                                    <i class="ph-stack"></i> Criar Lote CNAB
                                </button>
                                <button class="btn btn-success fw-bold d-flex align-items-center gap-1" onclick="window.openNewPixPaymentModal()" style="height: 36px; padding: 6px 14px; border-radius: 6px; font-size: 13px; background-color: #00a65a; border-color: #008d4c;">
                                    <i class="ph-paper-plane-tilt"></i> Novo Pagamento PIX
                                </button>
                            </div>
                        </div>

                        <!-- Banner de Separação Tríplice de Contas -->
                        <div class="card shadow-sm mb-3 border-0" style="background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%); border-left: 5px solid #3b82f6 !important;">
                            <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle bg-white shadow-sm p-2 text-primary d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                        <i class="ph-shield-check fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-sm d-flex align-items-center gap-2">
                                            Separação Tríplice Mandatória &bull; Governança Financeira SafeSaff
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-xs">Fase 26.17.9.4.6</span>
                                        </div>
                                        <div class="text-secondary fs-xs mt-1">
                                            <strong>Conta Contábil (Ledger)</strong>: propriedade econômica &bull; 
                                            <strong>Conta Bancária Física</strong>: onde os fundos reais residem (Itaú, BB, Bradesco) &bull; 
                                            <strong>Saldo por Evento</strong>: sub-contas virtuais com reserva para despesas e repasses.
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success text-white px-3 py-2 fs-xs fw-semibold shadow-sm d-flex align-items-center gap-1">
                                        <i class="ph-lock-key fs-sm"></i> Maker / Checker Ativo
                                    </span>
                                    <span class="badge bg-white text-muted border px-2 py-2 fs-xs">
                                        <i class="ph-check-circle text-success me-1"></i> Anti-Duplicidade
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- 6 KPIs Consolidados da Tesouraria -->
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #3b82f6 !important;">
                                    <span class="fs-xs fw-bold text-uppercase text-muted">Saldo Bancário Total</span>
                                    <h5 class="fw-bold mb-0 mt-2 text-dark" id="trz-kpi-total-balance">R$ 0,00</h5>
                                    <span class="fs-xs text-muted mt-1">Todas as contas</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #10b981 !important; background: #f0fdf4;">
                                    <span class="fs-xs fw-bold text-uppercase text-success">Disponível em Bancos</span>
                                    <h5 class="fw-bold mb-0 mt-2 text-success" id="trz-kpi-avail-balance">R$ 0,00</h5>
                                    <span class="fs-xs text-muted mt-1">Livre para pagamentos</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #f59e0b !important;">
                                    <span class="fs-xs fw-bold text-uppercase text-muted">Saídas Hoje</span>
                                    <h5 class="fw-bold mb-0 mt-2 text-dark" id="trz-kpi-today-outflow">R$ 0,00</h5>
                                    <span class="fs-xs text-muted mt-1">Pagamentos projetados</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #8b5cf6 !important;">
                                    <span class="fs-xs fw-bold text-uppercase text-muted">PIX Pendentes</span>
                                    <h5 class="fw-bold mb-0 mt-2 text-dark" id="trz-kpi-pending-pix">0</h5>
