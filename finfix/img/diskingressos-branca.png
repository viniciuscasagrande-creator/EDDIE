                                        <div class="card shadow-sm border mb-4">
                                            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark"><i class="ph-shield-check text-secondary me-2"></i>Trilha Append-Only de Decisões e Liquidações</h6>
                                                    <span class="fs-xs text-muted">Logs imutáveis com ator, alçada, correlationId e autenticação eletrônica</span>
                                                </div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0 fs-xs" id="table-financeiro-audit">
