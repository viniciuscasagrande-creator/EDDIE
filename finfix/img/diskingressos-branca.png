                                        <i class="ph-funnel me-1"></i> Aplicar Filtros
                                    </button>
                                    <button class="btn btn-sm btn-light border" onclick="resetMarketingFilters()" title="Limpar Filtros">
                                        <i class="ph-x"></i>
                                    </button>
                                </div>
