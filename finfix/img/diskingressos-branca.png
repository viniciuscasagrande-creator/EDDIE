                                                <span><i class="ph-barcode menu-icon"></i> Boletos</span>
                                                <i class="ph-chevron-right chevron-icon"></i>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-muted" href="#" onclick="window.switchGatewayTab(event, 'installment')">
                                                <span><i class="ph-calculator menu-icon"></i> Parcelamento</span>
                                                <i class="ph-chevron-right chevron-icon"></i>
                                            </a>
