                                                    <option value="GET /contabilidade">GET /contabilidade</option>
                                                    <option value="GET /dre">GET /dre</option>
                                                    <option value="GET /balanco">GET /balanco</option>
                                                    <option value="GET /balancete">GET /balancete</option>
                                                    <option value="GET /livro-diario">GET /livro-diario</option>
                                                    <option value="GET /livro-razao">GET /livro-razao</option>
                                                    <option value="GET /repasses">GET /repasses</option>
                                                    <option value="POST /repasses">POST /repasses</option>
                                                    <option value="GET /conciliacao">GET /conciliacao</option>
                                                    <option value="POST /conciliacao">POST /conciliacao</option>
                                                    <option value="GET /auditoria">GET /auditoria</option>
                                                    <option value="GET /inteligencia">GET /inteligencia</option>
                                                </select>
                                            </div>
