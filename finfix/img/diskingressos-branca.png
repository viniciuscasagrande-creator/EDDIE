                            <!-- Content Area -->
                            <div class="col-md-9">
                                <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px; min-height: 520px; display: flex; flex-direction: column;">
                                    
                                    <!-- TAB 1: Configurações Gerais -->
                                    <div class="gateway-tab-pane" id="gw-tab-config" style="display: block;">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="ph-sliders me-1 text-primary"></i> Configurações Gerais</h6>
                                        <div class="row g-3 text-start">
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-main-provider">Gateway Principal</label>
                                                <div class="input-group">
                                                    <select class="form-select form-select-sm fw-semibold" id="gw-main-provider" onchange="window.onGatewayProviderChange(this.value)">
                                                        <option value="Mercado Pago" selected>Mercado Pago (Taxa 1.99%)</option>
                                                        <option value="Cielo">Cielo S.A. (Taxa 2.10%)</option>
                                                        <option value="Rede">Rede Card (Taxa 2.15%)</option>
                                                        <option value="Stone">Stone Pagamentos (Taxa 1.95%)</option>
                                                        <option value="PagSeguro">PagSeguro UOL (Taxa 2.30%)</option>
                                                        <option value="Pagar.me">Pagar.me Stone (Taxa 2.05%)</option>
                                                    </select>
                                                    <button class="btn btn-primary btn-sm fw-bold px-3" type="button" onclick="openModal('add-new-gateway-modal')" style="font-size: 11px;"><i class="ph-plus-circle me-1"></i> Novo Gateway</button>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-env">Ambiente</label>
                                                <select class="form-select form-select-sm" id="gw-config-env">
                                                    <option value="sandbox">Sandbox (Ambiente de Testes)</option>
                                                    <option value="production" selected>Produção (Ambiente Real)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-company">Empresa</label>
                                                <input type="text" class="form-control form-control-sm" id="gw-config-company" value="DiskIngressos Entretenimento S.A.">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-branch">Filial</label>
                                                <input type="text" class="form-control form-control-sm" id="gw-config-branch" value="Filial Curitiba Centro">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-status">Status</label>
                                                <select class="form-select form-select-sm" id="gw-config-status">
                                                    <option value="ativo" selected>Ativo</option>
                                                    <option value="inativo">Inativo</option>
                                                </select>
                                            </div>
                                            <div class="col-md-8">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1">Tipo de Integração</label>
                                                <div class="d-flex flex-wrap gap-2 mt-1">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="gw-config-integration" id="int-api-rest" value="API REST" checked>
                                                        <label class="form-check-label fs-xs" for="int-api-rest">API REST</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="gw-config-integration" id="int-tef-rest" value="TEF">
                                                        <label class="form-check-label fs-xs" for="int-tef-rest">TEF</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="gw-config-integration" id="int-pos-rest" value="POS">
                                                        <label class="form-check-label fs-xs" for="int-pos-rest">POS</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="gw-config-integration" id="int-link-rest" value="Link de Pagamento">
                                                        <label class="form-check-label fs-xs" for="int-link-rest">Link de Pagamento</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-timeout">Timeout da API (Segundos)</label>
                                                <input type="number" class="form-control form-control-sm font-monospace" id="gw-config-timeout" value="30" min="1" max="120">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-currency">Moeda</label>
                                                <select class="form-select form-select-sm" id="gw-config-currency">
                                                    <option value="BRL" selected>Real Brasileiro (R$)</option>
                                                    <option value="USD">Dólar Americano ($)</option>
                                                    <option value="EUR">Euro (€)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-timezone">Fuso Horário</label>
                                                <select class="form-select form-select-sm" id="gw-config-timezone">
                                                    <option value="GMT-3" selected>Brasília (GMT-3)</option>
                                                    <option value="GMT-4">Manaus (GMT-4)</option>
                                                    <option value="UTC">UTC (Zero)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-url">URL da API</label>
                                                <input type="url" class="form-control form-control-sm font-monospace" id="gw-config-url" value="https://api.mercadopago.com/v1">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-config-webhook">URL do Webhook</label>
                                                <input type="url" class="form-control form-control-sm font-monospace" id="gw-config-webhook" value="https://erp.diskingressos.com.br/api/gateway/callback">
                                            </div>
                                        </div>
                                        <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                                            <button class="btn btn-success btn-sm fw-bold" onclick="window.setGatewayActiveStatus(true)"><i class="ph-circle-fill me-1 fs-xxs"></i> Ativar Gateway</button>
                                            <button class="btn btn-outline-danger btn-sm fw-semibold" onclick="window.setGatewayActiveStatus(false)"><i class="ph-x-circle me-1"></i> Desativar Gateway</button>
                                            <button class="btn btn-outline-secondary btn-sm fw-semibold" onclick="window.restoreGatewayDefaults()"><i class="ph-arrow-counter-clockwise me-1"></i> Restaurar Configurações</button>
                                            <button class="btn btn-primary btn-sm fw-bold px-3" onclick="window.saveGatewayGeneralConfig()"><i class="ph-check me-1"></i> Salvar</button>
                                        </div>
                                    </div>

                                    <!-- TAB 2: Credenciais -->
                                    <div class="gateway-tab-pane" id="gw-tab-credentials" style="display: none;">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="ph-key me-1 text-primary"></i> Credenciais de Autenticação</h6>
                                        <div class="row g-3 text-start">
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-merchant-id">Merchant ID</label>
                                                <input type="text" class="form-control form-control-sm font-monospace" id="gw-merchant-id" value="mp_mch_92384110">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-merchant-key">Merchant Key</label>
                                                <input type="password" class="form-control form-control-sm font-monospace" id="gw-merchant-key" value="••••••••••••••••••••••••••••••••">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-api-key">API Key</label>
                                                <input type="password" class="form-control form-control-sm font-monospace" id="gw-api-key" value="••••••••••••••••••••••••••••••••">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-secret-key">Secret Key</label>
                                                <input type="password" class="form-control form-control-sm font-monospace" id="gw-secret-key" value="••••••••••••••••••••••••••••••••">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-client-id">Client ID</label>
                                                <input type="text" class="form-control form-control-sm font-monospace" id="gw-client-id" value="cli_client_id_prod_88293">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-client-secret">Client Secret</label>
                                                <input type="password" class="form-control form-control-sm font-monospace" id="gw-client-secret" value="••••••••••••••••••••••••••••••••">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-webhook-secret">Webhook Secret</label>
                                                <input type="text" class="form-control form-control-sm font-monospace" id="gw-webhook-secret" value="whsec_88f91c28b3a0e1">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-public-token">Token Público</label>
                                                <input type="password" class="form-control form-control-sm font-monospace" id="gw-public-token" value="••••••••••••••••••••••••••••••••">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-private-token">Token Privado</label>
                                                <input type="password" class="form-control form-control-sm font-monospace" id="gw-private-token" value="••••••••••••••••••••••••••••••••">
                                            </div>
                                        </div>
                                        <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                                            <button class="btn btn-outline-primary btn-sm fw-bold" onclick="window.validateGatewayCredentials()"><i class="ph-fingerprint me-1"></i> Validar Credenciais</button>
                                            <button class="btn btn-outline-secondary btn-sm fw-semibold" onclick="window.generateNewAPIToken()"><i class="ph-key-return me-1"></i> Gerar Novo Token</button>
                                            <button class="btn btn-outline-info btn-sm fw-semibold" onclick="window.copyPrivateAPIToken()"><i class="ph-copy me-1"></i> Copiar Token</button>
                                            <button class="btn btn-primary btn-sm fw-bold px-3" onclick="window.saveGatewayCredentials()"><i class="ph-check me-1"></i> Salvar</button>
                                        </div>
                                    </div>

                                    <!-- TAB 3: Cartões Aceitos -->
                                    <div class="gateway-tab-pane" id="gw-tab-cards" style="display: none;">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="ph-credit-card me-1 text-primary"></i> Cartões e Bandeiras Aceitas</h6>
                                        <div class="row g-3 text-start mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-2">Bandeiras Habilitadas</label>
                                                <div class="row g-2" id="gw-cards-brand-checks">
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input brand-check-item" type="checkbox" id="c-visa" checked>
                                                            <label class="form-check-label fs-xs" for="c-visa">Visa</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-master" checked>
                                                            <label class="form-check-label fs-xs" for="c-master">Mastercard</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-elo" checked>
                                                            <label class="form-check-label fs-xs" for="c-elo">Elo</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-amex" checked>
                                                            <label class="form-check-label fs-xs" for="c-amex">Amex</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-hipercard" checked>
                                                            <label class="form-check-label fs-xs" for="c-hipercard">Hipercard</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-diners" checked>
                                                            <label class="form-check-label fs-xs" for="c-diners">Diners</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-discover" checked>
                                                            <label class="form-check-label fs-xs" for="c-discover">Discover</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="c-cabal" checked>
                                                            <label class="form-check-label fs-xs" for="c-cabal">Cabal</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-2">Recursos da Operadora</label>
                                                <div class="row g-2">
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-debito" checked>
                                                            <label class="form-check-label fs-xs" for="feat-debito">Débito</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-credito" checked>
                                                            <label class="form-check-label fs-xs" for="feat-credito">Crédito</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-preauth" checked>
                                                            <label class="form-check-label fs-xs" for="feat-preauth">Pré-Autorização</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-recorrencia" checked>
                                                            <label class="form-check-label fs-xs" for="feat-recorrencia">Recorrência</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-tokenizacao" checked>
                                                            <label class="form-check-label fs-xs" for="feat-tokenizacao">Tokenização</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-3ds" checked>
                                                            <label class="form-check-label fs-xs" for="feat-3ds">3DS Ativo</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="feat-cvv" checked>
                                                            <label class="form-check-label fs-xs" for="feat-cvv">CVV Obrigatório</label>
                                                        </div>
