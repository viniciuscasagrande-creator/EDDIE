                                                    <span class="badge bg-success fs-xs">NORMAL</span>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="fw-bold fs-xs text-muted text-uppercase mb-2">Evento Destino (Em Risco)</div>
                                                <div class="d-flex justify-content-around">
                                                    <div>
                                                        <span class="fs-xs text-muted">Menor Saldo Antes</span>
                                                        <div class="fw-bold fs-sm text-danger mt-1" id="sim-res-target-before">-R$ 0,00</div>
                                                    </div>
                                                    <i class="ph-arrow-right text-muted align-self-center"></i>
                                                    <div>
                                                        <span class="fs-xs text-muted">Menor Saldo Depois</span>
                                                        <div class="fw-bold fs-sm text-success mt-1" id="sim-res-target-after">R$ 0,00</div>
                                                    </div>
                                                </div>
                                                <div class="mt-2" id="sim-res-target-risk-badge">
                                                    <span class="badge bg-success fs-xs">NORMAL</span>
                                                </div>
                                            </div>
                                        </div>
