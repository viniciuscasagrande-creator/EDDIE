                                <ul class="nav nav-tabs card-header-tabs" id="taxas-tabs" role="tablist">
                                    <li class="nav-item">
                                        <button class="nav-link active fs-xs fw-semibold" id="tab-taxas-regras" data-bs-toggle="tab" data-bs-target="#pane-taxas-regras" type="button" role="tab">
