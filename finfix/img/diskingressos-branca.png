            <div class="modal-header text-white py-3 bg-dark" style="display: flex; justify-content: space-between; align-items: center; width: 100%; border-bottom: 1px solid rgba(0,0,0,0.08);">
                <span class="modal-title fw-bold" style="color: #fff;"><i class="ph-storefront me-2"></i> Cadastrar Novo PDV Completo</span>
                <button class="btn-close-modal" type="button" onclick="closeModal('add-new-pdv-modal')" style="color: #fff; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
            </div>
            <form id="modal-add-new-pdv-form" onsubmit="window.saveNewCompletePDV(event)">
                <div class="modal-body p-4 text-start" style="max-height: 400px; overflow-y: auto;">
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="add-pdv-name">Nome do Ponto de Venda (PDV):</label>
                        <input type="text" class="form-control form-control-sm" id="add-pdv-name" placeholder="Ex: Shopping Estação, Teatro Guaírinha" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="add-pdv-ops">Qtd Operadores:</label>
                            <input type="number" class="form-control form-control-sm" id="add-pdv-ops" value="1" min="0" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="add-pdv-caixas">Qtd Caixas Físicos:</label>
                            <input type="number" class="form-control form-control-sm" id="add-pdv-caixas" value="1" min="0" required>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="add-pdv-operator-name">Operador Responsável:</label>
                            <input type="text" class="form-control form-control-sm" id="add-pdv-operator-name" value="Operador Padrão" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="add-pdv-status">Status Inicial:</label>
                            <select class="form-select form-select-sm fw-semibold" id="add-pdv-status" required>
                                <option value="🟢" selected>🟢 Online</option>
                                <option value="🔴">🔴 Offline</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="add-pdv-time">Tempo Médio de Atendimento:</label>
                        <input type="text" class="form-control form-control-sm font-monospace" id="add-pdv-time" value="01:30" placeholder="Ex: 01:25" required>
                    </div>
                    <h6 class="fw-bold text-dark border-bottom pb-1 mb-2 fs-xs text-uppercase text-muted">Faturamento Inicial por Forma de Pagamento</h6>
                    <div class="row g-2">
                        <div class="col-6 mb-2">
                            <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-0.5" for="add-pdv-pix">PIX (R$):</label>
                            <input type="number" step="0.01" class="form-control form-control-sm font-monospace" id="add-pdv-pix" value="0.00" required>
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-0.5" for="add-pdv-credit">Crédito (R$):</label>
                            <input type="number" step="0.01" class="form-control form-control-sm font-monospace" id="add-pdv-credit" value="0.00" required>
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-0.5" for="add-pdv-debit">Débito (R$):</label>
                            <input type="number" step="0.01" class="form-control form-control-sm font-monospace" id="add-pdv-debit" value="0.00" required>
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-0.5" for="add-pdv-cash">Dinheiro (R$):</label>
                            <input type="number" step="0.01" class="form-control form-control-sm font-monospace" id="add-pdv-cash" value="0.00" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light btn-sm" onclick="closeModal('add-new-pdv-modal')">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold"><i class="ph-check me-1"></i> Adicionar PDV</button>
                </div>
            </form>
        </div>
    </div>

