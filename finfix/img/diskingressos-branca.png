                    <!-- VIEW: Financeiro - Simulador de Spread -->
                    <section id="view-financial-simulator" class="page-section"  style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-row justify-content-between align-items-center py-2 mb-3" style="border-radius: 6px;">
                            <h5 class="fw-bold mb-0 text-dark"><i class="ph-calculator me-1 text-primary"></i> Simulador de Spread</h5>
                            <span class="fs-xs text-muted">Simule taxas, adiantamentos e lucros líquidos por venda</span>
                        </div>
                        
                        <div class="row g-3">
                            <!-- Input Column -->
                            <div class="col-md-6">
                                <div class="card shadow-sm p-3" style="border-radius: 8px;">
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="ph-pencil text-primary me-2"></i> Parâmetros de Simulação</h6>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="sim-sale-value">Valor da Venda (R$)</label>
                                        <input type="number" id="sim-sale-value" class="form-control form-control-sm fw-bold" value="500.00" min="1" step="0.01">
                                    </div>
                                    
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="sim-installments">Parcelas</label>
                                            <select id="sim-installments" class="form-select form-select-sm fw-semibold" title="Quantidade de parcelas">
                                                <option value="1">1x à Vista</option>
                                                <option value="2">2x Sem Juros</option>
                                                <option value="3">3x Sem Juros</option>
                                                <option value="4">4x Sem Juros</option>
                                                <option value="5">5x Sem Juros</option>
                                                <option value="6">6x Sem Juros</option>
                                                <option value="10" selected>10x Sem Juros</option>
                                                <option value="12">12x Sem Juros</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="sim-anticipation">Antecipação Automática</label>
                                            <select id="sim-anticipation" class="form-select form-select-sm fw-semibold" title="Configuração de antecipação">
                                                <option value="yes" selected>Sim (Antecipado)</option>
                                                <option value="no">Não (Recebe parcelado)</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="sim-gateway-tax">Taxa Gateway (%)</label>
                                            <input type="number" id="sim-gateway-tax" class="form-control form-control-sm" value="1.80" step="0.01">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="sim-card-tax">Taxa Cartão (%)</label>
                                            <input type="number" id="sim-card-tax" class="form-control form-control-sm" value="3.20" step="0.01">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="sim-platform-tax">Comissão Disk (%)</label>
                                            <input type="number" id="sim-platform-tax" class="form-control form-control-sm" value="8.00" step="0.01">
                                        </div>
                                    </div>
                                    
                                    <button class="btn btn-orange text-white fw-bold w-100 py-2 mt-2" onclick="window.runSpreadSimulation()"><i class="ph-calculator me-1"></i> Calcular Spread</button>
                                </div>
                            </div>
                            
                            <!-- Output Column -->
                            <div class="col-md-6">
                                <div class="card shadow-sm bg-dark text-white p-3 h-100 d-flex flex-column justify-content-between" style="border-radius: 8px;">
                                    <div>
                                        <h6 class="fw-bold text-white border-bottom border-secondary pb-2 mb-3"><i class="ph-scales text-warning me-2"></i> Resultado da Simulação</h6>
                                        
                                        <div class="d-flex flex-column gap-3 py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-sm opacity-75">Receita Bruta</span>
                                                <h5 class="fw-bold mb-0 text-white" id="sim-out-bruta">R$ 500,00</h5>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-sm opacity-75">Taxas Operacionais (Cartão + Gateway)</span>
                                                <h6 class="fw-bold mb-0 text-danger" id="sim-out-ops">- R$ 25,00</h6>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-sm opacity-75">Comissão DiskIngressos (8%)</span>
                                                <h6 class="fw-bold mb-0 text-danger" id="sim-out-disk">- R$ 40,00</h6>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-sm opacity-75">Custo de Antecipação (10 parcelas)</span>
                                                <h6 class="fw-bold mb-0 text-danger" id="sim-out-ant">- R$ 29,20</h6>
                                            </div>
                                            
                                            <hr class="border-secondary my-1">
                                            
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fs-sm fw-bold text-success">Lucro Líquido Recebido</span>
                                                <h4 class="fw-bold mb-0 text-success" id="sim-out-lucro">R$ 405,80</h4>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="bg-secondary bg-opacity-25 p-3 rounded d-flex justify-content-between align-items-center mt-3">
                                        <div class="d-flex flex-column">
                                            <span class="fs-xxs text-uppercase opacity-75">Spread Efetivo</span>
                                            <span class="fs-xs opacity-50">Tarifa total retida pela plataforma</span>
                                        </div>
                                        <h3 class="fw-bold text-warning mb-0" id="sim-out-spread">18,84 %</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- VIEW: Financeiro - Split Financeiro -->
                    <section id="view-financial-split" class="page-section"  style="display:none;">
                        <div class="card card-body shadow-sm d-flex flex-row justify-content-between align-items-center py-2 mb-3" style="border-radius: 6px;">
                            <h5 class="fw-bold mb-0 text-dark"><i class="ph-arrows-split me-1 text-primary"></i> Split Financeiro</h5>
                            <span class="fs-xs text-muted">Divisão de receitas automatizada entre parceiros</span>
                        </div>
                        
                        <div class="row g-3">
                            <!-- Left calculator/input of split -->
                            <div class="col-md-7">
                                <div class="card shadow-sm p-3" style="border-radius: 8px;">
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                        <h6 class="fw-bold text-dark mb-0"><i class="ph-calculator text-primary me-2"></i> Configurar Venda para Divisão</h6>
                                        <span class="fs-xxs text-muted">Preencha o valor da venda para simular a partilha</span>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-1" for="split-input-value">Valor de Venda (R$)</label>
                                        <div class="input-group">
                                            <span class="input-group-text fw-bold bg-light">R$</span>
                                            <input type="number" id="split-input-value" class="form-control form-control-lg fw-bold text-primary" value="1000.00" oninput="window.updateSplitCalculation()">
                                        </div>
                                    </div>
                                    
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="ph-users text-primary me-2"></i> Beneficiários Cadastrados</h6>
                                    
                                    <!-- Beneficiaries list with progress and dynamically updated values -->
                                    <div class="d-flex flex-column gap-3">
                                        <div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fs-sm fw-bold text-dark">Organizador (Principal)</span>
                                                <span class="fs-sm text-muted"><span class="fw-bold text-dark">70%</span> | <span class="fw-bold text-primary" id="split-out-org">R$ 700,00</span></span>
                                            </div>
                                            <div class="progress" style="height: 8px;"><div class="progress-bar bg-primary" style="width: 70%;"></div></div>
                                        </div>
                                        <div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fs-sm fw-bold text-dark">Afiliado / Coprodutor</span>
                                                <span class="fs-sm text-muted"><span class="fw-bold text-dark">10%</span> | <span class="fw-bold text-primary" id="split-out-afi">R$ 100,00</span></span>
                                            </div>
                                            <div class="progress" style="height: 8px;"><div class="progress-bar bg-info" style="width: 10%;"></div></div>
                                        </div>
                                        <div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fs-sm fw-bold text-dark">Produtor Artístico</span>
                                                <span class="fs-sm text-muted"><span class="fw-bold text-dark">15%</span> | <span class="fw-bold text-primary" id="split-out-prod">R$ 150,00</span></span>
                                            </div>
                                            <div class="progress" style="height: 8px;"><div class="progress-bar bg-warning" style="width: 15%;"></div></div>
                                        </div>
                                        <div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="fs-sm fw-bold text-dark">Plataforma DiskIngressos</span>
                                                <span class="fs-sm text-muted"><span class="fw-bold text-dark">5%</span> | <span class="fw-bold text-primary" id="split-out-disk">R$ 50,00</span></span>
                                            </div>
                                            <div class="progress" style="height: 8px;"><div class="progress-bar bg-success" style="width: 5%;"></div></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Right checklist and split info -->
                            <div class="col-md-5">
                                <div class="card shadow-sm border p-3 h-100 d-flex flex-column justify-content-between" style="border-radius: 8px;">
                                    <div>
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="ph-shield-check text-success me-2"></i> Recursos do Split Financeiro</h6>
                                        <div class="d-flex flex-column gap-3 my-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="ph-check-circle text-success fs-base"></i>
                                                <div>
                                                    <span class="fs-sm fw-bold text-dark d-block">Split Automático</span>
                                                    <span class="fs-xxs text-muted">A divisão ocorre no momento exato em que a venda é aprovada no gateway.</span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="ph-check-circle text-success fs-base"></i>
                                                <div>
                                                    <span class="fs-sm fw-bold text-dark d-block">PIX Automático</span>
                                                    <span class="fs-xxs text-muted">O repasse para os beneficiários é creditado instantaneamente na conta cadastrada.</span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="ph-check-circle text-success fs-base"></i>
                                                <div>
                                                    <span class="fs-sm fw-bold text-dark d-block">Agendamento Flexível</span>
