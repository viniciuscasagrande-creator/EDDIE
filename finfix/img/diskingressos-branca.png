    <!-- Core Script files referencing local Limitless libraries -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="assets/js/bootstrap/bootstrap.bundle.min.js?v=20260714"></script>
    <script src="limitless_assets/js/app.js?v=20260714"></script>
    <!-- MODAL: RASTREABILIDADE CONTABIL POR TRANSACAO -->
    <div class="modal-overlay" id="modal-rastreabilidade-transacao" style="display: none;">
        <div class="modal-content" style="max-width: 780px; border-radius: 10px;">
            <div class="modal-header text-white py-3 bg-dark" style="display: flex; justify-content: space-between; align-items: center; width: 100%; border-bottom: 1px solid rgba(0,0,0,0.08);">
                <div class="d-flex align-items-center gap-2">
                    <i class="ph-tree-structure fs-5 text-warning"></i>
                    <span class="modal-title fw-bold" style="color: #fff;" id="modal-rastreio-title">Razão Contábil por Transação — Pedido #123456</span>
                </div>
                <button class="btn-close-modal" type="button" onclick="closeModal('rastreabilidade-transacao')" style="color: #fff; background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
            </div>
            <div class="modal-body p-4 text-start bg-light">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <div class="border rounded p-2.5 bg-white shadow-xs">
                            <span class="fs-xxs text-muted text-uppercase d-block fw-bold">Cliente / Pagamento:</span>
                            <strong class="text-dark fs-xs d-block" id="modal-rastreio-cliente">Mariana S. Albuquerque</strong>
                            <span class="fs-xxs text-muted">Cartão de Crédito (Stone D+1)</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2.5 bg-white shadow-xs">
                            <span class="fs-xxs text-muted text-uppercase d-block fw-bold">Evento & Produtor:</span>
                            <strong class="text-dark fs-xs d-block text-truncate" id="modal-rastreio-evento">Show de Rock Curitiba</strong>
                            <span class="fs-xxs text-primary">Opus Entretenimento</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2.5 bg-white shadow-xs">
                            <span class="fs-xxs text-muted text-uppercase d-block fw-bold">Data & Hora Venda:</span>
                            <strong class="text-dark fs-xs d-block font-monospace" id="modal-rastreio-data">30/06/2026 14:23:18</strong>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 fs-xxs">AUTORIZADO</span>
                        </div>
                    </div>
                </div>

                <div class="card p-3 shadow-xs border mb-3 bg-white">
                    <h6 class="fw-bold text-dark mb-2 fs-xs border-bottom pb-1"><i class="ph-calculator me-1 text-primary"></i> Decomposição Financeira & Split de Valores</h6>
                    <div class="row g-2 font-monospace fs-xxs">
