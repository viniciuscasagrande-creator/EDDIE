                                        <li class="nav-item">
                                            <a class="nav-link text-muted" href="#" onclick="window.switchGatewayTab(event, 'logs')">
                                                <span><i class="ph-terminal-window menu-icon"></i> Logs</span>
                                                <i class="ph-chevron-right chevron-icon"></i>
