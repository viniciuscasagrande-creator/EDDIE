                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light btn-sm" onclick="closeModal('new-negotiation')">Cancelar</button>
                    <button type="submit" class="btn btn-orange btn-sm text-white fw-bold"><i class="ph-floppy-disk me-1"></i> Gravar Negociação</button>
                </div>
            </form>
        </div>
