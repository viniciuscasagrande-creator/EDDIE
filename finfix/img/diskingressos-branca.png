                                                    <div class="mb-2">
                                                        <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Valor da Venda (R$)</label>
                                                        <input type="number" class="form-control form-control-sm font-monospace" id="sim-gw-amount" value="100.00" step="5">
                                                    </div>
                                                    <div class="row g-2 mb-2">
                                                        <div class="col-6">
                                                            <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Adquirente</label>
                                                            <select class="form-select form-select-sm" id="sim-gw-acquirer">
                                                                <option value="Cielo">Cielo</option>
                                                                <option value="Rede">Rede</option>
                                                                <option value="Stone">Stone</option>
                                                                <option value="PagBank">PagBank</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label fs-xxs text-uppercase text-muted fw-bold mb-1">Bandeira</label>
