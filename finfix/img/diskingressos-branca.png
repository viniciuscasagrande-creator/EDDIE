                        <div class="row g-3">
                            <!-- Left: Issuance Form -->
                            <div class="col-lg-5">
                                <div class="card border shadow-sm h-100" style="border-radius: 6px;">
                                    <div class="card-header bg-light bg-opacity-20 border-bottom py-3">
                                        <h6 class="card-title fw-bold mb-0 text-dark"><i class="ph-paper-plane-tilt me-2 text-purple" style="color: #7c3aed;"></i> Emitir Nova Cortesia</h6>
                                    </div>
                                    <div class="card-body">
                                        <form id="event-cortesia-issuance-form">
                                            <div class="mb-3">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-sector">Setor / Modalidade:</label>
                                                <select class="form-select form-select-sm fw-semibold" id="cortesia-form-sector" required title="Setor do ingresso cortesia">
                                                    <option value="Pista">Pista</option>
                                                    <option value="Pista Premium">Pista Premium</option>
                                                    <option value="Camarote">Camarote</option>
                                                    <option value="VIP Especial">VIP Especial</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-reason">Motivo da Cortesia:</label>
                                                <select class="form-select form-select-sm fw-semibold" id="cortesia-form-reason" required title="Motivo do convite">
                                                    <option value="Patrocinador">Patrocinador</option>
                                                    <option value="Imprensa / Divulgação">Imprensa / Divulgação</option>
                                                    <option value="Artista / Staff">Artista / Staff</option>
                                                    <option value="Cortesia Promocional">Cortesia Promocional</option>
                                                    <option value="Relações Públicas">Relações Públicas</option>
                                                </select>
                                            </div>
                                            <!-- Toggle Non-Nominal -->
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" id="cortesia-form-non-nominal" onchange="window.toggleNonNominalFields(this.checked)">
                                                <label class="form-check-label fs-xs fw-bold text-purple" for="cortesia-form-non-nominal"><i class="ph-ticket me-1"></i> Emissão Não Nominal</label>
                                            </div>

                                            <div id="cortesia-nominal-fields-wrapper">
                                                <div class="mb-3">
                                                    <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-name">Nome do Beneficiário:</label>
                                                    <input type="text" class="form-control form-control-sm" id="cortesia-form-name" placeholder="Nome completo" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-email">E-mail para Envio:</label>
                                                    <input type="email" class="form-control form-control-sm" id="cortesia-form-email" placeholder="beneficiario@email.com" required>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-cpf">CPF:</label>
                                                        <input type="text" class="form-control form-control-sm" id="cortesia-form-cpf" placeholder="000.000.000-00">
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-qty">Quantidade:</label>
                                                        <input type="number" class="form-control form-control-sm" id="cortesia-form-qty" value="1" min="1" max="10" required>
                                                    </div>
                                                </div>
                                                <div class="form-check mb-4">
                                                    <input class="form-check-input" type="checkbox" id="cortesia-form-send-email" checked>
                                                    <label class="form-check-label fs-xs text-muted" for="cortesia-form-send-email">
                                                        Disparar e-mail automático com o QR Code
                                                    </label>
                                                </div>
                                            </div>

                                            <div id="cortesia-non-nominal-fields-wrapper" style="display: none;">
                                                <div class="row g-2 mb-3">
                                                    <div class="col-md-12">
                                                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="cortesia-form-qty-non-nominal">Quantidade de Ingressos:</label>
                                                        <input type="number" class="form-control form-control-sm" id="cortesia-form-qty-non-nominal" value="5" min="1" max="100">
                                                        <span class="fs-xxs text-muted d-block mt-1">Os ingressos gerados serão nomeados como "Portador (Cortesia)" e poderão ser impressos ou copiados na tabela de histórico.</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-purple btn-sm w-100 text-white fw-bold" style="background-color: #7c3aed; border-color: #7c3aed;">
                                                <i class="ph-gift me-1"></i> Emitir Cortesia
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>

