                            <option value="rede">Rede Card (2.15% MDR)</option>
                            <option value="pagseguro">PagSeguro (2.40% MDR)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-secondary">Gateway de Backup (Failover):</label>
                        <select class="form-select form-select-sm fw-semibold" id="gw-secondary" required>
                            <option value="cielo" selected>Cielo S.A. (Failover D+0)</option>
                            <option value="stone">Stone Pagamentos</option>
                            <option value="rede">Rede Card</option>
                            <option value="pagseguro">PagSeguro</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="gw-smart-routing" checked>
                            <label class="form-check-label fs-xs fw-bold text-muted text-uppercase" for="gw-smart-routing">Roteamento Inteligente de Custos</label>
                        </div>
                        <span class="fs-xxs text-muted d-block mt-0.5">Divide automaticamente o volume de transações por bandeira para obter as menores taxas de antecipação.</span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-xs fw-bold text-muted text-uppercase mb-1" for="gw-antifraud">Provedor de Antifraude Integrado:</label>
                        <select class="form-select form-select-sm fw-semibold" id="gw-antifraud">
                            <option value="konduto" selected>Konduto AI (Análise em 350ms - Ativo)</option>
                            <option value="clearsale">ClearSale V3 (Ativo)</option>
                            <option value="inativo">Sem Antifraude (Não Recomendado)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light btn-sm" onclick="closeModal('gateway-config')">Cancelar</button>
                    <button type="submit" class="btn btn-orange btn-sm text-white fw-bold"><i class="ph-check me-1"></i> Aplicar Roteamento</button>
                </div>
            </form>
        </div>
    </div>

