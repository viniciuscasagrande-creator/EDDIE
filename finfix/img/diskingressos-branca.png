                                <span class="fs-5 fw-bold text-primary border-bottom border-primary border-3 pb-1 cursor-pointer" onclick="selectAgendaYear(2026)" id="year-label-2026">2026</span>
                                <span class="fs-sm text-muted cursor-pointer fw-medium" onclick="selectAgendaYear(2027)" id="year-label-2027">2027</span>
                                <span class="fs-sm text-muted cursor-pointer fw-medium" onclick="selectAgendaYear(2028)" id="year-label-2028">2028</span>
                                <button class="btn btn-light btn-sm border" onclick="changeAgendaYear(1)" title="Próximo ano" aria-label="Próximo ano"><i class="ph-caret-right"></i></button>
                            </div>

