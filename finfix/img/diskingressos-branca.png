                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light fs-xs text-uppercase text-muted">
                                            <tr>
                                                <th>Banco</th>
                                                <th>Agência</th>
                                                <th>Conta (Mascarada)</th>
                                                <th>Tipo</th>
                                                <th>Finalidade</th>
                                                <th>Titular / CNPJ</th>
                                                <th>Chave PIX</th>
                                                <th>Saldo Disponível</th>
                                                <th>Status</th>
                                                <th class="text-end">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody id="trz-tbody-accounts" class="fs-xs">
                                            <!-- Renderizado dinamicamente -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- PANE 3: Pagamentos PIX -->
                            <div class="card-body p-3" id="trz-pane-pix" style="display:none;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="fw-bold text-dark fs-sm">Pagamentos PIX Instantâneos</span>
                                        <div class="text-muted fs-xs">Ciclo de vida formal: Emissão &rarr; Validação Anti-Duplicidade &rarr; Aprovação de Alçada &rarr; Transmissão E2E</div>
                                    </div>
                                    <button class="btn btn-sm btn-success fw-bold" onclick="window.openNewPixPaymentModal()" style="background-color: #00a65a; border-color: #008d4c;">
                                        <i class="ph-paper-plane-tilt me-1"></i> Novo Pagamento PIX
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light fs-xs text-uppercase text-muted">
