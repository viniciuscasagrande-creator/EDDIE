                                                    <!-- Seeded dynamically -->
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- TAB PANE: Livro Razão -->
                                <div class="accounting-pane" id="accpane-razao" style="display: none;">
                                    <div class="card shadow-sm border p-3 mb-3">
                                        <h6 class="fw-bold text-dark mb-3"><i class="ph-book text-primary me-1"></i> Filtro de Consulta - Livro Razão</h6>
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Conta Contábil:</label>
                                                <select class="form-select form-select-sm fw-semibold" id="acc-razao-filter-account" onchange="window.filterLivroRazao()">
                                                    <option value="todos" selected>Todas as Contas</option>
                                                    <option value="bancos">1.1.02 - Bancos Conta Movimento</option>
                                                    <option value="receber">1.1.04 - Contas a Receber</option>
                                                    <option value="produtores">2.1.02 - Produtores a Pagar</option>
                                                    <option value="venda-ingressos">4.1.01 - Receita Venda Ingressos</option>
                                                    <option value="despesa-gateway">5.1.01 - Despesa Gateway de Pagamento</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Centro de Custos:</label>
                                                <select class="form-select form-select-sm fw-semibold" id="acc-razao-filter-cost" onchange="window.filterLivroRazao()">
                                                    <option value="todos" selected>Todos os Centros</option>
                                                    <option value="eventos">Eventos (Operacional)</option>
                                                    <option value="financeiro">Financeiro / Admin</option>
                                                    <option value="tecnologia">Tecnologia / Cloud</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fs-xxs fw-bold text-muted text-uppercase mb-1">Buscar por Evento:</label>
                                                <select class="form-select form-select-sm fw-semibold" id="acc-razao-filter-event" onchange="window.filterLivroRazao()">
                                                    <!-- Filled dynamically -->
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <button class="btn btn-sm btn-light border w-100 fw-bold py-1.5" onclick="window.clearRazaoFilters()"><i class="ph-funnel-simple-slash me-1"></i> Limpar Filtros</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card shadow-sm border">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0" style="font-size: 12.5px;">
                                                <thead>
                                                    <tr class="table-light">
                                                        <th>Data</th>
                                                        <th>Conta</th>
                                                        <th>Centro de Custos / Evento</th>
                                                        <th>Histórico</th>
                                                        <th class="text-end">Débito (D)</th>
                                                        <th class="text-end">Crédito (C)</th>
                                                        <th class="text-end">Saldo (R$)</th>
                                                    </tr>
