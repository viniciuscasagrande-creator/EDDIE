                                        <div>
                                            <label class="form-label fw-bold fs-xs text-muted text-uppercase mb-2">Colunas</label>
                                            <div class="btn-group w-100" role="group" id="btn-cols-group">
                                                <button type="button" class="btn btn-outline-primary btn-sm btn-col-select" data-cols="3">3</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm btn-col-select active" data-cols="4">4</button>
                                                <button type="button" class="btn btn-outline-primary btn-sm btn-col-select" data-cols="5">5</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button class="btn btn-orange text-white fw-bold d-flex align-items-center gap-1" id="new-event-btn" style="height: 36px; font-size: 13px;"><i class="ph-plus-circle"></i> Novo Evento</button>
                            </div>
                        </div>

                        <!-- Events Data Grid -->
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3 mt-1" id="events-grid-body">
                            <!-- Rendered dynamically by JS controller -->
                        </div>

                        <!-- Events List Table (shown when View Mode is 'Lista') -->
                        <div class="table-responsive border rounded bg-white shadow-sm mt-3" id="events-list-table-container" style="display: none; border-radius: 8px;">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="fw-bold text-muted py-2" style="font-size: 11px;">EVENTO</th>
                                        <th class="fw-bold text-muted py-2" style="font-size: 11px;">DATA / HORÁRIO</th>
                                        <th class="fw-bold text-muted py-2" style="font-size: 11px;">LOCAL</th>
                                        <th class="fw-bold text-muted py-2 text-center" style="font-size: 11px;">STATUS</th>
                                        <th class="fw-bold text-muted py-2 text-end" style="font-size: 11px;">INGRESSOS</th>
                                        <th class="fw-bold text-muted py-2 text-end" style="font-size: 11px;">RECEITA BRUTA</th>
                                        <th class="fw-bold text-muted py-2 text-end" style="font-size: 11px; width: 100px;">AÇÕES</th>
                                    </tr>
                                </thead>
                                <tbody id="table-events-body">
                                    <!-- Loaded dynamically by JS -->
                                </tbody>
                            </table>
                        </div>
                    </section>
                    <!-- SUBTAB 2.2: Novo Evento Direct Form -->
                    <!-- SUBTAB 2.2: Novo Evento Direct Form (WIZARD FLOW FROM VIDEOS) -->
                    <section id="view-events-new" class="page-section"  style="display:none;">
                        <div class="card shadow-sm border p-4 mb-4" style="border-radius: 8px;">
                            <h3 class="fw-bold text-primary mb-1">Cadastre seu evento na DiskIngressos</h3>
                            <p class="text-muted fs-xs mb-3">Preencha as informações abaixo e envie as artes necessárias. A equipe da DiskIngressos vai revisar o material e retornar com o link do evento para conferência e liberação.</p>
                            
                            <div class="alert alert-warning py-2 px-3 mb-4 d-flex align-items-center gap-2" style="font-size: 12px; border-left: 4px solid #f0ad4e;">
                                <span>Nossa marca é <strong>DiskIngressos</strong> (tudo junto) - utilize essa forma corretamente nas divulgações do seu evento 😉</span>
                            </div>

                            <!-- Antes de começar card -->
                            <div class="card p-3 mb-4" style="border-radius: 6px; background-color: #f8fafc; border-left: 4px solid #3b82f6;">
                                <h6 class="fw-bold text-dark fs-xs mb-2">Antes de começar</h6>
                                <ul class="mb-0 fs-xxs text-muted ps-3">
                                    <li class="mb-1">Preencha com o máximo de informações possível para agilizar a publicação.</li>
                                    <li class="mb-1">Separe as imagens nas proporções indicadas (home, banner e fundo).</li>
                                    <li>Tenha em mãos o release do evento para anexar ou colar no campo de texto.</li>
                                </ul>
                            </div>

                            <!-- Wizard Step Indicator -->
                            <div class="d-flex justify-content-between align-items-center mb-5 px-md-5">
                                <div class="text-center position-relative flex-grow-1">
                                    <div class="wizard-step-circle mx-auto d-flex align-items-center justify-content-center fw-bold active" id="circle-step-1" style="width: 40px; height: 40px; border-radius: 50%; background: #3b82f6; color: white; font-size: 14px; border: 3px solid #dbeafe;">1</div>
                                    <span class="fs-xxs text-muted d-block mt-2 fw-semibold">Dados da produtora</span>
                                </div>
                                <div class="wizard-step-line flex-grow-1 bg-light" style="height: 4px; margin-top: -20px;"></div>
                                <div class="text-center position-relative flex-grow-1">
                                    <div class="wizard-step-circle mx-auto d-flex align-items-center justify-content-center fw-bold" id="circle-step-2" style="width: 40px; height: 40px; border-radius: 50%; background: #e2e8f0; color: #64748b; font-size: 14px;">2</div>
                                    <span class="fs-xxs text-muted d-block mt-2 fw-semibold">Dados do evento</span>
                                </div>
                                <div class="wizard-step-line flex-grow-1 bg-light" style="height: 4px; margin-top: -20px;"></div>
                                <div class="text-center position-relative flex-grow-1">
                                    <div class="wizard-step-circle mx-auto d-flex align-items-center justify-content-center fw-bold" id="circle-step-3" style="width: 40px; height: 40px; border-radius: 50%; background: #e2e8f0; color: #64748b; font-size: 14px;">3</div>
                                    <span class="fs-xxs text-muted d-block mt-2 fw-semibold">Ingressos e lotes</span>
                                </div>
                                <div class="wizard-step-line flex-grow-1 bg-light" style="height: 4px; margin-top: -20px;"></div>
                                <div class="text-center position-relative flex-grow-1">
                                    <div class="wizard-step-circle mx-auto d-flex align-items-center justify-content-center fw-bold" id="circle-step-4" style="width: 40px; height: 40px; border-radius: 50%; background: #e2e8f0; color: #64748b; font-size: 14px;">4</div>
                                    <span class="fs-xxs text-muted d-block mt-2 fw-semibold">Dados bancários e materiais</span>
                                </div>
                            </div>

                            <form id="new-event-wizard-form" onsubmit="return false;">
                                <!-- STEP 1: Dados da produtora -->
                                <div id="wizard-step-pane-1">
                                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Dados da produtora</h5>
                                    <p class="text-muted fs-xxs mb-3">Este são os dados da empresa responsável pelo evento. Ele aparecerá nos relatórios e comunicações internas.</p>
                                    
                                    <div class="row g-3">
                                        <div class="col-12 mb-2">
                                            <div class="card card-body p-2 bg-light border-0 shadow-none d-flex flex-row align-items-center gap-3 mb-0" style="border-radius: 8px;">
                                                <div class="flex-shrink-0 text-primary">
                                                    <i class="ph-buildings fs-3 border p-2 rounded bg-white"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <label class="form-label fw-bold fs-xxs text-dark text-uppercase mb-1">Selecionar Produtora Cadastrada (Auto-preenchimento)</label>
                                                    <select id="wiz-prod-select" class="form-select form-select-sm fw-semibold" onchange="window.selectWizardProducer(this.value)">
                                                        <option value="">-- Cadastrar novo (Preencher manualmente) --</option>
                                                        <option value="prod-1">DiskIngressos Eventos Ltda (CNPJ: 08.123.456/0001-99)</option>
                                                        <option value="prod-2">CWB Brasil Entretenimento (CNPJ: 12.987.654/0001-00)</option>
                                                        <option value="prod-3">Seven Experience Agency (CNPJ: 45.555.666/0001-22)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">CPF/CNPJ da produtora *</label>
                                            <input type="text" id="wiz-prod-cnpj" class="form-control" placeholder="Ex.: 00.000.000/0000-00" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Nome da produtora *</label>
                                            <input type="text" id="wiz-prod-name" class="form-control" placeholder="Ex.: Produtora XYZ Eventos" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Nome completo do responsável *</label>
                                            <input type="text" id="wiz-prod-resp" class="form-control" placeholder="Nome completo do responsável" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">CPF do responsável *</label>
                                            <input type="text" id="wiz-prod-resp-cpf" class="form-control" placeholder="Ex.: 000.000.000-00" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Email *</label>
                                            <input type="email" id="wiz-prod-email" class="form-control" placeholder="Ex.: financeiro@empresa.com" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">WhatsApp *</label>
                                            <input type="text" id="wiz-prod-phone" class="form-control" placeholder="Ex.: (41) 99999-9999" required>
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Endereço *</label>
                                            <input type="text" id="wiz-prod-addr" class="form-control" placeholder="Rua, avenida, praça..." required>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Número *</label>
                                            <input type="text" id="wiz-prod-number" class="form-control" placeholder="Ex.: 123" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">CEP *</label>
                                            <input type="text" id="wiz-prod-cep" class="form-control" placeholder="Ex.: 80000000" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Cidade *</label>
                                            <input type="text" id="wiz-prod-city" class="form-control" placeholder="Ex.: Curitiba" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Estado *</label>
                                            <input type="text" id="wiz-prod-state" class="form-control" placeholder="Ex.: PR" required>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-4">
                                        <button type="button" class="btn btn-outline-light text-dark border px-4" onclick="switchActiveView('events-list')"><i class="ph-arrow-left me-1"></i> VOLTAR</button>
                                        <button type="button" class="btn btn-primary px-4" onclick="navigateWizard(2)">PRÓXIMO <i class="ph-arrow-right ms-1"></i></button>
                                    </div>
                                </div>

                                <!-- STEP 2: Dados do evento -->
                                <div id="wizard-step-pane-2" style="display: none;">
                                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Dados do evento</h5>
                                    
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Nome do Evento *</label>
                                            <input type="text" id="wiz-ev-name" class="form-control" placeholder="Ex.: Show de Lançamento" required>
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Endereço do Local *</label>
                                            <input type="text" id="wiz-ev-addr" class="form-control" placeholder="Ex.: Teatro Positivo" required>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Número *</label>
                                            <input type="text" id="wiz-ev-number" class="form-control" placeholder="Ex.: 102" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">CEP *</label>
                                            <input type="text" id="wiz-ev-cep" class="form-control" placeholder="Ex.: 81720-400" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Cidade *</label>
                                            <input type="text" id="wiz-ev-city" class="form-control" placeholder="Ex.: Curitiba" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Estado *</label>
                                            <input type="text" id="wiz-ev-state" class="form-control" placeholder="Ex.: PR" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Capacidade de público *</label>
                                            <input type="number" id="wiz-ev-capacity" class="form-control" placeholder="Ex.: 2500" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Classificação etária *</label>
                                            <select id="wiz-ev-rating" class="form-select" required>
                                                <option value="" disabled selected>Selecione</option>
                                                <option value="L">Livre</option>
                                                <option value="10">10 anos</option>
                                                <option value="12">12 anos</option>
                                                <option value="14">14 anos</option>
                                                <option value="16">16 anos</option>
                                                <option value="18">18 anos</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Menor acompanhado</label>
                                            <input type="text" id="wiz-ev-accompanied" class="form-control" placeholder="Ex.: Menores de 16 anos somente acompanhados dos pais ou responsáveis legais.">
                                        </div>
                                    </div>

                                    <!-- Sessões do Evento section -->
                                    <div class="mt-4 border-top pt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="fw-bold text-dark fs-xs mb-0"><i class="ph-calendar-blank me-1"></i> Sessões do Evento</h6>
                                            <button type="button" class="btn btn-outline-primary btn-xs fw-bold" onclick="addWizardSessionRow()"><i class="ph-plus me-1"></i> ADICIONAR SESSÃO</button>
                                        </div>
                                        <div class="table-responsive border rounded">
                                            <table class="table table-hover align-middle mb-0" style="font-size: 12px;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Data *</th>
                                                        <th>Horário de Início *</th>
                                                        <th>Abertura dos Portões *</th>
                                                        <th style="width: 90px;" class="text-center">Ações</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="wizard-sessions-tbody">
                                                    <tr>
                                                        <td><input type="date" class="form-control form-control-sm wiz-session-date" required></td>
                                                        <td><input type="time" class="form-control form-control-sm wiz-session-start" required></td>
                                                        <td><input type="time" class="form-control form-control-sm wiz-session-open" required></td>
                                                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-icon btn-sm" onclick="this.closest('tr').remove()" title="Remover"><i class="ph-trash"></i></button></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Informações Adicionais section -->
                                    <div class="mt-4 border-top pt-3">
                                        <h6 class="fw-bold text-dark fs-xs mb-2"><i class="ph-info me-1"></i> Informações adicionais</h6>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Espaço coberto *</label>
                                                <select id="wiz-info-covered" class="form-select" required>
                                                    <option value="" disabled selected>Selecione</option>
                                                    <option value="Sim">Sim</option>
                                                    <option value="Parcialmente">Parcialmente</option>
                                                    <option value="Não">Não</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Acesso para deficientes *</label>
                                                <select id="wiz-info-access" class="form-select" required>
                                                    <option value="" disabled selected>Selecione</option>
                                                    <option value="Sim">Sim</option>
                                                    <option value="Não">Não</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Estacionamento no local *</label>
                                                <select id="wiz-info-parking" class="form-select" required>
                                                    <option value="" disabled selected>Selecione</option>
                                                    <option value="Sim - Gratuito">Sim - Gratuito</option>
                                                    <option value="Sim - Pago">Sim - Pago</option>
                                                    <option value="Não possui">Não possui</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4">
                                        <button type="button" class="btn btn-outline-light text-dark border px-4" onclick="navigateWizard(1)"><i class="ph-arrow-left me-1"></i> VOLTAR</button>
                                        <button type="button" class="btn btn-primary px-4" onclick="navigateWizard(3)">PRÓXIMO <i class="ph-arrow-right ms-1"></i></button>
                                    </div>
                                </div>

                                <!-- STEP 3: Ingressos e lotes -->
                                <div id="wizard-step-pane-3" style="display: none;">
                                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Ingressos e lotes</h5>
                                    <p class="text-muted fs-xxs mb-3">Informe os setores ou categorias de ingressos disponíveis. Dentro deste montante estarão inclusos os ingressos com desconto.</p>
                                    
                                    <!-- Dynamic Tickets Table -->
                                    <div class="table-responsive border rounded mb-3">
                                        <table class="table table-hover align-middle mb-0" style="font-size: 12px;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Descrição (setor ou categoria) *</th>
                                                    <th>Valor inteira (R$) *</th>
                                                    <th>Valor meia (R$) *</th>
                                                    <th>Quantidade *</th>
                                                    <th>Gênero (F/M/U) *</th>
                                                    <th>Lote *</th>
                                                    <th style="width: 70px;" class="text-center">Ações</th>
                                                </tr>
                                            </thead>
                                            <tbody id="wizard-tickets-tbody">
                                                <tr>
                                                    <td><input type="text" class="form-control form-control-sm wiz-ticket-desc" placeholder="Ex.: Pista, Camarote" required></td>
                                                    <td><input type="number" step="0.01" class="form-control form-control-sm wiz-ticket-price" placeholder="Ex.: 100,00" required></td>
                                                    <td><input type="number" step="0.01" class="form-control form-control-sm wiz-ticket-half" placeholder="Ex.: 50,00" required></td>
                                                    <td><input type="number" class="form-control form-control-sm wiz-ticket-qty" placeholder="Ex.: 500" required></td>
                                                    <td><input type="text" class="form-control form-control-sm wiz-ticket-gender" placeholder="F / M / U" required></td>
                                                    <td><input type="text" class="form-control form-control-sm wiz-ticket-batch" placeholder="Ex.: 1º lote" required></td>
                                                    <td class="text-center"><button type="button" class="btn btn-outline-danger btn-icon btn-sm" onclick="this.closest('tr').remove()"><i class="ph-trash"></i></button></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="text-center mb-4">
                                        <button type="button" class="btn btn-outline-primary btn-sm fw-bold" onclick="addWizardTicketRow()"><i class="ph-plus me-1"></i> ADICIONAR SETOR/LOTE</button>
                                    </div>

                                    <!-- Desconto ClubeDisk -->
                                    <div class="row g-3 border-top pt-3">
                                        <div class="col-md-6">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label fw-bold text-dark fs-xs mb-0">Desconto ClubeDisk</label>
                                                <a href="#" class="fs-xxs text-primary" onclick="alert('O ClubeDisk oferece descontos exclusivos para assinantes do clube de vantagens.')">Saiba Mais</a>
                                            </div>
                                            <p class="text-muted fs-xxs mb-2">Amplia a visibilidade do evento com descontos ao público, gerando divulgação em todos os canais parceiros, sem custo ao produtor.</p>
                                            <input type="text" id="wiz-clubedisk-discount" class="form-control" placeholder="Ex.: 50%">
                                            <small class="text-muted fs-xxs mt-1 d-block">Desconto aplicado sobre o valor da inteira</small>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card card-body p-3 h-100 mb-0 bg-light" style="border-radius: 6px;">
                                                <h6 class="fw-bold text-dark fs-xs mb-2">Lei da meia-entrada</h6>
                                                <p class="text-muted mb-0" style="font-size: 11px; line-height: 1.4;">A meia-entrada segue o Decreto nº 8.537, de 5 de outubro de 2015. O benefício da meia-entrada aplica-se às categorias de ingressos disponíveis para venda ao público geral.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4">
                                        <button type="button" class="btn btn-outline-light text-dark border px-4" onclick="navigateWizard(2)"><i class="ph-arrow-left me-1"></i> VOLTAR</button>
                                        <button type="button" class="btn btn-primary px-4" onclick="navigateWizard(4)">PRÓXIMO <i class="ph-arrow-right ms-1"></i></button>
                                    </div>
                                </div>

                                <!-- STEP 4: Dados bancários e materiais -->
                                <div id="wizard-step-pane-4" style="display: none;">
                                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Dados bancários e materiais</h5>
                                    <p class="text-muted fs-xxs mb-3">Se os dados bancários não forem os mesmos que já estão em contrato com a DiskIngressos, informe os novos dados abaixo. Em seguida, anexe as artes e o release.</p>
                                    
                                    <!-- Dados bancários para depósito -->
                                    <div class="card p-3 mb-4" style="border-radius: 6px; background-color: #f8fafc;">
                                        <h6 class="fw-bold text-dark fs-xs mb-3"><i class="ph-bank me-1"></i> Dados bancários para depósito</h6>
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Banco *</label>
                                                <input type="text" id="wiz-bank-name" class="form-control" placeholder="Ex.: Banco do Brasil" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Agência *</label>
                                                <input type="text" id="wiz-bank-agency" class="form-control" placeholder="Ex.: 0001-0" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Conta corrente *</label>
                                                <input type="text" id="wiz-bank-account" class="form-control" placeholder="Ex.: 12345-6" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Beneficiário *</label>
                                                <input type="text" id="wiz-bank-beneficiary" class="form-control" placeholder="Nome completo ou razão social" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">CPF/CNPJ *</label>
                                                <input type="text" id="wiz-bank-doc" class="form-control" placeholder="Ex.: 00.000.000/0000-00" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold fs-xxs text-muted text-uppercase">Email para envio de borderô *</label>
                                                <input type="email" id="wiz-bank-email" class="form-control" placeholder="Ex.: financeiro@empresa.com" required>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Negociação de formas de pagamento -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-dark fs-xs mb-1">Negociação de formas de pagamento</label>
                                        <textarea id="wiz-payment-notes" class="form-control" rows="2" placeholder="Descreva aqui a negociação combinada sobre formas de pagamento, se houver."></textarea>
                                    </div>

                                    <!-- Materiais necessários para a criação e divulgação do evento -->
                                    <div class="border-top pt-3 mb-4">
                                        <h6 class="fw-bold text-dark fs-xs mb-2">Materiais necessários para a criação e divulgação do evento</h6>
                                        <p class="text-muted" style="font-size: 11px; line-height: 1.4;">Envie as artes conforme orientações abaixo. Se preferir, você também pode enviar os materiais por e-mail para <strong>mkt@diskingressos.com.br</strong>. Envie as artes e o release para que possamos cadastrar os itens no site e vídeos de divulgação (feed, story e reels) e na portaria do evento. Os materiais podem ser encaminhados posteriormente pelo grupo de whats.</p>
                                        
                                        <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center gap-2" style="font-size: 11px; border-left: 4px solid #3b82f6;">
                                            <span><strong>Importante:</strong> utilize sempre a marca <strong>DiskIngressos</strong> (tudo junto sem espaço). Para baixar a nossa logo oficial <a href="#" class="fw-bold text-decoration-underline text-primary">clique aqui</a></span>
                                        </div>

                                        <!-- Image file pickers -->
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <div class="card p-3 border h-100" style="border-radius: 6px;">
                                                    <label class="form-label fw-bold fs-xxs text-dark mb-1">Home 1080x1080 (capa do evento no site) *</label>
                                                    <input type="file" id="wiz-file-home" class="form-control form-control-sm mb-2" required>
                                                    <span class="text-muted fs-xxs">Formato recomendado: 1080x1080 px. Arquivos PNG ou JPG.</span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card p-3 border h-100" style="border-radius: 6px;">
                                                    <label class="form-label fw-bold fs-xxs text-dark mb-1">Imagem de evento 1170x430 *</label>
                                                    <input type="file" id="wiz-file-banner" class="form-control form-control-sm mb-2" required>
                                                    <span class="text-muted fs-xxs">Formato recomendado: 1170x430 px, deixando uma margem de 26 px na parte inferior. Arquivos PNG ou JPG.</span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="card p-3 border h-100" style="border-radius: 6px;">
                                                    <label class="form-label fw-bold fs-xxs text-dark mb-1">Fundo 1920x1080 *</label>
                                                    <input type="file" id="wiz-file-bg" class="form-control form-control-sm mb-2" required>
                                                    <span class="text-muted fs-xxs">Fundo da página de venda. Se preferir, pode ser enviada apenas a informação da cor desejada.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Release do evento -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-dark fs-xs mb-1">Release do evento (breve descritivo) *</label>
                                        <textarea id="wiz-event-release" class="form-control" rows="3" placeholder="Conte em poucas linhas o conceito do evento, atrações principais e o que o público pode esperar." required></textarea>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4">
                                        <button type="button" class="btn btn-outline-light text-dark border px-4" onclick="navigateWizard(3)"><i class="ph-arrow-left me-1"></i> VOLTAR</button>
                                        <button type="submit" class="btn btn-success px-4" id="btn-finish-wizard">FINALIZAR CADASTRO <i class="ph-check ms-1"></i></button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>
                    <!-- SUBTAB 2.3: Lotes Configurator -->
