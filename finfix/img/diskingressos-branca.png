                                                        <span id="sim-page-fees">- R$ 150,00</span>
                                                     </div>
                                                     <hr class="my-2 border-light">
                                                     <div class="payout-sum-row total text-success">
                                                         <span>Valor Líquido Creditado:</span>
                                                         <strong id="sim-page-net" class="fs-sm">R$ 815,00</strong>
                                                     </div>
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                        </div>
                    </section>

