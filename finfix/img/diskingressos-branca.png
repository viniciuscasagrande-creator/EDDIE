                                                            <th>Protocolo</th>
                                                            <th>Produtor / Evento</th>
                                                            <th>Data Vencimento</th>
                                                            <th>Valor Solicitado</th>
                                                            <th>Alçada Exigida</th>
                                                            <th>Destino Bancário</th>
                                                            <th>Status</th>
                                                            <th>Aprovador</th>
                                                            <th class="text-end pe-3">Ações de Decisão</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="table-financeiro-alcadas-body">
                                                        <!-- Preenchido dinamicamente via JS -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SUB-PANE 2: GESTÃO DE LOTES BANCÁRIOS (OPÇÃO A) -->
                                    <div id="fin-subpane-lotes" class="fin-subpane" style="display: none;">
                                        <div class="card shadow-sm border mb-4">
                                            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark"><i class="ph-stack text-primary me-2"></i>Lotes de Repasse Bancário &bull; Ciclo Completo</h6>
                                                    <span class="fs-xs text-muted">Reavaliação no motor de regras, homologação Maker/Checker e transmissão PIX / CNAB 240</span>
                                                </div>
                                                <button class="btn btn-sm btn-primary fw-bold d-flex align-items-center gap-1" onclick="window.openCreatePayoutBatchModal()">
