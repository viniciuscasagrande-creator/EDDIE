                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #06b6d4 !important;">
                                    <span class="fs-xs fw-bold text-uppercase text-muted">Lotes CNAB</span>
                                    <h5 class="fw-bold mb-0 mt-2 text-dark" id="trz-kpi-pending-batches">0</h5>
                                    <span class="fs-xs text-muted mt-1">Remessas em aberto</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="card h-100 shadow-sm border-0 p-3" style="border-top: 3px solid #64748b !important;">
                                    <span class="fs-xs fw-bold text-uppercase text-muted">Contas Ativas</span>
                                    <h5 class="fw-bold mb-0 mt-2 text-dark" id="trz-kpi-active-accounts">0</h5>
                                    <span class="fs-xs text-muted mt-1">Instituições integradas</span>
                                </div>
                            </div>
                        </div>

