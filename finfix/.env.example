# ==============================================================================
# DISK INGRESSOS - CORE FINANCEIRO CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

PORT=3000
NODE_ENV=development

# Conexão com o Banco de Dados (SQLite para execução local ou PostgreSQL para produção)
DATABASE_URL="file:./database/dev.db"

# JWT Secret para autenticação de Produtores e Operadores Disk
JWT_SECRET="disk-ingressos-enterprise-secret-key-2026"

# Taxa de Adquirência e Spread Comercial Disk Padrão (1.22%)
DISK_SPREAD_PERCENT=1.22

# URLs de Integração com Gateways (Cielo, Rede, Stone, PagBank)
CIELO_MERCHANT_ID="mock-cielo-id"
REDE_PV="mock-rede-pv"
STONE_STONECODE="mock-stone-code"
PAGBANK_TOKEN="mock-pagbank-token"
